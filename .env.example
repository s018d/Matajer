# المتغيرات البيئية الاختيارية لمنصة دُكّان — انسخ هذا الملف إلى .env واملأ القيم عند الحاجة
# (كلها اختيارية — المنصة تعمل بدونها بالقيم الافتراضية)

# منفذ الخادم (الافتراضي 3000)
PORT=3000

# NODE_ENV=production يفعّل: إخفاء تفاصيل الأخطاء + كوكي الجلسة Secure (يتطلب HTTPS)
NODE_ENV=development

# TRUST_PROXY=1 يُفعّل الثقة بـ X-Forwarded-For — استخدمها فقط خلف reverse proxy حقيقي (nginx)
TRUST_PROXY=0

# DISABLE_SAMPLES=1 يمنع إعادة زرع المتاجر الوهمية عند كل تشغيل (مهم بعد v4.3-clean-launch)
DISABLE_SAMPLES=1

# DATABASE_URL — للانتقال لـ PostgreSQL (اختياري — اتركه فارغاً للاستمرار بـ SQLite محلياً)
# مثال محلي: postgres://postgres:password@localhost:5432/matajer
# مثال Serv00: postgres://user:pass@db.serv00.net:5432/dbname
# عند تفعيله، المنصة تنتقل تلقائياً لـ PostgreSQL (38 جدول) — تعلم أوامر psql/pgAdmin
# DATABASE_URL=postgres://user:pass@localhost:5432/matajer

# الدخول بجيميل (اختياري — بدونه يبقى الدخول الكلاسيكي فقط)
# الخطوات: Google Cloud Console ← مشروع جديد ← OAuth consent ← Credentials ← Web application
# رابط العودة المعتمد: https://دومينك/oauth2/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# إشعارات تيليجرام وبوابات الدفع (اختياري — للمستقبل، الكود الحالي لا يقرأها بعد)
# TELEGRAM_BOT_TOKEN=
# ZAINCASH_ENABLED=false