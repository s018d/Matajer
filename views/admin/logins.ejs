<%- include('../partials/head', { title: 'سجل الدخول — المدير العام' }) %>
<body class="app">
<%- include('../partials/sidebar-admin', { active: 'logins' }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'سجل تسجيلات الدخول' }) %>
  <div class="content">
    <% if (typeof ok !== 'undefined' && ok) { %><div class="alert alert-ok"><%= ok %></div><% } %>
    <div class="card" style="margin-bottom:1rem; display:flex; gap:.6rem; flex-wrap:wrap; align-items:center">
      <form method="get" action="/admin/logins" style="display:flex; gap:.6rem; flex:1; min-width:240px">
        <input type="search" name="q" value="<%= q %>" placeholder="🔍 ابحث باسم المستخدم..." style="flex:1; padding:.6rem .9rem; border-radius:10px; border:1.5px solid var(--line)">
        <button class="btn btn-sm">بحث</button>
      </form>
      <span class="badge"><%= rows.length %> محاولة</span>
      <span class="badge" style="background:#fee2e2; color:#b91c1c"><%= fails %> فاشلة إجمالاً</span>
    </div>
    <div class="card">
      <div class="table-wrap"><table class="table">
        <tr><th>الوقت</th><th>المستخدم</th><th>النتيجة</th><th>الطريقة</th><th>العنوان</th><th>الجهاز</th></tr>
        <% rows.forEach(r => { %>
          <tr>
            <td><small><%= r.created_at %></small></td>
            <td><b><%= r.username || '—' %></b></td>
            <td><%= r.success ? '<span class="badge" style="background:#dcfce7; color:#15803d">ناجح</span>' : '<span class="badge" style="background:#fee2e2; color:#b91c1c">فاشل</span>' %></td>
            <td><small><%= r.method === 'google' ? 'جيميل' : 'كلمة المرور' %></small></td>
            <td><small dir="ltr"><%= r.ip %></small></td>
            <td><small><%= String(r.user_agent || '').slice(0, 60) %></small></td>
          </tr>
        <% }) %>
      </table></div>
      <% if (!rows.length) { %><p class="muted" style="text-align:center; padding:1.5rem">لا محاولات بعد</p><% } %>
    </div>
  </div>
</main>
</body>
</html>
