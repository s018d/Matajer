<%- include('../partials/head', { title: 'تغيير كلمة المرور — المدير العام' }) %>
<body class="app">
<%- include('../partials/sidebar-admin') %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'تغيير كلمة المرور' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card" style="max-width:480px">
      <form method="post" action="/admin/password" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>كلمة المرور الحالية
          <input type="password" name="oldpass" required>
        </label>
        <label>كلمة المرور الجديدة
          <input type="password" name="newpass" required>
        </label>
        <button type="submit" class="btn btn-primary">تغيير</button>
      </form>
    </div>
  </div>
</main>
</body>
</html>