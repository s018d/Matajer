<%- include('../partials/head', { title: 'إعدادات المنصة — المدير العام' }) %>
<body class="app">
<%- include('../partials/sidebar-admin', { active: 'site' }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'إعدادات المنصة' }) %>
  <div class="content">
    <%- include('../partials/alerts', { ok: typeof ok !== 'undefined' ? ok : '', err: typeof err !== 'undefined' ? err : '' }) %>
    <div class="two-col">
      <div class="card">
        <h2>هوية الموقع</h2>
        <form method="post" action="/admin/site" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>اسم المنصة
            <input type="text" name="site_name" value="<%= cfg.site_name %>">
          </label>
          <label>الشعار النصي (يظهر في صفحة الهبوط)
            <textarea name="tagline" rows="2"><%= cfg.tagline %></textarea>
          </label>
          <label>رقم واتساب الدعم (يظهر كزر في الموقع)
            <input type="text" name="site_whatsapp" value="<%= cfg.site_whatsapp %>" dir="ltr" placeholder="مثال: 9647701234567">
          </label>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </form>
      </div>
      <div class="card">
        <h2>الباقات والدفع</h2>
        <form method="post" action="/admin/site" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>حد منتجات الباقة المجانية
            <input type="number" name="free_products" value="<%= cfg.free_products %>" min="1" max="100">
          </label>
          <label>سعر الباقة الاحترافية — شهر (د.ع)
            <input type="number" name="pro_price" value="<%= cfg.pro_price %>" min="1000" dir="ltr">
          </label>
          <label>سعر الباقة الاحترافية — 3 شهور (د.ع)
            <input type="number" name="pro_price_3" value="<%= cfg.pro_price_3 %>" min="1000" dir="ltr">
          </label>
          <label>سعر الباقة الاحترافية — سنة (د.ع)
            <input type="number" name="pro_price_12" value="<%= cfg.pro_price_12 %>" min="1000" dir="ltr">
          </label>
          <label>جهة استلام الدفع (تظهر للعملاء عند طلب الترقية)
            <input type="text" name="pay_account" value="<%= cfg.pay_account %>" dir="ltr" placeholder="مثال: زين كاش 07701234567">
          </label>
          <label>أيام التجربة الاحترافية المجانية عند التسجيل (0 = بدون تجربة)
            <input type="number" name="trial_days" value="<%= cfg.trial_days %>" min="0" max="30" dir="ltr">
          </label>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </form>
        <p class="muted" style="margin-top:.8rem;font-size:.82rem">العملاء يرون هذه المعلومات في صفحة «الباقات» داخل لوحات متاجرهم.</p>
      </div>
    </div>
    <div class="card" style="margin-top:1rem">
      <h2>إشعارات تيليجرام (للطلبات الجديدة)</h2>
      <form method="post" action="/admin/site" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>توكن البوت (من @BotFather)
          <input type="text" name="telegram_bot_token" value="<%= cfg.telegram_bot_token %>" dir="ltr" placeholder="123456789:ABCdefGHIjklMNOpqrsTUVwxyz">
        </label>
        <label>معرف المحادثة الإدارية (Chat ID — أرسل /start للبوت ثم افتح https://api.telegram.org/bot<TOKEN>/getUpdates)
          <input type="text" name="telegram_admin_chat_id" value="<%= cfg.telegram_admin_chat_id %>" dir="ltr" placeholder="مثال: 123456789 أو -1001234567890">
        </label>
        <button type="submit" class="btn btn-primary">حفظ إعدادات تيليجرام</button>
      </form>
      <p class="muted" style="margin-top:.8rem;font-size:.82rem">عند تفعيلهما، سيرسل النظام إشعاراً تلقائياً للحساب الإداري عند كل طلب جديد في أي متجر.</p>
    </div>
  </div>
</main>
</body>
</html>