<%- include('../partials/head', { title: 'إعدادات المنصة — مركز التحكم' }) %>
<body class="app">
<%- include('../partials/sidebar-admin', { active: 'site', user }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: '⚙️ إعدادات المنصة — تحكم كامل' }) %>
  <div class="content">
    <%- include('../partials/alerts', { ok: typeof ok !== 'undefined' ? ok : '', err: typeof err !== 'undefined' ? err : '' }) %>

    <!-- Tabs -->
    <div class="card" style="padding:0; overflow:hidden">
      <div class="site-tabs" style="display:flex; gap:0; border-bottom:2px solid var(--line); background:var(--soft); overflow-x:auto">
        <button class="site-tab on" data-tab="general" onclick="switchTab('general')">🏷️ الهوية</button>
        <button class="site-tab" data-tab="billing" onclick="switchTab('billing')">💳 الباقات والدفع</button>
        <button class="site-tab" data-tab="trial" onclick="switchTab('trial')">🎁 التجربة والإحالة</button>
        <button class="site-tab" data-tab="notify" onclick="switchTab('notify')">🔔 الإشعارات</button>
      </div>

      <form method="post" action="/admin/site" class="stack" style="padding:1.6rem" id="siteForm">
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <!-- Tab: General -->
        <div class="tab-panel on" id="tab-general">
          <h2 style="margin-bottom:.3rem">🏷️ هوية المنصة</h2>
          <p class="muted" style="font-size:.82rem; margin-bottom:1rem">هذه البيانات تظهر في صفحة الهبوط والفوتر وكل متجر</p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem">
            <label>اسم المنصة *
              <input type="text" name="site_name" value="<%= cfg.site_name %>" required placeholder="دُكّان Dukkan">
              <small class="field-hint">يظهر في العنوان والشعار</small>
            </label>
            <label>رقم واتساب الدعم
              <input type="text" name="site_whatsapp" value="<%= cfg.site_whatsapp %>" dir="ltr" placeholder="9647701234567">
              <small class="field-hint">زر واتساب في الهبوط وكل متجر</small>
            </label>
          </div>
          <label>الشعار النصي (Tagline)
            <textarea name="tagline" rows="2" placeholder="أنشئ متجرك خلال دقائق..."><%= cfg.tagline %></textarea>
          </label>
          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:.8rem">
            <label>تيليجرام<input type="text" name="site_telegram" value="<%= cfg.site_telegram || '' %>" dir="ltr" placeholder="@s018d"></label>
            <label>إنستغرام<input type="text" name="site_instagram" value="<%= cfg.site_instagram || '' %>" dir="ltr" placeholder="@s018d"></label>
            <label>تيك توك<input type="text" name="site_tiktok" value="<%= cfg.site_tiktok || '' %>" dir="ltr" placeholder="@s018a"></label>
          </div>
        </div>

        <!-- Tab: Billing -->
        <div class="tab-panel" id="tab-billing">
          <h2 style="margin-bottom:.3rem">💳 الباقات والدفع</h2>
          <p class="muted" style="font-size:.82rem; margin-bottom:1rem">الأسعار تظهر للتجار في صفحة الباقات — غيّرها بدون كود</p>
          <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem">
            <label>حد المجاني (منتجات)<input type="number" name="free_products" value="<%= cfg.free_products %>" min="1" max="100"></label>
            <label>شهر (د.ع)<input type="number" name="pro_price" value="<%= cfg.pro_price %>" min="1000" dir="ltr"></label>
            <label>3 شهور (د.ع)<input type="number" name="pro_price_3" value="<%= cfg.pro_price_3 %>" min="1000" dir="ltr"></label>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem">
            <label>سنة (د.ع)<input type="number" name="pro_price_12" value="<%= cfg.pro_price_12 %>" min="1000" dir="ltr"></label>
            <label>الأعمال شهري (د.ع)<input type="number" name="business_price" value="<%= cfg.business_price || 25000 %>" min="1000" dir="ltr"></label>
            <label>جهة استلام الدفع
              <input type="text" name="pay_account" value="<%= cfg.pay_account %>" dir="ltr" placeholder="زين كاش 0770... أو حساب مصرفي">
              <small class="field-hint">تظهر عند طلب الترقية</small>
            </label>
          </div>
          <div class="alert" style="background:#f0fdf4; border-color:#bbf7d0; color:#14532d; font-size:.82rem">💡 غيّر الأسعار وسيُحدَّث كل المتاجر فوراً — لا حاجة لإعادة التشغيل</div>
        </div>

        <!-- Tab: Trial -->
        <div class="tab-panel" id="tab-trial">
          <h2>🎁 التجربة والإحالة</h2>
          <label>أيام التجربة الاحترافية عند التسجيل (0 = بدون)
            <input type="number" name="trial_days" value="<%= cfg.trial_days %>" min="0" max="30" dir="ltr" style="max-width:200px">
            <small class="field-hint">كل متجر جديد يحصل برو مجاناً لهذه المدة — 14 يوم موصى به</small>
          </label>
          <div style="margin-top:1rem; padding:1rem; background:#FFF7ED; border-radius:12px; border:1.5px solid #FFEDD5">
            <b>🎁 نظام الإحالة:</b> كل تاجر لديه رابط <code dir="ltr">/signup?ref=slug</code> — عند ترقية المدعو، الداعي يكسب شهر مجاني (تلقائي في <code>admin/payments</code>)
          </div>
        </div>

        <!-- Tab: Notify -->
        <div class="tab-panel" id="tab-notify">
          <h2>🔔 إشعارات تيليجرام</h2>
          <p class="muted" style="font-size:.82rem; margin-bottom:1rem">عند تفعيلهما، كل طلب جديد يرسل إشعار فوري لتيليجرام الإدارة</p>
          <label>توكن البوت (من @BotFather)
            <input type="text" name="telegram_bot_token" value="<%= cfg.telegram_bot_token %>" dir="ltr" placeholder="123456:ABC...">
          </label>
          <label>معرف المحادثة (Chat ID)
            <input type="text" name="telegram_admin_chat_id" value="<%= cfg.telegram_admin_chat_id %>" dir="ltr" placeholder="123456789">
            <small class="field-hint">أرسل /start للبوت ثم افتح https://api.telegram.org/botTOKEN/getUpdates</small>
          </label>
          <div style="margin-top:.8rem">
            <a href="https://api.telegram.org/bot<%= cfg.telegram_bot_token %>/getUpdates" target="_blank" class="btn btn-sm btn-ghost" style="<%= !cfg.telegram_bot_token ? 'opacity:.4; pointer-events:none' : '' %>">🔍 فحص الاتصال (getUpdates)</a>
          </div>
        </div>

        <div style="display:flex; gap:.6rem; margin-top:1.2rem; padding-top:1rem; border-top:1.5px solid var(--line)">
          <button type="submit" class="btn btn-primary" style="padding:.7rem 1.6rem; font-size:.95rem">💾 حفظ كل الإعدادات</button>
          <a href="/admin" class="btn btn-ghost">إلغاء</a>
          <span class="muted" style="font-size:.78rem; align-self:center; margin-inline-start:auto">💡 كل الحقول تُحفظ معاً — لا حاجة لحفظ كل تبويب</span>
        </div>
      </form>
    </div>

    <div class="card" style="background:linear-gradient(135deg,#eff6ff,#f0f9ff); border-color:#bfdbfe">
      <h2 style="color:#1e40af">💡 وصول كامل بدون كود</h2>
      <p class="muted" style="font-size:.85rem; line-height:1.7">من هذه الشاشة تتحكم بكل شيء: اسم المنصة، أسعار الباقات، أيام التجربة، واتساب الدعم، تيليجرام — كلها تُحفظ في <code>settings</code> وتظهر فوراً في كل المتاجر وصفحة الهبوط. لا حاجة للرجوع للكود أبداً.</p>
    </div>
  </div>
</main>
<style>
.site-tab{flex:1; min-width:120px; padding:.85rem 1rem; background:transparent; border:none; border-bottom:3px solid transparent; font-weight:700; font-size:.85rem; color:var(--muted); cursor:pointer; transition:all .2s; white-space:nowrap}
.site-tab.on{color:var(--brand); border-bottom-color:var(--brand); background:var(--card)}
.site-tab:hover{color:var(--ink); background:rgba(37,99,235,.04)}
.tab-panel{display:none; animation:fadeIn .25s}
.tab-panel.on{display:flex; flex-direction:column; gap:1rem}
</style>
<script>
function switchTab(id){
  document.querySelectorAll('.site-tab').forEach(b=>b.classList.remove('on'));
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('on'));
  document.querySelector(`[data-tab="${id}"]`).classList.add('on');
  document.getElementById('tab-'+id).classList.add('on');
  localStorage.setItem('admin_site_tab', id);
}
(function(){
  const saved = localStorage.getItem('admin_site_tab');
  if(saved && document.getElementById('tab-'+saved)) switchTab(saved);
})();
</script>
</body>
</html>