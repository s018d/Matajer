<%- include('../partials/head', { title: 'إدارة المتجر — ' + store.name }) %>
<body class="app">
<%- include('../partials/sidebar-admin', { active: 'stores' }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'إدارة المتجر: ' + store.name }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="two-col">
      <div class="card">
        <h2>بيانات المتجر</h2>
        <form method="post" action="/admin/stores/<%= store.id %>" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>اسم المتجر
            <input type="text" name="name" value="<%= store.name %>" required>
          </label>
          <label>الرابط الخاص (slug)
            <div class="ltr"><input type="text" name="slug" value="<%= store.slug %>" dir="ltr"></div>
          </label>
          <label>وصف
            <input type="text" name="description" value="<%= store.description %>">
          </label>
          <label>اسم صاحب المتجر
            <input type="text" name="owner_name" value="<%= store.owner_name %>">
          </label>
          <label>الهاتف
            <input type="text" name="phone" value="<%= store.phone %>" dir="ltr">
          </label>
          <label>القالب
            <select name="template">
              <option value="classic" <%= store.template==='classic' ? 'selected' : '' %>>الكلاسيكي</option>
              <option value="market" <%= store.template==='market' ? 'selected' : '' %>>الأسواقي (نمط الماركت)</option>
              <% if (store.template.match(/^t\d+$/)) { %><option value="<%= store.template %>" selected>مولّد (<%= store.template %>)</option><% } %>
              <% TPL_PREMIUM.forEach(pt => { %>
                <option value="<%= pt.id %>" <%= store.template===pt.id ? 'selected' : '' %>><%= pt.name %> — احترافي</option>
              <% }) %>
            </select>
            <small class="field-hint">التصاميم الاحترافية تبقى سارية فقط إذا كانت الباقة pro (يُرفض الحفظ إن لم تكن).</small>
          </label>
          <label>اللون الأساسي
            <input type="color" name="color" value="<%= store.color %>" class="color-input">
          </label>
          <label>حالة المتجر
            <select name="status">
              <option value="active" <%= store.status==='active' ? 'selected' : '' %>>نشط</option>
              <option value="suspended" <%= store.status==='suspended' ? 'selected' : '' %>>موقوف</option>
            </select>
          </label>
          <label>الدومين الخاص (اختياري)
            <input type="text" name="custom_domain" value="<%= store.custom_domain || '' %>" dir="ltr" placeholder="مثال: shop.mybrand.com">
            <small class="field-hint">عند ربط الدومين سيفتح المتجر عليه مباشرة — اتركه فارغاً لإلغائه.</small>
          </label>
          <label>رسوم التوصيل (د.ع)
            <input type="number" name="delivery_fee" min="0" step="500" value="<%= store.delivery_fee || 0 %>">
          </label>
          <label>توصيل مجاني فوق (د.ع، 0 = لا يوجد)
            <input type="number" name="free_delivery_min" min="0" step="500" value="<%= store.free_delivery_min || 0 %>">
          </label>
          <label>وصف محركات البحث (حتى 200 حرف)
            <input type="text" name="meta_desc" value="<%= store.meta_desc || '' %>" maxlength="200">
          </label>
          <button type="submit" class="btn btn-primary">حفظ</button>
        </form>
      </div>

      <div class="card">
        <h2>الباقة والاشتراك</h2>
        <form method="post" action="/admin/stores/<%= store.id %>/plan" class="stack">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>الباقة
            <select name="plan">
              <option value="free" <%= store.plan==='free' ? 'selected' : '' %>>مجانية</option>
              <option value="pro" <%= store.plan==='pro' ? 'selected' : '' %>>احترافية</option>
            </select>
          </label>
          <label>عدد الأشهر (عند تفعيل / تجديد)
            <input type="number" name="months" value="1" min="1" max="24">
          </label>
          <p class="muted" style="font-size:.82rem">تنتهي حالياً: <b dir="ltr"><%= store.plan_expires || '—' %></b></p>
          <button type="submit" class="btn btn-primary">حفظ الباقة</button>
        </form>
        <p class="muted" style="font-size:.8rem;margin-top:.6rem">طلبات الترقية من العملاء تظهر في «المدفوعات والباقات» لتأكيدها بضغطة واحدة.</p>

      <div class="card">
        <h2>الحساب المرافق</h2>
        <% if (owner) { %>
          <p>اسم المستخدم: <b dir="ltr"><%= owner.username %></b></p>
          <form method="post" action="/admin/stores/<%= store.id %>/resetpass">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button type="submit" class="btn btn-warn">تصفير كلمة المرور (توليد جديدة)</button>
          </form>
        <% } else { %>
          <p>لا يوجد حساب مرافق</p>
        <% } %>

        <h2 style="margin-top:2rem">إحصائيات</h2>
        <div class="stat-grid">
          <div class="stat"><span>منتجات</span><b><%= stats.products %></b></div>
          <div class="stat"><span>صور</span><b><%= stats.images %></b></div>
          <div class="stat"><span>طلبات</span><b><%= stats.orders %></b></div>
          <div class="stat"><span>مبيعات</span><b><%= money(stats.revenue) %></b></div>
          <div class="stat"><span>دعواته</span><b><%= referrals %></b></div>
          <div class="stat"><span>مكافآته</span><b><%= rewarded %></b></div>
        </div>

        <h2 style="margin-top:2rem">منطقة الخطر</h2>
        <form method="post" action="/admin/stores/<%= store.id %>/delete" onsubmit="return confirm('حذف المتجر نهائياً يمسح كل منتجاته وصوره؟')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-danger">حذف المتجر نهائياً</button>
        </form>
      </div>
    </div>
  </div>
</main>
</body>
</html>