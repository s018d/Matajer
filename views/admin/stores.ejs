<%- include('../partials/head', { title: 'المتاجر — مركز التحكم' }) %>
<body class="app">
<%- include('../partials/sidebar-admin', { active: 'stores', user }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: '🏪 المتاجر — تحكم كامل' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <div class="card" style="background:linear-gradient(135deg,#f8faff,#eff6ff); border-color:#bfdbfe">
      <h2>➕ إنشاء متجر جديد — بدون كود</h2>
      <p class="muted" style="font-size:.82rem; margin:.3rem 0 1rem">ينشئ متجر + حساب تاجر تلقائياً — كلمة المرور تظهر مرة واحدة</p>
      <form method="post" action="/admin/stores" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>اسم المتجر *<input type="text" name="name" required placeholder="مثال: عطور بغداد"></label>
        <label>اسم المستخدم *<input type="text" name="username" required dir="ltr" placeholder="baghdadscents"></label>
        <label>كلمة المرور<input type="text" name="password" dir="ltr" placeholder="اتركها للتوليد"></label>
        <label>اسم صاحب المتجر<input type="text" name="owner_name" placeholder="أحمد"></label>
        <label>الهاتف<input type="text" name="phone" dir="ltr" placeholder="0770..."></label>
        <label>نبذة<input type="text" name="description" placeholder="متجر عطور فاخرة"></label>
        <div style="grid-column:1/-1"><button type="submit" class="btn btn-primary" style="padding:.7rem 1.4rem">🚀 إنشاء المتجر</button></div>
      </form>
    </div>

    <div class="card">
      <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.8rem; margin-bottom:1rem">
        <h2>📚 كل المتاجر (<%= total %>)</h2>
        <form method="get" action="/admin/stores" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
          <input type="search" name="q" value="<%= q %>" placeholder="🔍 ابحث بالاسم/اليوزر/Slug..." style="min-width:220px; padding:.5rem .8rem; border-radius:10px; border:1.5px solid var(--line)">
          <select name="plan" style="padding:.5rem; border-radius:10px; border:1.5px solid var(--line)" onchange="this.form.submit()">
            <option value="">كل الباقات</option>
            <option value="pro" <%= plan==='pro' ? 'selected' : '' %>>⭐ برو فقط</option>
            <option value="free" <%= plan==='free' ? 'selected' : '' %>>مجاني فقط</option>
          </select>
          <select name="status" style="padding:.5rem; border-radius:10px; border:1.5px solid var(--line)" onchange="this.form.submit()">
            <option value="">كل الحالات</option>
            <option value="active" <%= status==='active' ? 'selected' : '' %>>نشط فقط</option>
            <option value="suspended" <%= status==='suspended' ? 'selected' : '' %>>موقوف فقط</option>
          </select>
          <button class="btn btn-sm btn-primary">بحث</button>
          <% if (q || plan || status) { %><a class="btn btn-sm btn-ghost" href="/admin/stores">إلغاء</a><% } %>
        </form>
      </div>
      <div class="table-wrap"><table class="table" id="storesTable">
        <tr><th>المتجر</th><th>مستخدم</th><th>منتجات</th><th>طلبات</th><th>مبيعات</th><th>الباقة</th><th>الحالة</th><th>إجراءات</th></tr>
        <% list.forEach(s => { %>
          <tr data-name="<%= (s.name + ' ' + (s.owner_username||'') + ' ' + s.slug).toLowerCase() %>" data-plan="<%= s.plan %>" data-status="<%= s.status %>">
            <td><a href="/admin/stores/<%= s.id %>"><b><%= s.name %></b></a><br><small class="muted">/s/<%= s.slug %> • ID:<%= s.id %></small></td>
            <td><span dir="ltr"><%= s.owner_username || '—' %></span></td>
            <td><span class="badge"><%= s.products %></span></td>
            <td><span class="badge"><%= s.orders %></span></td>
            <td><b><%= money(s.revenue) %></b></td>
            <td><span class="badge <%= s.plan === 'pro' ? 'badge-ok' : '' %>"><%= s.plan === 'pro' ? '⭐ برو' : 'مجانية' %></span></td>
            <td><span class="badge <%= s.status === 'active' ? 'badge-ok' : 'badge-err' %>"><%= s.status === 'active' ? 'نشط' : 'موقوف' %></span></td>
            <td class="row-actions">
              <a class="btn btn-sm btn-primary" href="/admin/stores/<%= s.id %>">⚙️ إدارة</a>
              <a class="btn btn-sm btn-ghost" href="/s/<%= s.slug %>" target="_blank">👁️ عرض</a>
            </td>
          </tr>
        <% }) %>
      </table></div>
      <% if (list.length === 0) { %><p class="muted" style="text-align:center; padding:1.5rem">لا متاجر مطابقة — جرّب كلمة أخرى أو <a href="/admin/stores">عرض الكل</a></p><% } %>
      <% if (totalPages > 1) { %>
        <div class="pager">
          <% const qp = (q ? '&q=' + encodeURIComponent(q) : '') + (plan ? '&plan=' + plan : '') + (status ? '&status=' + status : ''); %>
          <% if (page > 1) { %><a class="btn btn-sm btn-ghost" href="/admin/stores?page=<%= page - 1 %><%= qp %>">→ السابق</a><% } %>
          <span class="muted">صفحة <%= page %> من <%= totalPages %> (<%= total %> متجر)</span>
          <% if (page < totalPages) { %><a class="btn btn-sm btn-ghost" href="/admin/stores?page=<%= page + 1 %><%= qp %>">التالي ←</a><% } %>
        </div>
      <% } %>
      <p class="muted" style="font-size:.78rem; margin-top:.8rem">💡 اضغط "إدارة" لتعديل كل شيء: الاسم، القالب، اللون، التوصيل، SEO، الباقة — بدون كود</p>
    </div>
  </div>
</main>
</body>
</html>