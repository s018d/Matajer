<%- include('partials/head', { title: 'دخول — دُكّان Dukkan', css: '/css/app.css' }) %>
<body class="dk-auth">
  <div class="dk-auth-bg" aria-hidden="true"><span></span><span></span><span></span></div>
  <main class="dk-auth-card">
    <a class="dk-brand" href="/"><span class="dk-brand-mark">د</span><span class="dk-brand-name">دُكّان <small>Dukkan</small></span></a>
    <h1>مرحباً بعودتك</h1>
    <p class="dk-sub">ادخل للوحة متجرك — ضغطة وحدة وتكمل شغلك</p>

    <% if (typeof recent !== 'undefined' && recent && recent.length) { %>
    <div class="dk-chips">
      <span class="dk-chips-title">حساباتك على هالجهاز</span>
      <div class="dk-chips-row">
        <% recent.forEach(r => { %>
          <button type="button" class="dk-chip" data-user="<%= r.u %>" title="املأ اسم المستخدم">
            <span class="dk-chip-ava"><%= r.u.slice(0,1).toUpperCase() %></span>
            <span class="dk-chip-name" dir="ltr"><%= r.u %></span>
          </button>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %><div class="dk-alert">⚠️ <%= error %></div><% } %>

    <% if (typeof google !== 'undefined' && google) { %>
    <a class="dk-google" href="/login/google">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.2H12v4.3h6.5c-.1 1.1-.8 2.7-2.4 3.8l-.1.1 3.5 2.7.1.1c2.1-2 3.9-4.9 3.9-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2-3.2 0-5.9-2.1-6.8-5l-.1.1-3.7 2.9v.1C3.3 21.3 7.3 24 12 24z"/><path fill="#FBBC05" d="M5.2 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4l-.1-.1-3.6-2.8-.1.1C.5 8.7 0 10.2 0 12s.5 3.3 1.4 4.7l3.8-2.3z"/><path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.3 0 3.3 2.7 1.4 6.7l3.8 2.9c.9-2.8 3.6-4.9 6.8-4.9z"/></svg>
      الدخول بحساب جيميل
    </a>
    <div class="dk-or"><span>أو بالطريقة الكلاسيكية</span></div>
    <% } %>

    <form method="post" action="/login" id="dkLoginForm" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="dk-field">اسم المستخدم
        <input type="text" name="username" id="dkUser" required autofocus autocomplete="username" placeholder="مثال: baghdadscents" dir="ltr">
      </label>
      <label class="dk-field">كلمة المرور
        <span class="dk-pass">
          <input type="password" name="password" id="dkPass" required autocomplete="current-password" placeholder="••••••••">
          <button type="button" id="dkEye" title="إظهار/إخفاء">👁️</button>
        </span>
      </label>
      <div class="dk-row">
        <label class="dk-remember"><input type="checkbox" name="remember" value="1" checked> تذكرني (90 يوم)</label>
        <a class="dk-help" href="https://wa.me/9647831020026?text=نسيت%20كلمة%20مرور%20دكان" target="_blank">نسيت كلمة المرور؟</a>
      </div>
      <button type="submit" class="dk-submit" id="dkBtn"><span id="dkBtnT">دخول →</span><span id="dkBtnS" hidden>⏳ جارٍ الدخول...</span></button>
    </form>

    <a class="dk-signup" href="/signup">🚀 ما عندك متجر؟ أنشئه مجاناً بدقيقة</a>
    <p class="dk-foot">© 2026 دُكّان — صنع في العراق 🇮🇶</p>
  </main>
<style>
.dk-auth{min-height:100vh; display:flex; align-items:center; justify-content:center; padding:1.5rem; background:#0d0a08; font-family:'Noto Kufi Arabic','Cairo',sans-serif; position:relative; overflow:hidden}
.dk-auth-bg span{position:absolute; border-radius:50%; filter:blur(90px); opacity:.5}
.dk-auth-bg span:nth-child(1){width:420px; height:420px; background:#0B1F3A; top:-120px; right:-120px}
.dk-auth-bg span:nth-child(2){width:340px; height:340px; background:#C2410C; bottom:-120px; left:-100px; opacity:.35}
.dk-auth-bg span:nth-child(3){width:200px; height:200px; background:#FDBA74; top:40%; left:60%; opacity:.15}
.dk-auth-card{position:relative; z-index:1; width:100%; max-width:400px; background:rgba(255,255,255,.97); border-radius:22px; padding:2rem 1.8rem 1.5rem; box-shadow:0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(251,146,60,.25)}
.dk-brand{display:flex; align-items:center; gap:.6rem; text-decoration:none; margin-bottom:1.2rem}
.dk-brand-mark{width:40px; height:40px; border-radius:12px; background:linear-gradient(135deg,#0B1F3A,#C2410C 60%,#FDBA74); color:#fff; font-weight:900; font-size:1.4rem; display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(11,31,58,.4)}
.dk-brand-name{font-weight:900; font-size:1.25rem; color:#1c1917}
.dk-brand-name small{color:#C2410C; font-weight:700; font-size:.75rem}
.dk-auth-card h1{font-size:1.45rem; font-weight:900; color:#1c1917; margin:0 0 .2rem}
.dk-sub{color:#78716c; font-size:.85rem; margin:0 0 1.2rem}
.dk-chips{margin-bottom:1.1rem}
.dk-chips-title{font-size:.75rem; color:#a8a29e; font-weight:700}
.dk-chips-row{display:flex; gap:.5rem; margin-top:.45rem; flex-wrap:wrap}
.dk-chip{display:flex; align-items:center; gap:.45rem; border:1.5px solid #e7e5e4; background:#fafaf9; border-radius:999px; padding:.3rem .7rem .3rem .3rem; cursor:pointer; transition:all .18s; font-family:inherit}
.dk-chip:hover{border-color:#FDBA74; background:#FFF7ED; transform:translateY(-1px)}
.dk-chip-ava{width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg,#0B1F3A,#EA580C); color:#fff; font-weight:900; font-size:.85rem; display:flex; align-items:center; justify-content:center}
.dk-chip-name{font-size:.8rem; font-weight:700; color:#44403c}
.dk-alert{background:#fef2f2; border:1.5px solid #fecaca; color:#b91c1c; border-radius:12px; padding:.6rem .9rem; font-size:.85rem; font-weight:700; margin-bottom:1rem}
.dk-google{display:flex; align-items:center; justify-content:center; gap:.6rem; border:1.5px solid #e7e5e4; border-radius:14px; padding:.75rem; font-weight:800; font-size:.95rem; color:#1c1917; text-decoration:none; background:#fff; transition:all .18s}
.dk-google:hover{border-color:#4285F4; box-shadow:0 6px 18px rgba(66,133,244,.2); transform:translateY(-1px)}
.dk-or{display:flex; align-items:center; gap:.8rem; margin:1rem 0; color:#a8a29e; font-size:.75rem}
.dk-or::before,.dk-or::after{content:''; flex:1; height:1px; background:#e7e5e4}
.dk-field{display:block; font-size:.82rem; font-weight:800; color:#44403c; margin-bottom:.85rem}
.dk-field input{width:100%; margin-top:.35rem; border:1.5px solid #e7e5e4; border-radius:12px; padding:.7rem .9rem; font-size:.95rem; font-family:inherit; background:#fafaf9; transition:border .15s; box-sizing:border-box}
.dk-field input:focus{outline:none; border-color:#EA580C; background:#fff; box-shadow:0 0 0 3px rgba(234,88,12,.12)}
.dk-pass{position:relative; display:block}
.dk-pass input{padding-left:2.6rem}
.dk-pass button{position:absolute; left:.5rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; font-size:1.05rem}
.dk-row{display:flex; align-items:center; justify-content:space-between; font-size:.8rem; margin:.2rem 0 1rem}
.dk-remember{display:flex; align-items:center; gap:.4rem; color:#57534e; font-weight:700; cursor:pointer}
.dk-remember input{width:16px; height:16px; accent-color:#C2410C}
.dk-help{color:#C2410C; font-weight:800; text-decoration:none}
.dk-submit{width:100%; border:none; border-radius:14px; padding:.85rem; font-size:1.05rem; font-weight:900; font-family:inherit; color:#fff; cursor:pointer; background:linear-gradient(135deg,#0B1F3A,#C2410C 55%,#EA580C); box-shadow:0 10px 26px rgba(11,31,58,.4); transition:all .18s}
.dk-submit:hover{transform:translateY(-1px); box-shadow:0 14px 32px rgba(11,31,58,.5)}
.dk-submit:disabled{opacity:.7; cursor:wait; transform:none}
.dk-signup{display:block; text-align:center; margin-top:1rem; padding:.75rem; border-radius:14px; border:1.5px dashed #d6d3d1; color:#44403c; font-weight:800; font-size:.88rem; text-decoration:none; transition:all .18s}
.dk-signup:hover{border-color:#EA580C; background:#FFF7ED}
.dk-foot{text-align:center; font-size:.72rem; color:#a8a29e; margin:1.1rem 0 0}
</style>
<script>
document.querySelectorAll('.dk-chip').forEach(c=>c.addEventListener('click',()=>{const u=document.getElementById('dkUser'); u.value=c.dataset.user; document.getElementById('dkPass').focus();}));
document.getElementById('dkEye')?.addEventListener('click',function(){const i=document.getElementById('dkPass'); const s=i.type==='password'; i.type=s?'text':'password'; this.textContent=s?'🙈':'👁️';});
document.getElementById('dkLoginForm')?.addEventListener('submit',function(){const b=document.getElementById('dkBtn'); b.disabled=true; document.getElementById('dkBtnT').hidden=true; document.getElementById('dkBtnS').hidden=false;});
</script>
</html>
