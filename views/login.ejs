<%- include('partials/head', { title: 'دخول — دُكّان', css: '/css/app.css' }) %>
<body class="auth-body">
  <div class="auth-card">
    <a href="/" class="auth-back">→ رجوع للرئيسية</a>
    <div class="brand big">
      <span>🛍️</span>
      <b class="grad">Dukkan</b>
      <small>منصة المتاجر العراقية</small>
    </div>
    <% if (error) { %><div class="alert alert-err">⚠️ <%= error %></div><% } %>
    <form method="post" action="/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>اسم المستخدم
        <input type="text" name="username" required autofocus placeholder="أدخل اسم المستخدم">
      </label>
      <label>كلمة المرور
        <div style="position:relative">
          <input type="password" name="password" id="loginPass" required placeholder="أدخل كلمة المرور" style="padding-left:2.6rem">
          <button type="button" onclick="togglePass('loginPass',this)" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:1.1rem" title="إظهار/إخفاء">👁️</button>
        </div>
      </label>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:.5rem;padding:.75rem;font-size:1rem;border-radius:12px">
        🔐 تسجيل الدخول
      </button>
    </form>
    <div class="auth-divider"><span>أو</span></div>
    <a href="/signup" class="btn btn-ghost btn-block" style="border-radius:12px;padding:.7rem;font-size:.92rem">
      🚀 أنشئ متجرك مجاناً
    </a>
    <p class="auth-hint">_Callback المتاجر يدخلون من روابطهم مباشرة<br>هذه الصفحة للوحات التحكم فقط</p>
  </div>
</body>
<style>
.auth-divider{display:flex;align-items:center;gap:1rem;margin:1.2rem 0;color:#94a3b8;font-size:.82rem}
.auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,#e2e8f0,transparent)}
.auth-back{display:inline-flex;align-items:center;gap:.35rem;color:#0ea5e9;font-size:.85rem;font-weight:700;text-decoration:none;margin-bottom:1rem;padding:.35rem .6rem;border-radius:8px;background:#eff6ff;border:1px solid #bfdbfe;transition:all .2s}
.auth-back:hover{background:#dbeafe;transform:translateX(2px)}
</style>
<script>function togglePass(id,btn){const i=document.getElementById(id);const s=i.type==='password';i.type=s?'text':'password';btn.textContent=s?'🙈':'👁️'}</script>
</html>
