<%- include('../partials/head', { title: 'الباقات — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'billing', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'الباقات والاشتراك' }) %>
  <div class="content">
    <%- include('../partials/alerts', { ok: typeof ok !== 'undefined' ? ok : '', err: typeof err !== 'undefined' ? err : '' }) %>
    <% if (pro) { %>
      <div class="card">
        <h2>🎉 باقتك احترافية</h2>
        <p>متجرك بلا حدود منتجات وبلا علامة المنصة وبكل الأنماط العالمية — شكراً لثقتك!</p>
        <% if (store.plan_expires) { %><p class="muted">تنتهي باقتك بتاريخ: <b dir="ltr"><%= store.plan_expires %></b></p><% } %>
      </div>
    <% } else { %>
      <div class="card">
        <h2>باقتك الحالية: مجانية — وهذي هديتنا لك 🎁</h2>
        <p class="muted" style="margin-bottom:.8rem">أنت صاحب متجر حقيقي من اليوم. الباقة المجانية قوية بحد ذاتها، والاحترافية تفتح لك أضعافها عندما تكون جاهز.</p>
        <ul class="feed">
          <li><span class="feed-act">حد المنتجات:</span> <span class="feed-detail"><%= cfg.free_products %> منتج — كافية لبدء مبيعاتك فوراً</span></li>
          <li><span class="feed-act">التصميم:</span> <span class="feed-detail">الكلاسيكي النظيف + تخصيص حر بالألوان والخطوط</span></li>
          <li><span class="feed-act">كل المزايا الأساسية:</span> <span class="feed-detail">السلة والطلب والواتساب والبحث والتوصيل — كاملة بدون استثناء</span></li>
        </ul>
        <div style="margin-top:1rem;padding:1rem;background:linear-gradient(135deg,#eff6ff,#f0fdf4);border-radius:12px;border:1px solid #bfdbfe">
          <b style="color:#1d4ed8">✨ جرّب الاحترافية 7 أيام مجاناً</b>
          <p class="muted" style="margin-top:.3rem;font-size:.85rem">كل الأنماط العالمية تُفتح لك فوراً للتجربة — تنتهي تلقائياً بعد 7 أيام وتعود للمجانية بدون خصم أي شيء من بياناتك. إلغاؤها سهل مثل تشغيلها.</p>
        </div>
      </div>
      <p class="muted" style="text-align:center;margin:.6rem 0 .2rem;font-size:.88rem">💡 أرخص من كل المنصات — اختر ما يناسبك:</p>
      <div class="tiers">
        <div class="tier tier-hit">
          <div class="tier-tag">الأكثر طلباً ⭐</div>
          <h3>الاحترافية — شهري</h3>
          <span class="tier-sub">مرن — بدون التزام</span>
          <div class="tier-price"><b><%= Number(cfg.pro_price || 10000).toLocaleString('en-US') %></b><span>د.ع / شهر</span></div>
          <ul>
            <li>منتجات وأكواد بلا حدود</li>
            <li>كل القوالب الأربعة</li>
            <li>دومينك الخاص + بلا علامة</li>
            <li>تقارير + تيليجرام</li>
          </ul>
          <form method="post" action="/panel/billing/request?_csrf=<%= csrf %>" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="plan" value="pro">
            <input type="hidden" name="months" value="1">
            <input type="text" name="transfer_ref" placeholder="رقم الحوالة (اختياري)" dir="ltr" class="billing-input">
            <input type="file" name="receipt" accept="image/*" class="billing-file" title="صورة إثبات الدفع">
            <button class="btn btn-primary">أريد الاحترافية</button>
          </form>
        </div>
        <div class="tier tier-best">
          <div class="tier-tag" style="background:linear-gradient(135deg,#059669,#0d9488)">أفضل قيمة 👑</div>
          <h3>الاحترافية — سنوي</h3>
          <span class="tier-sub">شهرين مجاناً</span>
          <div class="tier-price"><b><%= Number(cfg.pro_price_12 || 100000).toLocaleString('en-US') %></b><span>د.ع / سنة</span></div>
          <div class="tier-monthly">≈ <%= Math.round(Number(cfg.pro_price_12 || 100000) / 12 / 1000 * 10) / 10 %> ألف / شهر فقط</div>
          <ul>
            <li>كل مزايا الاحترافية</li>
            <li>أولوية الدعم + التصاميم الجديدة</li>
          </ul>
          <form method="post" action="/panel/billing/request?_csrf=<%= csrf %>" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="plan" value="pro">
            <input type="hidden" name="months" value="12">
            <input type="text" name="transfer_ref" placeholder="رقم الحوالة (اختياري)" dir="ltr" class="billing-input">
            <input type="file" name="receipt" accept="image/*" class="billing-file" title="صورة إثبات الدفع">
            <button class="btn btn-primary">أريد السنوي</button>
          </form>
        </div>
        <div class="tier">
          <div class="tier-tag" style="background:linear-gradient(135deg,#7f1d1d,#b45309)">للفرق 🏢</div>
          <h3>الأعمال — شهري</h3>
          <span class="tier-sub">للمتاجر الكبيرة والفرق</span>
          <div class="tier-price"><b><%= Number(cfg.business_price || 25000).toLocaleString('en-US') %></b><span>د.ع / شهر</span></div>
          <ul>
            <li>كل مزايا الاحترافية</li>
            <li>حسابات فريق بصلاحيات</li>
            <li>تقارير متقدمة + أولوية واتساب</li>
          </ul>
          <form method="post" action="/panel/billing/request?_csrf=<%= csrf %>" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <input type="hidden" name="plan" value="business">
            <input type="hidden" name="months" value="1">
            <input type="text" name="transfer_ref" placeholder="رقم الحوالة (اختياري)" dir="ltr" class="billing-input">
            <input type="file" name="receipt" accept="image/*" class="billing-file" title="صورة إثبات الدفع">
            <button class="btn btn-primary">أريد الأعمال</button>
          </form>
        </div>
      </div>
      <div class="card">
        <h2>ماذا تحصل مع الباقة الاحترافية؟</h2>
        <ul class="feed">
          <li><span class="feed-act">القوالب البريميوم الثلاثة:</span> <span class="feed-detail">الذهب العاجي · الإمبراطورية السوداء · السوق العصري</span></li>
          <li><span class="feed-act">منتجات بلا حدود</span> <span class="feed-detail">+ أكواد خصم وتقييمات بلا حدود + مخزون وألوان</span></li>
          <li><span class="feed-act">دومينك الخاص:</span> <span class="feed-detail">شراء منفصل — تواصل واتساب للحصول على دومينك (مو ضمن سعر الباقة)</span></li>
          <li><span class="feed-act">بلا علامة منصة</span> <span class="feed-detail">+ أولوية الدعم المباشر</span></li>
        </ul>
        <div class="pay-box" style="background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;border:none;text-align:center">
          <div style="font-size:1.2rem;margin-bottom:.4rem">💬 للترقية تواصل واتساب مباشرة</div>
          <% if (cfg.site_whatsapp) { %>
            <a href="https://wa.me/<%= cfg.site_whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent('مرحبا، أريد ترقية متجري ' + store.name + ' (' + store.slug + ') — ما رقم التحويل والباقة؟') %>" target="_blank" class="btn btn-primary" style="background:#25d366;color:#fff;border:none;padding:.7rem 1.6rem;border-radius:12px;font-weight:800">واتساب: <%= cfg.site_whatsapp %></a>
          <% } else { %>
            <span style="color:#94a3b8">راسلنا واتساب للحصول على رقم التحويل — التفعيل خلال دقائق</span>
          <% } %>
          <div style="margin-top:.6rem;color:#94a3b8;font-size:.82rem">بعد التحويل اكتب رقم الحوالة وأرفق صورة الإيصال هنا — التفعيل خلال دقائق</div>
        </div>
      </div>
      <div class="card">
        <h2>طلبات الترقية السابقة</h2>
        <% if (payments.length === 0) { %><p class="muted">لا توجد طلبات بعد</p><% } %>
        <ul class="feed">
          <% payments.forEach(p => { %>
            <li>
              <span class="feed-act">طلب #<%= p.id %> — <%= p.plan === 'business' ? 'الأعمال' : 'الاحترافية' %> — <%= money(p.amount) %> (<%= p.months || 1 %> شهراً)</span>
              <span class="feed-detail">
                <span class="badge <%= p.status==='done' ? 'badge-ok' : 'badge-warn' %>">
                  <%= p.status === 'done' ? 'مفعّل' : (p.status === 'reported' ? 'أُرسل الدفع — بانتظار التأكيد' : 'بالتسوية') %>
                </span>
                <% if (p.ref) { %><small dir="ltr">المرجع: <%= p.ref %></small><% } %>
                <% if (p.note) { %><small>رقم الحوالة: <span dir="ltr"><%= p.note %></span></small><% } %>
                <% if (p.receipt_path) { %><a href="/panel/billing/receipt/<%= p.id %>" target="_blank" class="btn btn-sm">إثبات الدفع</a><% } %>
              </span>
              <small><%= p.created_at %></small>
            </li>
          <% }) %>
        </ul>
      </div>
<% } %>
  <div class="card">
    <h2>🎁 ادعُ صديقاً واكسب شهراً مجانياً</h2>
    <p class="muted">شارك رابطك مع أصحاب المتاجر — عندما يرقي أحدهم للباقة الاحترافية تحصل أنت على شهر إضافي مجاناً (حتى لو كان متجرك مجانياً).</p>
    <div class="link-box">
      <code dir="ltr" id="refLink"></code>
      <button class="btn btn-sm" type="button" onclick="copyRef()">نسخ</button>
    </div>
    <ul class="feed">
      <li><span class="feed-act">أصدقاؤك الذين سجلوا عبرك:</span> <span class="feed-detail"><b><%= referrals %></b> صديق</span></li>
      <li><span class="feed-act">المكافآت التي حصلت عليها:</span> <span class="feed-detail"><b><%= rewarded %></b> شهر مجاني</span></li>
    </ul>
  </div>
<script>
  const refLink = document.getElementById('refLink');
  refLink.textContent = location.origin + '/signup?ref=' + '<%= store.slug %>';
  window.copyRef = function () {
    navigator.clipboard.writeText(refLink.textContent).then(function () { refLink.nextElementSibling.textContent = 'تم النسخ ✓'; });
  };
</script>
  </div>
</main>
<style>
.pay-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; padding: .9rem 1rem; margin: 1rem 0; display: flex; flex-direction: column; gap: .3rem; }
.pay-box b { color: #1d4ed8; }
.pay-box span { font-size: .82rem; color: #475569; }
.pay-note { margin-top: .8rem; font-size: .85rem; }
.muted { color: #64748b; font-size: .88rem; }
.tiers { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin: 1rem 0; }
.tier { background: #fff; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.2rem; display: flex; flex-direction: column; gap: .5rem; position: relative; }
.tier h3 { margin: 0; color: #0f172a; font-size: 1.05rem; }
.tier-price { display: flex; align-items: baseline; gap: .35rem; }
.tier-price b { font-size: 1.6rem; color: #0d9488; }
.tier-price span { color: #64748b; font-size: .85rem; }
.tier ul { list-style: none; padding: 0; margin: 0 0 .5rem; font-size: .85rem; color: #475569; display: flex; flex-direction: column; gap: .3rem; }
.tier ul li::before { content: '✓ '; color: #0d9488; font-weight: 700; }
.tier-hit { border-color: #0d9488; box-shadow: 0 14px 34px -18px rgba(13,148,136,.5); }
.tier-best { border-color: #059669; box-shadow: 0 14px 34px -18px rgba(5,150,105,.45); }
.tier-tag { position: absolute; top: -10px; inset-inline-start: 1rem; background: #0d9488; color: #fff; font-size: .72rem; font-weight: 700; padding: .15rem .7rem; border-radius: 99px; }
.tier-sub { font-size: .78rem; color: #64748b; font-weight: 600; margin-top: -.2rem; }
.tier-monthly { font-size: .78rem; color: #475569; background: #f8fafc; border: 1px dashed #e2e8f0; border-radius: 8px; padding: .25rem .5rem; text-align: center; font-weight: 600; }
.tier-save { font-size: .78rem; color: #0d9488; font-weight: 700; background: #f0fdfa; border-radius: 6px; padding: .2rem .5rem; text-align: center; }
.billing-input, .billing-file { width: 100%; padding: .45rem .6rem; border: 1.5px solid #cbd5e1; border-radius: 8px; font-family: inherit; font-size: .82rem; background: #fff; }
.billing-file { padding: .35rem; }
</style>
</body>
</html>