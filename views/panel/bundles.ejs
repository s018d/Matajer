<%- include('../partials/head', { title: 'العروض المجمعة — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'bundles', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'العروض المجمعة (Bundles)' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card-head-row">
      <h2>العروض المجمعة (<%= bundles.length %>)</h2>
      <a class="btn btn-primary" href="/panel/bundles/new">+ عرض جديد</a>
    </div>
    <table>
      <tr><th>العرض</th><th>النوع</th><th>القيمة</th><th>الحد الأدنى</th><th>المنتجات</th><th>الحالة</th><th>إجراءات</th></tr>
      <% bundles.forEach(b => { %>
        <tr>
          <td><a href="/panel/bundles/<%= b.id %>/products"><%= b.name %></a><br><small class="muted"><%= b.description %></small></td>
          <td><%= b.discount_type === 'percent' ? 'نسبة %' : 'مبلغ ثابت' %></td>
          <td><%= b.discount_type === 'percent' ? b.discount_value + '%' : money(b.discount_value) %></td>
          <td><%= b.min_products %> منتج</td>
          <td><span class="badge <%= b.in_bundle ? 'badge-ok' : 'badge-warn' %>"><%= b.product_count %> منتجات</span></td>
          <td><span class="badge <%= b.active ? 'badge-ok' : 'badge-warn' %>"><%= b.active ? 'مفعل' : 'معطل' %></span></td>
          <td class="row-actions">
            <a class="btn btn-sm" href="/panel/bundles/<%= b.id %>/products">منتجات</a>
            <form method="post" action="/panel/bundles/<%= b.id %>/toggle" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-ghost"><%= b.active ? 'تعطيل' : 'تفعيل' %></button>
            </form>
            <form method="post" action="/panel/bundles/<%= b.id %>/delete" class="inline" onsubmit="return confirm('حذف العرض نهائياً؟')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-danger">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
    <% if (bundles.length === 0) { %><p class="empty-note">لا توجد عروض مجمعة — <a href="/panel/bundles/new">أنشئ أول عرض</a></p><% } %>
    <div style="margin-top:1rem; text-align:center">
      <a class="btn btn-primary" href="/panel/bundles/new">+ إنشاء عرض جديد</a>
    </div>
  </div>
</main>
</body>
</html>