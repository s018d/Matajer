<%- include('../partials/head', { title: 'الكاش فلو — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'cashflow', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'الكاش فلو (التدفقات النقدية)' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem; align-items:center">
      <h2>الكاش فلو</h2>
      <form method="get" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
        <select name="period" onchange="this.form.submit()" style="padding:.5rem; border:1px solid var(--line); border-radius:8px">
          <option value="7d" <%= period==='7d'?'selected':'' %>>آخر 7 أيام</option>
          <option value="30d" <%= period==='30d'?'selected':'' %>>آخر 30 يوم</option>
          <option value="90d" <%= period==='90d'?'selected':'' %>>آخر 90 يوم</option>
          <option value="custom" <%= period==='custom'?'selected':'' %>>مخصص</option>
        </select>
        <% if (period === 'custom') { %>
          <input type="date" name="start_date" value="<%= customStart || '' %>" style="padding:.5rem; border:1px solid var(--line); border-radius:8px">
          <input type="date" name="end_date" value="<%= customEnd || '' %>" style="padding:.5rem; border:1px solid var(--line); border-radius:8px">
        <% } %>
        <button type="submit" class="btn btn-sm btn-primary">تطبيق</button>
        <a class="btn btn-sm btn-primary" href="/panel/cashflow/export?period=<%= period %><%= customStart ? '&start_date='+customStart : '' %><%= customEnd ? '&end_date='+customEnd : '' %>">⬇️ تصدير CSV</a>
      </form>
    </div>
    
    <div class="stat-grid" style="margin-top:1rem">
      <div class="stat stat-strong"><span>الإيرادات</span><b style="color:#16a34a"><%= money(income) %></b></div>
      <div class="stat stat-strong"><span>المصروفات</span><b style="color:#dc2626"><%= money(expense) %></b></div>
      <div class="stat stat-strong"><span>الصافي</span><b style="color:<%= netFlow >= 0 ? '#16a34a' : '#dc2626' %>"><%= money(netFlow) %></b></div>
      <div class="stat"><span>COD معلق</span><b><%= money(pendingCod) %></b></div>
      <div class="stat"><span>شحنات معلقة</span><b><%= money(pendingShipping) %></b></div>
      <div class="stat"><span>مندوبين معلقين</span><b><%= money(pendingDriver) %></b></div>
    </div>
    
    <div class="two-col" style="margin-top:1rem">
      <div class="card">
        <h3>الإيرادات حسب الفئة</h3>
        <% if (incomeByCategory.length === 0) { %>
          <p class="muted">لا توجد إيرادات في هذه الفترة</p>
        <% } else { %>
          <div style="display:flex; flex-direction:column; gap:.5rem">
            <% incomeByCategory.forEach(c => { %>
              <div style="display:flex; justify-content:space-between; align-items:center; padding:.5rem; background:var(--soft); border-radius:8px">
                <span><%= c.category %></span>
                <b style="color:#16a34a"><%= money(c.total) %></b>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
      
      <div class="card">
        <h3>المصروفات حسب الفئة</h3>
        <% if (expenseByCategory.length === 0) { %>
          <p class="muted">لا توجد مصروفات في هذه الفترة</p>
        <% } else { %>
          <div style="display:flex; flex-direction:column; gap:.5rem">
            <% expenseByCategory.forEach(c => { %>
              <div style="display:flex; justify-content:space-between; align-items:center; padding:.5rem; background:var(--soft); border-radius:8px">
                <span><%= c.category %></span>
                <b style="color:#dc2626"><%= money(c.total) %></b>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>التدفق اليومي (آخر <%= dailyFlow.length %> أيام)</h3>
      <div style="height:300px; display:flex; align-items:flex-end; gap:.5rem; padding:1rem; background:var(--soft); border-radius:10px; overflow-x:auto; min-width:0">
        <% const maxFlow = Math.max(1, ...dailyFlow.map(d => Math.max(d.income, d.expense))); %>
        <% dailyFlow.forEach(d => { %>
          <div style="flex:1 0 42px; min-width:0; display:flex; flex-direction:column; align-items:center; gap:.3rem; height:100%">
            <div style="width:100%; background:#e0e7ff; border-radius:4px; height:<%= (d.income / maxFlow) * 100 %>%; min-height:4px; position:relative">
              <div style="position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(180deg, var(--primary), #0d9488); border-radius:4px"></div>
            </div>
            <div style="width:100%; background:#fecaca; border-radius:4px; height:<%= (d.expense / maxFlow) * 100 %>%; min-height:4px; position:relative; margin-top:-<%= (d.expense / maxFlow) * 100 %>%">
              <div style="position:absolute; top:0; left:0; right:0; bottom:0; background:linear-gradient(180deg, #ef4444, #dc2626); border-radius:4px"></div>
            </div>
            <span class="muted" style="font-size:.65rem"><%= d.d %></span>
            <div style="font-size:.6rem; color:#16a34a"><%= d.income > 0 ? '+' + (d.income/1000).toFixed(1) + 'k' : '0' %></div>
            <div style="font-size:.6rem; color:#dc2626"><%= d.expense > 0 ? '-' + (d.expense/1000).toFixed(1) + 'k' : '0' %></div>
          </div>
        <% }) %>
      </div>
      <div style="display:flex; justify-content:center; gap:2rem; margin-top:.5rem; font-size:.75rem">
        <span style="color:#0ea5e9">■ الإيرادات</span>
        <span style="color:#ef4444">■ المصروفات</span>
      </div>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>المعاملات الأخيرة</h3>
      <table>
        <tr><th>النوع</th><th>الفئة</th><th>المبلغ</th><th>الوصف</th><th>المرجع</th><th>التاريخ</th></tr>
        <% recent.forEach(e => { %>
          <tr>
            <td><span class="badge <%= e.type === 'income' ? 'badge-ok' : 'badge-err' %>"><%= e.type === 'income' ? 'إيراد' : 'مصروف' %></span></td>
            <td><%= e.category %></td>
            <td dir="ltr" style="color:<%= e.type === 'income' ? '#16a34a' : '#dc2626' %>"><%= e.type === 'income' ? '+' : '-' %><%= money(e.amount) %></td>
            <td><%= e.description || '—' %></td>
            <td><%= e.reference_type || '—' %> <% if (e.reference_id) { %>#<%= e.reference_id %><% } %></td>
            <td dir="ltr"><%= e.created_at.slice(0,16) %></td>
          </tr>
        <% }) %>
      </table>
      <% if (recent.length === 0) { %><p class="empty-note">لا توجد معاملات في هذه الفترة</p><% } %>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>المستحقات المعلقة</h3>
      <div class="three-cards" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem">
        <div class="card" style="border-color:#f59e0b">
          <h4 style="color:#f59e0b">💰 كاش عند الاستلام (COD) معلق</h3>
          <div style="font-size:2rem; font-weight:800; color:#f59e0b"><%= money(pendingCod) %></div>
          <p class="muted" style="font-size:.8rem">شحنات تم استلامها ولم يتم تحصيلها بعد</p>
        </div>
        <div class="card" style="border-color:#3b82f6">
          <h4 style="color:#3b82f6">🚚 مستحقات شركات الشحن</h4>
          <div style="font-size:2rem; font-weight:800; color:#3b82f6"><%= money(pendingShipping) %></div>
          <p class="muted" style="font-size:.8rem">تسويات معلقة مع شركات التوصيل</p>
        </div>
        <div class="card" style="border-color:#8b5cf6">
          <h4 style="color:#8b5cf6">👥 مستحقات المندوبين</h4>
          <div style="font-size:2rem; font-weight:800; color:#8b5cf6"><%= money(pendingDriver) %></div>
          <p class="muted" style="font-size:.8rem">تسويات مندوبين معلقة الدفع</p>
        </div>
      </div>
    </div>
  </div>
</main>
<script src="/js/notify.js"></script>
</body>
</html>