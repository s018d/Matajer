<%- include('../partials/head', { title: 'الدومين المخصص — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'settings', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'الدومين المخصص' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <% if (store.custom_domain) { %>
      <div class="card">
        <h2>🌐 دومينك الحالي</h2>
        <div style="background:linear-gradient(135deg,#eff6ff,#f0fdf4);border:1.5px solid #bfdbfe;border-radius:12px;padding:1rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.8rem">
          <code dir="ltr" style="font-size:1.15rem;font-weight:700;color:#1d4ed8"><%= store.custom_domain %></code>
          <span class="badge badge-ok">مفعل ✅</span>
        </div>
        <p class="muted" style="margin-top:.6rem">متجرك يعمل على هذا الدومين. للتعديل أو التغيير، تواصل مع الدعم عبر واتساب.</p>
        <% if (typeof cfg !== 'undefined' && cfg.site_whatsapp) { %>
          <a href="https://wa.me/<%= cfg.site_whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent('مرحبا، أريد تعديل دومين متجري ' + store.name + ' (' + store.custom_domain + ')') %>" target="_blank" class="btn btn-sm btn-ghost" style="margin-top:.5rem">💬 طلب تعديل من الدعم</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="card">
        <h2>🌐 تريد دومين خاص؟ عندك خيارين</h2>
        <div class="tiers" style="margin-top:1rem">
          <div class="tier tier-hit">
            <h3>🛒 نشتريلك الدومين</h3>
            <div class="tier-price"><b>من 20 ألف</b><span>د.ع</span></div>
            <ul>
              <li>نحن نشتري ونربط — صفر تعب</li>
              <li>جاهز خلال 24 ساعة</li>
              <li>تجديد سنوي سهل من هنا</li>
            </ul>
            <a href="/panel/domain/buy" class="btn btn-primary btn-block">🛒 اطلب الآن</a>
          </div>
          <div class="tier">
            <div class="tier-tag">حسب الطلب</div>
            <h3>💎 دومين مميز</h3>
            <div class="tier-price"><b>سعر خاص</b></div>
            <ul>
              <li>اسم قصير أو جميل</li>
              <li>تسعير شخصي مع الدعم</li>
            </ul>
            <% if (typeof cfg !== 'undefined' && cfg.site_whatsapp) { %>
              <a class="btn btn-warn btn-block" href="https://wa.me/<%= cfg.site_whatsapp.replace(/\D/g,'') %>?text=<%= encodeURIComponent('مرحبا، أريد دومين مميز لمتجري ' + store.name) %>" target="_blank">💬 واتساب الدعم</a>
            <% } else { %>
              <a class="btn btn-warn btn-block" href="/panel/billing">تواصل معنا</a>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
    
    <% if (store.custom_domain) { %>
    <details style="margin-top:1rem" class="card">
      <summary style="cursor:pointer;font-weight:700;color:var(--muted)">⚙️ تفاصيل تقنية (للمهتمين)</summary>
      <div class="muted" style="font-size:.82rem;line-height:1.9;margin-top:.8rem">
        <p><strong>إعداد DNS (يتم من طرفنا):</strong> CNAME يشير إلى نطاق المنصة، شهادة SSL تلقائية عبر Let's Encrypt.</p>
        <p><strong>ملاحظة:</strong> أي تعديل على DNS يتم من فريق دُكّان — أنت لا تحتاج لمس أي إعدادات.</p>
      </div>
    </details>
    <% } %>
  </div>
</main>
</body>
</html>
