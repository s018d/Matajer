<%- include('../partials/head', { title: 'تسوية المندوبين — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'shipping', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'تسوية المندوبين' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card-head-row">
      <h2>تسويات المندوبين</h2>
    </div>

    <div class="card" style="margin-bottom:1rem; padding:1rem; background:var(--soft); border-radius:10px">
      <h3 style="margin-bottom:.5rem">إنشاء تسوية جديدة</h3>
      <form method="post" action="/panel/driver-settlements" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:end">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div>
          <label class="muted" style="font-size:.8rem">المندوب</label>
          <select name="driver_id" required style="padding:.5rem; border:1.5px solid var(--line); border-radius:8px; font-family:inherit">
            <% drivers.forEach(d => { %><option value="<%= d.id %>"><%= d.name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="muted" style="font-size:.8rem">من تاريخ</label>
          <input type="date" name="period_start" required style="padding:.5rem; border:1.5px solid var(--line); border-radius:8px; font-family:inherit">
        </div>
        <div>
          <label class="muted" style="font-size:.8rem">إلى تاريخ</label>
          <input type="date" name="period_end" required style="padding:.5rem; border:1.5px solid var(--line); border-radius:8px; font-family:inherit">
        </div>
        <button class="btn btn-primary" type="submit">احسب التسوية</button>
      </form>
    </div>

    <table>
      <tr><th>المندوب</th><th>الفترة</th><th>الطلبات</th><th>العمولة</th><th>COD محصّل</th><th>سلف</th><th>صافي المستحق</th><th>الحالة</th><th>إجراء</th></tr>
      <% settlements.forEach(s => { %>
        <tr>
          <td><b><%= s.driver_name %></b></td>
          <td dir="ltr"><%= s.period_start %> → <%= s.period_end %></td>
          <td><%= s.total_orders %></td>
          <td dir="ltr"><%= money(s.total_commission) %></td>
          <td dir="ltr"><%= money(s.total_cod_collected) %></td>
          <td dir="ltr"><%= money(s.advances_paid) %></td>
          <td dir="ltr"><b><%= money(s.net_payable) %></b></td>
          <td>
            <% if (s.status === 'paid') { %>
              <span class="badge badge-ok">مدفوع</span>
            <% } else { %>
              <span class="badge badge-warn">معلق</span>
              <form method="post" action="/panel/driver-settlements/<%= s.id %>/pay" class="inline" style="display:inline; margin-inline-start:.4rem">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-sm btn-primary">تسديد</button>
              </form>
            <% } %>
          </td>
          <td><small class="muted"><%= s.created_at %></small></td>
        </tr>
      <% }) %>
    </table>
    <% if (settlements.length === 0) { %><p class="empty-note">لا توجد تسويات بعد — أنشئ أول تسوية أعلاه.</p><% } %>
  </div>
</main>
</body>
</html>
