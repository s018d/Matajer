<%- include('../partials/head', { title: 'إضافة/تعديل ترجمة كردية — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'kurdish', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: isNew ? 'إضافة ترجمة كردية' : 'تعديل ترجمة: ' + translation.key }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card" style="max-width:700px">
      <h2><%= isNew ? 'إضافة ترجمة كردية جديدة' : 'تعديل الترجمة: ' + translation.key %></h2>
      <form method="post" action="<%= isNew ? '/panel/kurdish' : '/panel/kurdish/' + translation.key %>" class="stack" style="margin-top:1rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (!isNew) { %>
          <input type="hidden" name="key" value="<%= translation.key %>">
          <label>المفتاح (Key) <small class="muted">(لا يمكن تعديله)</small>
            <input type="text" value="<%= translation.key %>" disabled style="background:var(--soft); color:var(--muted); cursor:not-allowed">
          </label>
        <% } else { %>
          <label>المفتاح (Key) *
            <input type="text" name="key" required placeholder="مثال: product.add_to_cart" pattern="^[a-z0-9._]+$" dir="ltr" style="font-family:monospace">
            <small class="muted">أحرف إنجليزية صغيرة، أرقام، نقطة، وشرطة سفلية فقط</small>
          </label>
        <% } %>
        <label>الترجمة العربية (المصدر) *
          <textarea name="arabic" rows="3" required placeholder="النص بالعربي"><%= (translation && translation.arabic) || '' %></textarea>
        </label>
        <label>الكردية السورانية (Sorani) *
          <textarea name="kurdish_sorani" rows="3" required placeholder="النص بالكردية السورانية (مثال: زیاد كردن بۆ سەبەتە)"><%= (translation && translation.kurdish_sorani) || '' %></textarea>
        </label>
        <label>الكردية الكرمانجية (Kurmanji) *
          <textarea name="kurdish_kurmanji" rows="3" required placeholder="النص بالكردية الكرمانجي (مثال: zêde kirin bi sebete)"><%= (translation && translation.kurdish_kurmanji) || '' %></textarea>
        </label>
        <label>السياق/ملاحظات (اختياري)
          <textarea name="context" rows="2" placeholder="مثال: زر في صفحة المنتج، نص في رسالة تأكيد..."><%= (translation && translation.context) || '' %></textarea>
        </label>
        <button type="submit" class="btn btn-primary">💾 <%= isNew ? 'إضافة الترجمة' : 'حفظ التعديلات' %></button>
        <a class="btn btn-ghost" href="/panel/kurdish" style="margin-right:.5rem">إلغاء</a>
      </form>
    </div>
  </div>
</main>
</body>
</html>