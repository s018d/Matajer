<%- include('../partials/head', { title: 'الترجمات الكردية — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'kurdish', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'الترجمات الكردية (Sorani / Kurmanji)' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem; align-items:center">
      <h2>الترجمات الكردية (<%= translations.length %>)</h2>
      <a class="btn btn-primary" href="/panel/kurdish/new">+ ترجمة جديدة</a>
    </div>
    
    <form method="get" class="search-form" style="margin-bottom:1rem">
      <input type="search" name="q" placeholder="ابحث بالمفتاح/العربي/الكردي..." value="<%= typeof q !== 'undefined' ? q : '' %>">
      <button class="btn btn-sm" type="submit">🔍 بحث</button>
      <% if (q) { %><a class="btn btn-sm btn-ghost" href="/panel/kurdish">إلغاء</a><% } %>
    </form>
    
    <table>
      <tr><th>المفتاح (Key)</th><th>العربي</th><th>السورانية (Sorani)</th><th>الكرمانجية (Kurmanji)</th><th>إجراء</th></tr>
      <% translations.forEach(t => { %>
        <tr>
          <td><code><%= t.key %></code></td>
          <td><%= t.arabic || '—' %></td>
          <td><%= t.kurdish_sorani || '—' %></td>
          <td><%= t.kurdish_kurmanji || '—' %></td>
          <td class="row-actions">
            <a class="btn btn-sm" href="/panel/kurdish/edit/<%= t.key %>">تعديل</a>
            <form method="post" action="/panel/kurdish/<%= t.key %>/delete" class="inline" onsubmit="return confirm('حذف الترجمة نهائياً؟')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-danger">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
    <% if (translations.length === 0) { %><p class="empty-note">لا توجد ترجمات — <a href="/panel/kurdish/new">أضف أول ترجمة</a></p><% } %>
  </div>
</main>
</body>
</html>