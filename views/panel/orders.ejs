<%- include('../partials/head', { title: 'الطلبات — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'orders', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'الطلبات' }) %>
  <div class="content">
    <div class="filter-row" style="display:flex;flex-wrap:wrap;gap:.6rem;align-items:center;justify-content:space-between">
      <div style="display:flex;gap:.4rem;flex-wrap:wrap;align-items:center">
        <% [['all','الكل'],['new','جديد'],['confirmed','مؤكد'],['completed','مكتمل'],['cancelled','ملغي']].forEach(f => { %>
          <a class="btn btn-sm <%= filter === f[0] ? 'btn-primary' : 'btn-ghost' %>" href="/panel/orders?status=<%= f[0] %>"><%= f[1] %></a>
        <% }) %>
      </div>
      <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-inline-start:auto">
        <a class="btn btn-sm btn-ghost" href="/panel/orders/export?status=<%= filter %>&q=<%= typeof searchQ !== 'undefined' ? encodeURIComponent(searchQ) : '' %>" style="border:1.5px solid var(--line,#e2e8f0);background:#fff;font-weight:700;white-space:nowrap">⬇ تصدير CSV</a>
        <form class="search-form" method="get" style="display:flex;gap:.4rem;align-items:center">
          <input type="hidden" name="status" value="<%= filter %>">
          <input type="search" name="q" placeholder="ابحث بالاسم/الهاتف/رقم الطلب…" value="<%= typeof searchQ !== 'undefined' ? searchQ : '' %>">
          <button class="btn btn-sm" type="submit">🔍</button>
          <% if (searchQ) { %><a class="btn btn-sm btn-ghost" href="/panel/orders?status=<%= filter %>">إلغاء</a><% } %>
        </form>
      </div>
    </div>
    <% if (rows.length === 0) { %>
      <div class="empty-state" style="text-align:center;padding:2.6rem 1.5rem;background:#fff;border:1.5px dashed #e2e8f0;border-radius:16px;margin-top:1rem;display:flex;flex-direction:column;align-items:center;gap:.6rem">
        <% if (typeof searchQ !== 'undefined' && searchQ) { %>
          <div style="width:64px;height:64px;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:1.8rem">🔍</div>
          <h3 style="margin:0;color:#0f172a;font-size:1.05rem">لا نتائج لـ “<%= searchQ %>”</h3>
          <p class="muted" style="font-size:.88rem">جرّب كلمة أخرى أو امسح البحث لعرض كل الطلبات</p>
          <a class="btn btn-sm btn-ghost" href="/panel/orders?status=<%= filter %>" style="margin-top:.4rem;border:1.5px solid var(--line,#e2e8f0)">مسح البحث</a>
        <% } else if (filter !== 'all') { %>
          <div style="width:64px;height:64px;border-radius:50%;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-size:1.8rem">📂</div>
          <h3 style="margin:0;color:#0f172a;font-size:1.05rem">لا طلبات بحالة “<%= ({new:'جديد',confirmed:'مؤكد',completed:'مكتمل',cancelled:'ملغي'}[filter]) %>”</h3>
          <p class="muted" style="font-size:.88rem">غيّر الفلتر لعرض حالات أخرى</p>
          <a class="btn btn-sm btn-ghost" href="/panel/orders?status=all" style="margin-top:.4rem;border:1.5px solid var(--line,#e2e8f0)">عرض كل الطلبات</a>
        <% } else { %>
          <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#f8fafc,#eff6ff);border:1px solid #dbeafe;display:flex;align-items:center;justify-content:center;font-size:2rem">🧾</div>
          <h3 style="margin:0;color:#0f172a;font-size:1.1rem">لا طلبات بعد</h3>
          <p class="muted" style="max-width:360px;font-size:.88rem;line-height:1.7">عندما يطلب زبون من متجرك سيظهر الطلب هنا مع تنبيه صوتي فوري</p>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap;justify-content:center;margin-top:.4rem">
            <a class="btn btn-sm btn-primary" href="/panel/products">➕ أضف منتجاً</a>
            <button class="btn btn-sm btn-ghost" onclick="navigator.clipboard.writeText(location.origin+'/s/<%= store.slug %>');this.textContent='✓ تم النسخ'" style="border:1.5px solid var(--line,#e2e8f0);background:#fff">🔗 نسخ رابط المتجر</button>
          </div>
          <p class="muted" style="font-size:.78rem;margin-top:.2rem">شارك رابط متجرك على واتساب لتبدأ البيع</p>
        <% } %>
      </div>
    <% } %>
    <% rows.forEach(o => { %>
      <div class="order-card">
        <div class="order-head">
          <b>طلب #<%= o.id %></b>
          <span class="badge <%= o.status === 'new' ? 'badge-warn' : (o.status === 'completed' ? 'badge-ok' : (o.status === 'cancelled' ? 'badge-danger' : '')) %>">
            <%= { new: 'جديد', confirmed: 'مؤكد', completed: 'مكتمل', cancelled: 'ملغي' }[o.status] %>
          </span>
          <span class="muted" dir="ltr"><%= o.created_at %></span>
        </div>
        <div class="order-body">
          <div class="order-cust">
            <div><b><%= o.customer_name %></b> <span dir="ltr" class="muted"><%= o.customer_phone %></span></div>
            <div class="muted"><%= o.customer_address || '—' %></div>
            <% if (o.note) { %><div class="order-note">ملاحظة: <%= o.note %></div><% } %>
          </div>
          <table class="mini">
            <% o.items.forEach(it => { %>
              <tr>
                <td><%= it.product_name %> ×<%= it.qty %>
                  <% if (it.options) { %><div class="muted small">خيارات: <%= it.options %></div><% } %>
                </td>
                <td dir="ltr"><%= money(it.product_price * it.qty + (it.addons_price || 0) * it.qty) %></td>
              </tr>
            <% }) %>
          </table>
          <div class="order-totals">
            <% if (o.subtotal != null) { %>
              <div class="small muted">المجموع الفرعي: <%= money(o.subtotal) %></div>
            <% } %>
            <% if (o.discount && Number(o.discount) > 0) { %>
              <div class="small muted">الخصم (<%= o.coupon_code %>): <span style="color:#dc2626">−<%= money(o.discount) %></span></div>
            <% } %>
            <% if (o.delivery_fee != null) { %>
              <div class="small muted">التوصيل: <%= Number(o.delivery_fee) === 0 ? 'مجاني' : money(o.delivery_fee) %></div>
            <% } %>
            <div><b>الإجمالي: <%= money(o.total) %></b></div>
          </div>
          <div class="order-actions">
            <form method="post" action="/panel/orders/<%= o.id %>/status?back=<%= filter %>" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <select name="status" onchange="this.form.submit()">
                <option value="new" <%= o.status==='new' ? 'selected' : '' %>>جديد</option>
                <option value="confirmed" <%= o.status==='confirmed' ? 'selected' : '' %>>مؤكد</option>
                <option value="completed" <%= o.status==='completed' ? 'selected' : '' %>>مكتمل</option>
                <option value="cancelled" <%= o.status==='cancelled' ? 'selected' : '' %>>ملغي</option>
              </select>
            </form>
            <% const custWa = String(o.customer_phone || '').replace(/[^0-9]/g, '').replace(/^0/, '964'); %>
            <% if (custWa) { %>
              <a class="btn btn-sm btn-ok" target="_blank" rel="noopener" href="https://wa.me/<%= custWa %>?text=<%= encodeURIComponent('مرحباً ' + o.customer_name + '، معك ' + store.name + ' بخصوص طلبك #' + o.id + ' (' + o.total + ' د.ع)') %>">واتساب الزبون</a>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>

    <% if (totalPages > 1) { %>
      <div class="pager">
        <% const qParam = searchQ ? '&q=' + encodeURIComponent(searchQ) : ''; %>
        <% if (page > 1) { %><a class="btn btn-sm btn-ghost" href="/panel/orders?status=<%= filter %><%= qParam %>&page=<%= page - 1 %>">→ السابق</a><% } %>
        <span class="muted">صفحة <%= page %> من <%= totalPages %> (<%= total %> طلب)</span>
        <% if (page < totalPages) { %><a class="btn btn-sm btn-ghost" href="/panel/orders?status=<%= filter %><%= qParam %>&page=<%= page + 1 %>">التالي ←</a><% } %>
      </div>
    <% } %>
    <p class="muted" style="margin-top:1rem">
      <button id="soundBtn" class="btn btn-sm" onclick="toggleSound()">🔕 إيقاف التنبيه</button>
      <span style="font-size:.8rem">عند وصول طلب جديد يصدر تنبيه صوتي تلقائياً — أول فحص كل 30 ثانية.</span>
    </p>
  </div>
</main>
<script src="/js/notify.js"></script>
<style>
.pager { display: flex; align-items: center; justify-content: center; gap: .8rem; margin: 1rem 0; }
</style>
</body>
</html>