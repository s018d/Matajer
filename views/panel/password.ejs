<%- include('../partials/head', { title: 'تغيير كلمة المرور — لوحة المتجر' }) %>
<style>.auth-back{display:inline-flex;align-items:center;gap:.35rem;color:#C2410C;font-size:.85rem;font-weight:700;text-decoration:none;padding:.4rem .7rem;border-radius:8px;background:#FFF7ED;border:1px solid #FFEDD5;transition:all .2s}.auth-back:hover{background:#FFF7ED;transform:translateX(2px)}</style>
<body class="app">
<%- include('../partials/sidebar-panel') %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'تغيير كلمة المرور' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <a href="/panel" class="auth-back" style="display:inline-flex;margin-bottom:1rem">→ رجوع للوحة</a>
    <div class="card" style="max-width:480px">
      <form method="post" action="/panel/password" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>كلمة المرور الحالية
          <div style="position:relative">
            <input type="password" name="oldpass" id="oldPass" required style="padding-left:2.6rem">
            <button type="button" onclick="togglePass('oldPass',this)" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer">👁️</button>
          </div>
        </label>
        <label>كلمة المرور الجديدة
          <div style="position:relative">
            <input type="password" name="newpass" id="newPass" required style="padding-left:2.6rem">
            <button type="button" onclick="togglePass('newPass',this)" style="position:absolute;left:.5rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer">👁️</button>
          </div>
        </label>
        <button type="submit" class="btn btn-primary">تغيير</button>
      </form>
    </div>
  </div>
</main>
<script>function togglePass(id,btn){const i=document.getElementById(id);const s=i.type==='password';i.type=s?'text':'password';btn.textContent=s?'🙈':'👁️'}</script>
</body>
</html>