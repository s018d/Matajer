<%
  const isNew = !product;
  const pid = product ? product.id : 0;
  const optsVal = product ? (product.options || '') : '';
  const addonsVal = product ? (product.addons || '') : '';
%>
<%- include('../partials/head', { title: (isNew ? 'منتج جديد' : 'تعديل: ' + product.name) + ' — متجري' }) %>
<style>.auth-back{display:inline-flex;align-items:center;gap:.35rem;color:#0ea5e9;font-size:.85rem;font-weight:700;text-decoration:none;padding:.4rem .7rem;border-radius:8px;background:#eff6ff;border:1px solid #bfdbfe;transition:all .2s}.auth-back:hover{background:#dbeafe;transform:translateX(2px)}</style>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'products', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: isNew ? 'منتج جديد' : 'تعديل المنتج' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <a href="/panel/products" class="auth-back" style="margin-bottom:1rem">→ رجوع للمنتجات</a>
    <div class="two-col">
      <div class="card">
        <form method="post" action="<%= isNew ? '/panel/products' : '/panel/products/' + pid %>" class="stack" <%= isNew ? 'enctype="multipart/form-data"' : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>اسم المنتج *
            <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
          </label>
          <label>القسم
            <select name="category_id">
              <option value="">بدون قسم</option>
              <% cats.forEach(c => { %>
                <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </label>
          <div class="grid-2">
            <label>السعر (د.ع) *
              <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>
            </label>
            <label>السعر قبل التخفيض (اختياري)
              <input type="number" step="0.01" name="old_price" value="<%= product && product.old_price != null ? product.old_price : '' %>">
            </label>
          </div>
          <label>الكمية بالمخزون (اتركها فارغة = بلا حدود — تنقص تلقائياً مع كل طلب)
            <input type="number" name="stock" min="0" value="<%= product && product.stock != null ? product.stock : '' %>" placeholder="مثال: 50">
          </label>
          <details class="adv-box" <%= !product || (product.options || product.addons) ? 'open' : '' %>>
            <summary>خيارات وإضافات متقدمة (اختياري)</summary>
            <!-- خيارات المنتج: واجهة بسيطة بدون JSON -->
            <div style="margin-bottom:1rem">
              <label style="font-weight:700;font-size:.88rem;display:flex;align-items:center;justify-content:space-between">خيارات المنتج <button type="button" class="btn btn-sm btn-ghost" onclick="addOptRow()">+ خيار</button></label>
              <small class="muted">مثال: المقاس → XL , L , M — يظهر للزبون قائمة اختيار</small>
              <div id="optsWrap" style="display:flex;flex-direction:column;gap:.5rem;margin-top:.5rem"></div>
              <textarea name="options" id="optsJson" hidden><%- optsVal %></textarea>
            </div>
            <div>
              <label style="font-weight:700;font-size:.88rem;display:flex;align-items:center;justify-content:space-between">إضافات بسعر <button type="button" class="btn btn-sm btn-ghost" onclick="addAddonRow()">+ إضافة</button></label>
              <small class="muted">مثال: تغليف هدية +2000 د.ع</small>
              <div id="addonsWrap" style="display:flex;flex-direction:column;gap:.5rem;margin-top:.5rem"></div>
              <textarea name="addons" id="addonsJson" hidden><%- addonsVal %></textarea>
            </div>
          </details>
          <script>
          (function(){
            const optsWrap=document.getElementById('optsWrap');
            const addonsWrap=document.getElementById('addonsWrap');
            const optsJson=document.getElementById('optsJson');
            const addonsJson=document.getElementById('addonsJson');
            function rowOpt(k,v){
              const d=document.createElement('div');d.style.cssText='display:flex;gap:.4rem;align-items:center';
              d.innerHTML='<input placeholder="الاسم: المقاس" value="'+esc(k)+'" style="flex:1;padding:.45rem .6rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.85rem" oninput="syncOpts()">'
                        +'<input placeholder="القيم: XL,L,M" value="'+esc(v)+'" style="flex:1.4;padding:.45rem .6rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.85rem" oninput="syncOpts()">'
                        +'<button type="button" onclick="this.parentElement.remove();syncOpts()" style="background:#fee2e2;border:none;color:#991b1b;width:32px;height:32px;border-radius:8px;cursor:pointer">×</button>';
              return d;
            }
            function rowAddon(n,p){
              const d=document.createElement('div');d.style.cssText='display:flex;gap:.4rem;align-items:center';
              d.innerHTML='<input placeholder="الاسم: تغليف هدية" value="'+esc(n)+'" style="flex:1;padding:.45rem .6rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.85rem" oninput="syncAddons()">'
                        +'<input type="number" placeholder="السعر" value="'+esc(p)+'" style="width:120px;padding:.45rem .6rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.85rem" oninput="syncAddons()">'
                        +'<button type="button" onclick="this.parentElement.remove();syncAddons()" style="background:#fee2e2;border:none;color:#991b1b;width:32px;height:32px;border-radius:8px;cursor:pointer">×</button>';
              return d;
            }
            function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;')}
            window.addOptRow=function(k,v){optsWrap.appendChild(rowOpt(k||'',v||''));syncOpts()}
            window.addAddonRow=function(n,p){addonsWrap.appendChild(rowAddon(n||'',p||''));syncAddons()}
            window.syncOpts=function(){
              const o={};
              optsWrap.querySelectorAll('div').forEach(r=>{
                const inp=r.querySelectorAll('input');
                const k=inp[0].value.trim(), v=inp[1].value.trim();
                if(k&&v) o[k]=v;
              });
              optsJson.value=Object.keys(o).length?JSON.stringify(o):'';
            }
            window.syncAddons=function(){
              const a=[];
              addonsWrap.querySelectorAll('div').forEach(r=>{
                const inp=r.querySelectorAll('input');
                const n=inp[0].value.trim(), pr=Number(inp[1].value);
                if(n && !isNaN(pr)) a.push({name:n,price:pr});
              });
              addonsJson.value=a.length?JSON.stringify(a):'';
            }
            // تحميل القيم القديمة
            try{
              const o=JSON.parse(optsJson.value||'{}');
              Object.entries(o).forEach(([k,v])=> addOptRow(k,v));
            }catch(e){}
            try{
              const a=JSON.parse(addonsJson.value||'[]');
              if(Array.isArray(a)) a.forEach(x=> addAddonRow(x.name,x.price));
            }catch(e){}
            // مزامنة قبل الإرسال
            const form=document.querySelector('form.stack');
            if(form) form.addEventListener('submit',()=>{syncOpts();syncAddons()});
          })();
          </script>
          <% if (isNew) { %>
          <label>صور المنتج (اختياري — يمكنك الرفع الآن أو لاحقاً)
            <input type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="padding:.5rem;border:1.5px dashed #cbd5e1;border-radius:10px;background:#f8fafc">
            <small class="muted">حتى 20 صورة — JPG/PNG/WEBP حتى 12MB</small>
          </label>
          <% } %>
          <label>الوصف
            <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>
          </label>
          <label class="check-row">
            <input type="checkbox" name="active" <%= !product || product.active ? 'checked' : '' %>>
            <span>المنتج ظاهر للزوار</span>
          </label>
          <button type="submit" class="btn btn-primary"><%= isNew ? 'حفظ المنتج' : 'حفظ التعديلات' %></button>
        </form>
      </div>

      <div class="card">
        <% if (isNew) { %>
          <h2>الصور</h2>
          <p>احفظ المنتج أولاً ثم ارفع صوره هنا.</p>
        <% } else { %>
          <h2>صور المنتج (<%= images.length %>)</h2>
          <div class="img-grid">
            <% images.forEach(im => { %>
              <div class="img-cell">
                <img src="<%= im.path %>" alt="">
                <% if (im.variant) { %><span class="badge" style="position:absolute;top:6px;right:6px;background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#fff;font-size:.7rem;padding:.15rem .4rem;border-radius:99px"><%= im.variant %></span><% } %>
                <div class="img-cell-actions">
                  <% if (im.position !== 0) { %>
                    <form method="post" action="/panel/products/<%= pid %>/images/<%= im.id %>/setmain">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-sm" title="اجعلها الرئيسية">الأساسية</button>
                    </form>
                  <% } else { %>
                    <span class="badge badge-ok">الصورة الرئيسية</span>
                  <% } %>
                  <form method="post" action="/panel/products/<%= pid %>/images/<%= im.id %>/delete" onsubmit="return confirm('حذف الصورة؟')">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn btn-sm btn-danger">حذف</button>
                  </form>
                </div>
                <!-- تغيير لون الصورة -->
                <form method="post" action="/panel/products/<%= pid %>/images/<%= im.id %>/variant" style="margin-top:.35rem;display:flex;gap:.3rem">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <input type="text" name="variant" value="<%= im.variant || '' %>" placeholder="اللون: أحمر" style="flex:1;padding:.3rem .5rem;border:1px solid #e2e8f0;border-radius:6px;font-size:.78rem">
                  <button class="btn btn-sm btn-ghost" style="padding:.2rem .5rem;font-size:.75rem">حفظ</button>
                </form>
              </div>
            <% }) %>
          </div>
          <% if (images.length === 0) { %>
            <div class="img-grid"><div class="img-cell empty"><span>لا صور بعد — ارفع صوراً أدناه</span></div></div>
          <% } %>
          <form method="post" action="/panel/products/<%= pid %>/images?_csrf=<%= csrf %>" enctype="multipart/form-data" class="stack upload-box">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <h3>إضافة صور (حتى 20 دفعة)</h3>
            <label style="font-size:.82rem">اللون لهذه الصور (اختياري — اتركه فارغ للصور العامة)
              <input type="text" name="variant" placeholder="مثال: أحمر — إذا اختار الزبون أحمر تظهر هذه الصور فقط" style="padding:.4rem .6rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.85rem;margin-top:.3rem">
            </label>
            <input type="file" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="margin-top:.5rem">
            <button type="submit" class="btn btn-primary">رفع الصور</button>
            <small>JPG / PNG / GIF / WEBP — حتى 12MB. إذا حددت لوناً، الصورة تظهر فقط عند اختيار الزبون لذلك اللون.</small>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</main>
</body>
</html>