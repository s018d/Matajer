<%- include('../partials/head', { title: 'المنتجات — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'products', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'المنتجات' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card-head-row">
      <h2>منتجاتي (<%= rows.length %>)</h2>
      <a class="btn btn-primary" href="/panel/products/new">+ منتج جديد</a>
    </div>
    <form class="search-form" method="get" style="margin-bottom:1rem">
      <input type="search" name="q" placeholder="ابحث بالاسم أو الوصف…" value="<%= typeof searchQ !== 'undefined' ? searchQ : '' %>">
      <button class="btn btn-sm" type="submit">🔍 بحث</button>
      <% if (searchQ) { %><a class="btn btn-sm btn-ghost" href="/panel/products">إلغاء</a><% } %>
    </form>
    <% if (rows.length === 0) { %>
      <div class="empty-state" style="text-align:center;padding:3rem 1.5rem;background:linear-gradient(135deg,#f8fafc,#eff6ff);border:1.5px dashed #bfdbfe;border-radius:16px;margin-top:1rem">
        <div style="font-size:3rem;margin-bottom:.8rem">📦</div>
        <h3 style="margin:0 0 .4rem;color:#0f172a">لا منتجات بعد</h3>
        <p class="muted" style="margin-bottom:1.2rem">ابدأ بإضافة أول منتج لمتجرك وسيظهر هنا فوراً</p>
        <a class="btn btn-primary" href="/panel/products/new" style="padding:.75rem 1.8rem;font-size:1rem;border-radius:12px">+ أضف أول منتج</a>
      </div>
    <% } else { %>
    <div class="table-wrap"><table class="table">
      <tr><th>الصورة</th><th>المنتج</th><th>القسم</th><th>السعر</th><th>المخزون</th><th>المشاهدات</th><th>الحالة</th><th>إجراءات</th></tr>
      <% rows.forEach(p => { %>
        <tr>
          <td>
            <% if (p.img) { %><img src="<%= p.img %>" class="thumb" alt="" loading="lazy"><% } else { %><span class="thumb thumb-empty">—</span><% } %>
          </td>
          <td><a href="/panel/products/<%= p.id %>/edit"><b><%= p.name %></b></a><% if(p.stock!=null && p.stock<=5 && p.stock>0){ %><br><span class="badge badge-warn" style="font-size:.65rem">⚡ <%= p.stock %> متبقي</span><% } else if(p.stock===0){ %><br><span class="badge badge-err" style="font-size:.65rem">نفد</span><% } %></td>
          <td><small class="muted"><%= p.cat || '—' %></small></td>
          <td><b><%= money(p.price) %></b><% if (p.old_price) { %><br><del style="font-size:.75rem" class="muted"><%= money(p.old_price) %></del><% } %></td>
          <td>
            <% if(p.stock==null){ %><span class="muted">∞</span>
            <% } else if(p.stock===0){ %><span class="badge badge-err"><%= p.stock %></span>
            <% } else if(p.stock<=5){ %><span class="badge badge-warn"><%= p.stock %></span>
            <% } else { %><span class="badge badge-ok"><%= p.stock %></span><% } %>
          </td>
          <td><%= p.views %></td>
          <td><span class="badge <%= p.active ? 'badge-ok' : 'badge-warn' %>"><%= p.active ? 'ظاهر' : 'مخفي' %></span></td>
          <td class="row-actions">
            <a class="btn btn-sm" href="/panel/products/<%= p.id %>/edit">تعديل</a>
            <form method="post" action="/panel/products/<%= p.id %>/toggle" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-ghost"><%= p.active ? 'إخفاء' : 'إظهار' %></button>
            </form>
            <form method="post" action="/panel/products/<%= p.id %>/delete" class="inline" onsubmit="return confirm('حذف المنتج نهائياً؟')">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-danger">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>
</main>
</body>
</html>