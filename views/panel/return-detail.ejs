<%- include('../partials/head', { title: 'تفاصيل الإرجاع/الاستبدال — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'orders', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'تفاصيل الإرجاع/الاستبدال #' + ret.id }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem">
      <h2><%= ret.type === 'return' ? 'طلب إرجاع' : 'طلب استبدال' %> #<%= ret.id %></h3>
      <a class="btn btn-ghost" href="/panel/returns">← رجوع</a>
    </div>
    
    <div class="two-col" style="margin-top:1rem">
      <div class="card">
        <h3>معلومات الطلب</h3>
        <table class="info-table" style="width:100%">
          <tr><th>رقم الطلب</th><td><a href="/panel/orders/<%= ret.order_id %>/edit">#<%= ret.order_id %></a></td></tr>
          <tr><th>المنتج</th><td><%= ret.product_name %></td></tr>
          <tr><th>النوع</th><td><span class="badge <%= ret.type === 'return' ? 'badge-warn' : 'badge-ok' %>"><%= ret.type === 'return' ? 'إرجاع' : 'استبدال' %></span></td></tr>
          <tr><th>السبب</th><td><%= ret.reason %><% if (ret.reason_details) { %><br><small class="muted"><%= ret.reason_details %></small><% } %></td></tr>
          <tr><th>الحالة</th><td><span class="badge <%= ret.status==='completed'?'badge-ok':(ret.status==='rejected'?'badge-err':(ret.status==='approved'?'badge-ok':(ret.status==='rejected_by_customer'?'badge-err':''))) %>"><%= 
            ret.status==='requested'?'مطلوب':
            ret.status==='approved'?'مقبول':
            ret.status==='rejected'?'مرفوض':
            ret.status==='pickup_scheduled'?'جدولة الاستلام':
            ret.status==='picked_up'?'تم الاستلام':
            ret.status==='received'?'تم الاستلام (مستودع)':
            ret.status==='inspected'?'تم الفحص':
            ret.status==='refunded'?'تم الاسترداد':
            ret.status==='exchanged'?'تم الاستبدال':
            ret.status==='rejected_by_customer'?'مرفوض من الزبون':
            ret.status==='completed'?'مكتمل':
            ret.status==='cancelled'?'ملغي':ret.status %></span></td></tr>
          <tr><th>المبلغ المسترد</th><td dir="ltr"><%= ret.refund_amount ? money(ret.refund_amount) : '—' %></td></tr>
          <tr><th>طريقة الاسترداد</th><td><%= ret.refund_method || '—' %></td></tr>
          <tr><th>تاريخ الإنشاء</th><td><%= ret.created_at %></td></tr>
        </table>
      </div>
      
      <div class="card">
        <h3>الزبون</h3>
        <table class="info-table" style="width:100%">
          <tr><th>الاسم</th><td><%= ret.customer_name %></td></tr>
          <tr><th>الهاتف</th><td dir="ltr"><%= ret.customer_phone %></td></tr>
          <tr><th>عنوان الاستلام</th><td><%= ret.pickup_address || '—' %></td></tr>
        </table>
      </div>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>منتجات الطلب</h3>
      <table>
        <tr><th>المنتج</th><th>الكمية</th><th>السعر</th><th>المجموع</th></tr>
        <% orderItems.forEach(item => { %>
          <tr>
            <td><%= item.product_name %></td>
            <td dir="ltr"><%= item.qty %></td>
            <td dir="ltr"><%= money(item.product_price) %></td>
            <td dir="ltr"><%= money(item.product_price * item.qty + (item.addons_price || 0) * item.qty) %></td>
          </tr>
        <% }) %>
      </table>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>تفاصيل السبب</h3>
      <p style="white-space:pre-wrap; color:var(--ink)"><%= ret.reason_details || 'لا توجد تفاصيل إضافية' %></p>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>تحديث الحالة</h3>
      <form method="post" action="/panel/returns/<%= ret.id %>/update-status" class="stack" style="max-width:500px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label>الحالة الجديدة
          <select name="status" required>
            <option value="requested" <%= ret.status==='requested'?'selected':'' %>>مطلوب</option>
            <option value="approved" <%= ret.status==='approved'?'selected':'' %>>مقبول</option>
            <option value="rejected" <%= ret.status==='rejected'?'selected':'' %>>مرفوض</option>
            <option value="pickup_scheduled" <%= ret.status==='pickup_scheduled'?'selected':'' %>>جدولة الاستلام</option>
            <option value="picked_up" <%= ret.status==='picked_up'?'selected':'' %>>تم الاستلام</option>
            <option value="received" <%= ret.status==='received'?'selected':'' %>>تم الاستلام (مستودع)</option>
            <option value="inspected" <%= ret.status==='inspected'?'selected':'' %>>تم الفحص</option>
            <option value="refunded" <%= ret.status==='refunded'?'selected':'' %>>تم الاسترداد</option>
            <option value="exchanged" <%= ret.status==='exchanged'?'selected':'' %>>تم الاستبدال</option>
            <option value="rejected_by_customer" <%= ret.status==='rejected_by_customer'?'selected':'' %>>مرفوض من الزبون</option>
            <option value="completed" <%= ret.status==='completed'?'selected':'' %>>مكتمل</option>
            <option value="cancelled" <%= ret.status==='cancelled'?'selected':'' %>>ملغي</option>
          </select>
        </label>
        <label>المبلغ المسترد (د.ع)
          <input type="number" name="refund_amount" value="<%= ret.refund_amount || '' %>" min="0" dir="ltr">
        </label>
        <label>طريقة الاسترداد
          <select name="refund_method">
            <option value="original" <%= ret.refund_method==='original'?'selected':'' %>>الأصلية</option>
            <option value="wallet" <%= ret.refund_method==='wallet'?'selected':'' %>>المحفظة</option>
            <option value="bank_transfer" <%= ret.refund_method==='bank_transfer'?'selected':'' %>>تحويل بنكي</option>
            <option value="points" <%= ret.refund_method==='points'?'selected':'' %>>نقاط ولاء</option>
          </select>
        </label>
        <label>ملاحظات (داخلية)
          <textarea name="notes" rows="3" placeholder="ملاحظات داخلية للفريق..."></textarea>
        </label>
        <button type="submit" class="btn btn-primary">تحديث الحالة</button>
      </form>
    </div>
  </div>
</main>
<script src="/js/notify.js"></script>
</body>
</html>