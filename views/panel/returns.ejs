<%- include('../partials/head', { title: 'المرتجعات والاستبدال — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'orders', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'المرتجعات والاستبدال' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="filter-row" style="flex-wrap:wrap; gap:.5rem; align-items:center">
      <% [['all','الكل'],['requested','مطلوب'],['approved','مقبول'],['rejected','مرفوض'],['pickup_scheduled','جدولة الاستلام'],['picked_up','تم الاستلام'],['received','تم الاستلام (مستودع)'],['inspected','تم الفحص'],['refunded','تم الاسترداد'],['exchanged','تم الاستبدال'],['completed','مكتمل'],['cancelled','ملغي']].forEach(f => { %>
        <a class="btn btn-sm <%= filter === f[0] ? 'btn-primary' : 'btn-ghost' %>" href="/panel/returns?status=<%= f[0] %>"><%= f[1] %></a>
      <% }) %>
      <form class="search-form" method="get" style="margin-left:auto">
        <input type="hidden" name="status" value="<%= filter %>">
        <input type="search" name="q" placeholder="ابحث بالاسم/الهاتف/رقم الطلب…" value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button class="btn btn-sm" type="submit">🔍</button>
        <% if (q) { %><a class="btn btn-sm btn-ghost" href="/panel/returns?status=<%= filter %>">إلغاء</a><% } %>
      </form>
    </div>
    <table>
      <tr><th>النوع</th><th>الطلب</th><th>المنتج</th><th>الزبون</th><th>السبب</th><th>الحالة</th><th>المبلغ</th><th>التاريخ</th><th>إجراء</th></tr>
      <% returns.forEach(r => { %>
        <tr>
          <td><span class="badge <%= r.type === 'return' ? 'badge-warn' : 'badge-ok' %>"><%= r.type === 'return' ? 'إرجاع' : 'استبدال' %></span></td>
          <td><a href="/panel/orders/<%= r.order_id %>/edit">#<%= r.order_id %></a></td>
          <td><%= r.product_name %></td>
          <td><%= r.customer_name %> <br><small dir="ltr"><%= r.customer_phone %></small></td>
          <td><%= r.reason %> <% if (r.reason_details) { %><br><small class="muted"><%= r.reason_details %></small><% } %></td>
          <td><span class="badge <%= r.status==='completed'?'badge-ok':(r.status==='rejected'?'badge-err':(r.status==='approved'?'badge-ok':(r.status==='rejected_by_customer'?'badge-err':''))) %>"><%= 
            r.status==='requested'?'مطلوب':
            r.status==='approved'?'مقبول':
            r.status==='rejected'?'مرفوض':
            r.status==='pickup_scheduled'?'جدولة الاستلام':
            r.status==='picked_up'?'تم الاستلام':
            r.status==='received'?'تم الاستلام (مستودع)':
            r.status==='inspected'?'تم الفحص':
            r.status==='refunded'?'تم الاسترداد':
            r.status==='exchanged'?'تم الاستبدال':
            r.status==='rejected_by_customer'?'مرفوض من الزبون':
            r.status==='completed'?'مكتمل':
            r.status==='cancelled'?'ملغي':r.status %></span></td>
          <td dir="ltr"><%= r.refund_amount ? money(r.refund_amount) : '—' %></td>
          <td><%= r.created_at.slice(0,16) %></td>
          <td><a class="btn btn-sm" href="/panel/returns/<%= r.id %>">تفاصيل</a></td>
        </tr>
      <% }) %>
    </table>
    <% if (returns.length === 0) { %><p class="empty-note">لا توجد طلبات إرجاع/استبدال</p><% } %>
    <% if (totalPages > 1) { %>
      <div class="pager">
        <% const qParam = q ? '&q=' + encodeURIComponent(q) : ''; %>
        <% if (page > 1) { %><a class="btn btn-sm btn-ghost" href="/panel/returns?status=<%= filter %><%= qParam %>&page=<%= page - 1 %>">→ السابق</a><% } %>
        <span class="muted">صفحة <%= page %> من <%= totalPages %> (<%= total %> طلب)</span>
        <% if (page < totalPages) { %><a class="btn btn-sm btn-ghost" href="/panel/returns?status=<%= filter %><%= qParam %>&page=<%= page + 1 %>">التالي ←</a><% } %>
      </div>
    <% } %>
  </div>
</main>
<script src="/js/notify.js"></script>
</body>
</html>