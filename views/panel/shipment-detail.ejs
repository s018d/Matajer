<%- include('../partials/head', { title: 'تفاصيل الشحنة — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'shipping', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'تفاصيل الشحنة #' + shipment.id }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem">
      <h2>تفاصيل الشحنة #<%= shipment.id %></h2>
      <div style="display:flex; gap:.5rem; flex-wrap:wrap">
        <% /* معطّل مؤقتاً حتى تجهيز PDF حقيقي — H5 */ %>
        <% if (false) { %><a class="btn btn-sm btn-ghost" href="/panel/shipments/<%= shipment.id %>/label" target="_blank">📄 طباعة البوليصة</a><% } %>
        <a class="btn btn-sm" href="/panel/shipments">← رجوع للشحنات</a>
      </div>
    </div>
    
    <div class="two-col" style="margin-top:1rem">
      <div class="card">
        <h3>معلومات الشحنة</h3>
        <table class="info-table" style="width:100%">
          <tr><th>رقم التتبع</th><td dir="ltr"><%= shipment.tracking_number || '—' %></td></tr>
          <tr><th>رقم الطلب في شركة التوصيل</th><td dir="ltr"><%= shipment.shipping_company_order_id || '—' %></td></tr>
          <tr><th>الشركة</th><td><%= shipment.company_name %></td></tr>
          <tr><th>الحالة</th><td><span class="badge <%= shipment.status==='delivered'?'badge-ok':(shipment.status==='failed'?'badge-err':(shipment.status==='returned'?'badge-warn':'')) %>"><%= 
            shipment.status==='pending'?'قيد الانتظار':
            shipment.status==='pickup_scheduled'?'تم جدولة الاستلام':
            shipment.status==='picked_up'?'تم الاستلام':
            shipment.status==='in_transit'?'في الطريق':
            shipment.status==='out_for_delivery'?'للترسل':
            shipment.status==='delivered'?'تم التسليم':
            shipment.status==='failed'?'فشل التسليم':
            shipment.status==='returned'?'مرتجع':
            shipment.status==='cancelled'?'ملغي':shipment.status %></span></td></tr>
          <tr><th>الدفع عند الاستلام</th><td dir="ltr"><%= money(shipment.cod_amount) %></td></tr>
          <tr><th>رسوم الشحن</th><td dir="ltr"><%= money(shipment.shipping_fee) %></td></tr>
          <tr><th>الوزن</th><td><%= shipment.weight || '—' %> كجم</td></tr>
          <tr><th>الأبعاد</th><td><%= shipment.dimensions ? JSON.parse(shipment.dimensions).length + 'x' + JSON.parse(shipment.dimensions).width + 'x' + JSON.parse(shipment.dimensions).height + ' سم' : '—' %></td></tr>
          <tr><th>ميعاد الاستلام المجدول</th><td><%= shipment.pickup_scheduled_at || '—' %></td></tr>
          <tr><th>تاريخ الاستلام الفعلي</th><td><%= shipment.picked_up_at || '—' %></td></tr>
          <tr><th>تاريخ التسليم</th><td><%= shipment.delivered_at || '—' %></td></tr>
        </table>
      </div>
      
      <div class="card">
        <h3>الزبون والعنوان</h3>
        <table class="info-table" style="width:100%">
          <tr><th>اسم الزبون</th><td><%= shipment.customer_name %></td></tr>
          <tr><th>الهاتف</th><td dir="ltr"><%= shipment.customer_phone %></td></tr>
          <tr><th>عنوان الاستلام</th><td><%= shipment.pickup_address || '—' %></td></tr>
          <tr><th>عنوان التسليم</th><td><%= shipment.delivery_address %></td></tr>
          <tr><th>ملاحظات</th><td><%= shipment.notes || '—' %></td></tr>
        </table>
      </div>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>الطلب المرتبط #<%= shipment.order_id %></h3>
      <table>
        <tr><th>المنتج</th><th>الكمية</th><th>السعر</th><th>المجموع</th></tr>
        <% orderItems.forEach(item => { %>
          <tr>
            <td><%= item.product_name %></td>
            <td dir="ltr"><%= item.qty %></td>
            <td dir="ltr"><%= money(item.product_price) %></td>
            <td dir="ltr"><%= money(item.product_price * item.qty + (item.addons_price || 0) * item.qty) %></td>
          </tr>
        <% }) %>
      </table>
      <a class="btn btn-primary" href="/panel/orders/<%= shipment.order_id %>/edit" style="margin-top:1rem; display:inline-block">عرض الطلب كاملاً</a>
    </div>
    </div>
    
    <div class="card" style="margin-top:1rem">
      <h3>سجل التتبع</h3>
      <% if (tracking.length === 0) { %>
        <p class="muted">لا توجد حركات تتبع بعد</p>
      <% } else { %>
        <div style="display:flex; flex-direction:column; gap:.8rem">
          <% tracking.forEach(t => { %>
            <div style="display:flex; gap:1rem; padding:1rem; background:var(--soft); border-radius:10px; position:relative">
              <div style="width:12px; height:12px; border-radius:50%; background:<%= t.status==='delivered'?'#16a34a':(t.status==='failed'?'#dc2626':(t.status==='picked_up'?'#0ea5e9':'#f59e0b')) %>; margin-top:4px; flex-shrink:0"></div>
              <div style="flex:1">
                <div style="display:flex; justify-content:space-between; margin-bottom:.3rem">
                  <span class="badge <%= t.status==='delivered'?'badge-ok':(t.status==='failed'?'badge-err':(t.status==='picked_up'?'badge-ok':'badge-warn')) %>"><%= 
                    t.status==='pending'?'قيد الانتظار':
                    t.status==='pickup_scheduled'?'تم جدولة الاستلام':
                    t.status==='picked_up'?'تم الاستلام':
                    t.status==='in_transit'?'في الطريق':
                    t.status==='out_for_delivery'?'للترسل':
                    t.status==='delivered'?'تم التسليم':
                    t.status==='failed'?'فشل التسليم':
                    t.status==='returned'?'مرتجع':
                    t.status==='cancelled'?'ملغي':t.status %></span>
                  <span class="muted" dir="ltr" style="font-size:.75rem"><%= t.timestamp %></span>
                </div>
                <% if (t.location) { %><div class="muted" style="font-size:.8rem">📍 <%= t.location %></div><% } %>
                <% if (t.description) { %><div style="margin-top:.3rem; color:var(--ink); white-space:pre-wrap"><%= t.description %></div><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
      
      <form method="post" action="/panel/shipments/<%= shipment.id %>/update-status" class="stack" style="margin-top:1.5rem; max-width:500px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <h4 style="margin:0 0 .5rem">تحديث الحالة</h4>
        <label>الحالة الجديدة
          <select name="status" required>
            <option value="pickup_scheduled">تم جدولة الاستلام</option>
            <option value="picked_up">تم الاستلام</option>
            <option value="in_transit">في الطريق</option>
            <option value="out_for_delivery">للترسل</option>
            <option value="delivered">تم التسليم</option>
            <option value="failed">فشل التسليم</option>
            <option value="returned">مرتجع</option>
            <option value="cancelled">ملغي</option>
          </select>
        </label>
        <label>الموقع (اختياري)
          <input type="text" name="location" placeholder="مثال: بغداد - الكرادة، مخزن بارق">
        </label>
        <label>وصف التغيير (اختياري)
          <textarea name="description" rows="2" placeholder="مثال: تم تسليم الشحنة للزبون يدوياً"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">تحديث الحالة</button>
      </form>
    </div>
  </div>
</main>
<script src="/js/notify.js"></script>
</body>
</html>