<%- include('../partials/head', { title: 'إدارة التوصيل — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'shipping', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'إدارة التوصيل' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem">
      <h2>إدارة التوصيل</h2>
      <a class="btn btn-primary" href="/panel/shipping/companies">إدارة الشركات</a>
      <a class="btn btn-primary" href="/panel/shipments">جميع الشحنات</a>
    </div>

    <div class="two-col" style="margin-top:1rem">
      <div class="card">
        <h3>شركات التوصيل المفعلة (<%= companies.length %>)</h3>
        <% if (companies.length === 0) { %>
          <p class="muted">لا توجد شركات توصيل مفعلة. <a href="/panel/shipping/companies">أضف شركة توصيل</a></p>
        <% } else { %>
          <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:1rem; margin-top:1rem">
            <% companies.forEach(c => { %>
              <div class="card" style="padding:1rem; border:2px solid <%= c.is_enabled ? 'var(--primary)' : 'var(--line)' %>">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:.5rem">
                  <b><%= c.name %></b>
                  <span class="badge <%= c.is_enabled ? 'badge-ok' : 'badge-warn' %>"><%= c.is_enabled ? 'مفعل' : 'معطل' %></span>
                </div>
                <div class="muted" style="font-size:.8rem; margin-bottom:.5rem">
                  العمولة: <%= money(c.cod_fee || 0) %> | شحن مجاني من <%= money(c.free_shipping_min || 0) %>
                </div>
                <a class="btn btn-sm btn-ghost" href="/panel/shipping/companies" style="width:100%">إعدادات</a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
      
      <div class="card">
        <h3>أحدث الشحنات (<%= shipments.length %>)</h3>
        <% if (shipments.length === 0) { %>
          <p class="muted">لا توجد شحنات بعد</p>
        <% } else { %>
          <div style="max-height:400px; overflow-y:auto">
            <table style="width:100%; font-size:.85rem">
              <tr><th>الطلب</th><th>الشركة</th><th>الحالة</th><th>الزبون</th><th>التاريخ</th><th>إجراء</th></tr>
              <% shipments.forEach(s => { 
                const statusBadge = s.status==='delivered'?'badge-ok':(s.status==='failed'?'badge-err':(s.status==='returned'?'badge-warn':''));
                const statusText = s.status==='pending'?'قيد الانتظار':
                    s.status==='pickup_scheduled'?'تم جدولة الاستلام':
                    s.status==='picked_up'?'تم الاستلام':
                    s.status==='in_transit'?'في الطريق':
                    s.status==='out_for_delivery'?'للترسل':
                    s.status==='delivered'?'تم التسليم':
                    s.status==='failed'?'فشل التسليم':
                    s.status==='returned'?'مرتجع':
                    s.status==='cancelled'?'ملغي':s.status; 
              %>
                <tr>
                  <td><a href="/panel/shipments/<%= s.id %>">#<%= s.order_id %></a></td>
                  <td><%= s.company_name %></td>
                  <td><span class="badge <%= statusBadge %>"><%= statusText %></span></td>
                  <td><%= s.customer_name %></td>
                  <td><%= s.created_at.slice(0,16) %></td>
                  <td><a class="btn btn-sm btn-ghost" href="/panel/shipments/<%= s.id %>">تفاصيل</a></td>
                </tr>
              <% }) %>
            </table>
          </div>
          <a class="btn btn-sm btn-ghost" href="/panel/shipments" style="margin-top:1rem; display:inline-block">عرض جميع الشحنات</a>
        <% } %>
      </div>
    </div>
  </div>
</main>
<script src="/js/notify.js"></script>
</body>
</html>