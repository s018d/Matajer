<%- include('../partials/head', { title: 'إدارة التوصيل — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'shipping', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'إدارة التوصيل' }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    
    <!-- رسوم التوصيل اليدوية (تعمل الآن) -->
    <div class="card">
      <h2>🚚 رسوم التوصيل — تعمل الآن</h2>
      <p class="muted" style="margin-bottom:1rem">حدد رسوم التوصيل وتوصيل مجاني فوق مبلغ معين — الزبون يراها بوضوح عند الطلب. التعديل من <a href="/panel/settings">⚙️ إعدادات المتجر</a>.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem">
        <div class="stat"><span>رسوم التوصيل الحالية</span><b><%= money(store.delivery_fee || 0) %></b></div>
        <div class="stat"><span>توصيل مجاني من</span><b><%= store.free_delivery_min ? money(store.free_delivery_min) : 'معطل' %></b></div>
      </div>
    </div>

    <!-- شركات الشحن API - قادم قريباً -->
    <div class="card" style="border:2px dashed var(--line);background:linear-gradient(135deg,var(--soft),var(--card))">
      <div style="display:flex;align-items:center;gap:.8rem;flex-wrap:wrap">
        <span style="font-size:2rem">🔒</span>
        <div style="flex:1;min-width:220px">
          <h2 style="margin:0">تكامل شركات الشحن (برق، صقر، DHL...) — قادم قريباً 🚀</h2>
          <p class="muted" style="margin:.4rem 0 0">ربط مباشر مع شركات التوصيل: إنشاء شحنة تلقائي + تتبع لحظي + بوليصة PDF. الميزة تحت التطوير وستنزل كتحديث مجاني خلال الأيام القادمة لكل المشتركين.</p>
        </div>
        <span class="badge badge-warn" style="font-size:.85rem;padding:.5rem 1rem">قيد التطوير</span>
      </div>
      <details style="margin-top:.8rem">
        <summary style="cursor:pointer;color:var(--brand);font-weight:700">شو راح تقدر تسوي لما تنزل؟</summary>
        <ul style="margin:.6rem 0 0;padding-inline-start:1.3rem;color:var(--muted);line-height:1.9;font-size:.88rem">
          <li>تفعيل الشركات التي تستخدمها وإضافة API Keys لكل شركة بأمان</li>
          <li>إنشاء شحنة بضغطة من صفحة الطلب — بدون إدخال يدوي</li>
          <li>تتبع حالة الشحنة لحظياً (استلم → بالطريق → وصل)</li>
          <li>طباعة بوليصة الشحن تلقائياً</li>
          <li>حساب COD والمندوبين تلقائياً</li>
        </ul>
      </details>
    </div>

    <!-- سجل الشحنات القديمة (إذا موجودة) -->
    <% if (shipments && shipments.length > 0) { %>
      <div class="card">
        <h3>الشحنات السابقة (<%= shipments.length %>)</h3>
        <div class="table-wrap">
          <table class="table">
            <tr><th>الطلب</th><th>الشركة</th><th>الحالة</th><th>الزبون</th></tr>
            <% shipments.slice(0,10).forEach(s => { %>
              <tr><td>#<%= s.order_id %></td><td><%= s.company_name %></td><td><%= s.status %></td><td><%= s.customer_name || '' %></td></tr>
            <% }) %>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</main>
</body>
</html>
