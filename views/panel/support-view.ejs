<%- include('../partials/head', { title: 'تذكرة #' + t.id + ' — الدعم' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'support', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: '🎫 تذكرة #' + t.id }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <a class="btn btn-sm btn-ghost" href="/panel/support">→ كل التذاكر</a>
    <div class="card" style="margin-top:.8rem">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:.5rem;flex-wrap:wrap">
        <h2 style="margin:0"><%= t.subject %></h2>
        <span class="badge <%= t.status==='open' ? 'badge-warn' : t.status==='answered' ? 'badge-ok' : '' %>"><%= t.status==='open' ? 'مفتوحة' : t.status==='answered' ? 'تم الرد' : 'مغلقة' %></span>
      </div>
      <small class="muted"><%= t.category %> • فُتحت <%= t.created_at %></small>
    </div>
    <div class="card">
      <% msgs.forEach(m => { %>
        <div style="border-inline-start:3px solid <%= m.sender_type==='admin' ? '#0ea5e9' : '#0D9488' %>;background:var(--soft);border-radius:10px;padding:.6rem .9rem;margin-bottom:.6rem">
          <small class="muted"><%= m.sender_type==='admin' ? '🛎️ فريق دُكّان' : '🧑‍💼 أنت' %> • <%= m.created_at %></small>
          <p style="margin:.25rem 0 0;white-space:pre-wrap"><%= m.message %></p>
        </div>
      <% }) %>
      <% if (t.status !== 'closed') { %>
        <form method="post" action="/panel/support/<%= t.id %>/reply" class="stack" style="margin-top:.8rem">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>ردك<textarea name="message" required maxlength="2000" rows="3" placeholder="اكتب ردك هنا"></textarea></label>
          <button class="btn btn-primary">إرسال الرد</button>
        </form>
      <% } else { %><p class="muted">التذكرة مغلقة — افتح تذكرة جديدة لأي موضوع آخر</p><% } %>
    </div>
  </div>
</main>
</body>
</html>
