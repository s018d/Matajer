<%- include('../partials/head', { title: 'محرر المتجر المرئي — اسحب ورتب' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'customize', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: '🎨 محرر المتجر — اسحب، أفلت، عدّل' }) %>
  <div class="content" style="max-width:1400px">
    <%- include('../partials/alerts', { ok: typeof ok !== 'undefined' ? ok : '', err: typeof err !== 'undefined' ? err : '' }) %>
    
    <div style="display:grid;grid-template-columns:380px 1fr;gap:1.2rem;align-items:start">
      <!-- لوحة التحكم -->
      <div class="card">
        <h2>🧩 أقسام متجرك — اسحب لإعادة الترتيب</h2>
        <p class="muted" style="font-size:.82rem;margin-bottom:.8rem">اسحب البطاقة وفلتها بالمكان اللي تريده. اضغط ⚙️ لتحرير تفاصيل القسم.</p>
        
        <div id="sectionsList" style="display:flex;flex-direction:column;gap:.5rem">
          <% sections.forEach(s => { %>
            <div class="sec-item card" draggable="true" data-sec="<%= s.key %>" 
                 style="padding:.8rem;cursor:grab;border:1.5px solid <%= s.visible ? 'var(--line)' : '#ef4444' %>;transition:all .2s;position:relative"
                 onmouseover="this.style.borderColor='var(--brand)'" onmouseout="this.style.borderColor='<%= s.visible ? 'var(--line)' : '#ef4444' %>'">
              <div class="sec-head" style="display:flex;align-items:center;gap:.6rem">
                <span style="font-size:1.1rem"><%= s.icon %></span>
                <div style="flex:1">
                  <b style="font-size:.92rem"><%= s.name %></b>
                  <div class="muted" style="font-size:.72rem"><%= s.desc %></div>
                </div>
                <button type="button" onclick="toggleSec('<%= s.key %>')" title="إظهار/إخفاء" 
                        style="border:none;background:none;cursor:pointer;font-size:1.1rem"><%= s.visible ? '👁️' : '🚫' %></button>
              </div>
              <!-- لوحة تحرير القسم -->
              <div id="edit-<%= s.key %>" style="display:none;margin-top:.7rem;padding-top:.7rem;border-top:1px dashed var(--line)">
                <% if (s.key === 'hero') { %>
                  <label style="font-size:.8rem">عنوان الهيرو
                    <input type="text" name="heroTitle" value="<%= (layout.hero||{}).title || store.name %>" onchange="markDirty()" style="padding:.4rem .6rem;font-size:.85rem">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">نص فرعي
                    <input type="text" name="heroSub" value="<%= (layout.hero||{}).sub || '' %>" placeholder="جملة قصيرة تجذب الزبون" onchange="markDirty()" style="padding:.4rem .6rem;font-size:.85rem">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">صورة خلفية الهيرو
                    <input type="file" accept="image/*" onchange="previewHeroImg(this)" style="font-size:.78rem;padding:.3rem;width:100%">
                    <% if ((layout.hero||{}).image) { %><img src="<%= layout.hero.image %>" style="max-width:100%;height:60px;object-fit:cover;border-radius:6px;margin-top:.3rem" id="heroPreview"><% } else { %><div id="heroPreview"></div><% } %>
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">أو رابط فيديو خلفية (mp4)
                    <input type="url" name="heroVideo" value="<%= (layout.hero||{}).video || '' %>" dir="ltr" placeholder="https://.../video.mp4" onchange="markDirty()" style="padding:.4rem .6rem;font-size:.85rem">
                  </label>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin-top:.4rem">
                    <label style="font-size:.8rem">لون النص
                      <input type="color" name="heroText" value="<%= (layout.hero||{}).textColor || '#ffffff' %>" onchange="markDirty()" style="height:34px">
                    </label>
                    <label style="font-size:.8rem">طبقة تعتيم
                      <input type="range" name="heroOverlay" min="0" max="90" value="<%= (layout.hero||{}).overlay != null ? layout.hero.overlay : 40 %>" oninput="document.getElementById('ovVal').textContent=this.value+'%';markDirty()">
                      <span id="ovVal"><%= (layout.hero||{}).overlay != null ? layout.hero.overlay : 40 %>%</span>
                    </label>
                  </div>
                <% } else if (s.key === 'announce') { %>
                  <label style="font-size:.8rem">نص الإعلان
                    <input type="text" name="announce" value="<%= layout.announce || '' %>" placeholder="مثال: شحن مجاني للطلبات فوق 50,000 د.ع — استخدم الكود: FREE50" onchange="markDirty()" style="padding:.4rem .6rem;font-size:.85rem;width:100%">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">لون الخلفية
                    <input type="color" name="announceBg" value="<%= (layout.announceBg||'#fff3cd') %>" onchange="markDirty()" style="height:34px">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">لون النص
                    <input type="color" name="announceColor" value="<%= (layout.announceColor||'#856404') %>" onchange="markDirty()" style="height:34px">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">أيقونة
                    <input type="text" name="announceIcon" value="<%= (layout.announceIcon||'📢') %>" placeholder="📢 أو 🎁 أو 🔥" style="padding:.4rem .6rem;font-size:.85rem">
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">رابط (اختياري)
                    <input type="url" name="announceLink" value="<%= (layout.announceLink||'') %>" placeholder="https://..." dir="ltr" onchange="markDirty()" style="padding:.4rem .6rem;font-size:.85rem">
                  </label>
                <% } else if (s.key === 'grid') { %>
                  <label style="font-size:.8rem">عدد الأعمدة
                    <select name="gridCols" onchange="markDirty()" style="width:100%;padding:.4rem">
                      <option value="auto" <%= (layout.grid||{}).cols==='auto'||!(layout.grid||{}).cols?'selected':'' %>>تلقائي حسب الشاشة</option>
                      <option value="2" <%= (layout.grid||{}).cols===2?'selected':'' %>>عمودان (كبير)</option>
                      <option value="3" <%= (layout.grid||{}).cols===3?'selected':'' %>>ثلاثة أعمدة</option>
                      <option value="4" <%= (layout.grid||{}).cols===4?'selected':'' %>>أربعة (كثيف)</option>
                    </select>
                  </label>
                  <label style="font-size:.8rem;margin-top:.4rem">المسافة بين البطاقات
                    <input type="range" name="gridGap" min="4" max="32" value="<%= (layout.grid||{}).gap || 16 %>" oninput="markDirty()">
                  </label>
                <% } else { %>
                  <p class="muted" style="font-size:.8rem;margin:0">هذا القسم يتبع إعداداته العامة — ألوان وخطوط المتجر من الأسفل.</p>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        
        <div style="margin-top:1rem;display:flex;flex-direction:column;gap:.5rem">
          <button type="button" class="btn btn-primary btn-block" onclick="saveLayout()" id="saveBtn">💾 حفظ التصميم</button>
          <div style="display:flex;gap:.5rem">
            <button type="button" class="btn btn-ghost" style="flex:1" onclick="undo()" title="Ctrl+Z">↩️ تراجع</button>
            <button type="button" class="btn btn-ghost" style="flex:1" onclick="redo()" title="Ctrl+Y">↪️ إعادة</button>
          </div>
          <a href="/s/<%= store.slug %>" target="_blank" class="btn btn-ghost btn-block">👁️ فتح متجري الحقيقي</a>
          <button type="button" class="btn btn-ghost btn-block" onclick="resetLayout()">↩️ استعادة الافتراضي</button>
        </div>
      </div>
      
      <!-- المعاينة الحية -->
      <div class="card" style="position:sticky;top:80px">
        <h2>👁️ معاينة مباشرة <span class="badge badge-warn" id="dirtyBadge" hidden>تعديلات غير محفوظة</span></h2>
        <div style="display:flex;gap:.4rem;margin-bottom:.6rem;align-items:center">
          <button type="button" class="btn btn-sm" onclick="setW('100%')">🖥️ كامل</button>
          <button type="button" class="btn btn-sm" onclick="setW('768px')">📱 تابلت</button>
          <button type="button" class="btn btn-sm" onclick="setW('375px')">📲 جوال</button>
          <span style="flex:1"></span>
          <button type="button" class="btn btn-sm" onclick="refreshPreview()">🔄 تحديث</button>
        </div>
        <div style="display:flex;justify-content:center;background:#f0f2f7;border-radius:12px;padding:.8rem">
          <iframe id="pv" src="/s/<%= store.slug %>?live=1" style="width:100%;height:600px;border:none;border-radius:8px;background:#fff;transition:width .3s"></iframe>
        </div>
</div>
    </div>
 
    <!-- خلفية المتجر العامة -->
    <div class="card" style="margin-top:1.2rem">
      <h2>🖼️ خلفية المتجر العامة</h2>
      <p class="muted" style="margin-bottom:1rem">صورة أو فيديو يغطي المتجر بالكامل. يعمل مع جميع القوالب.</p>
      <form id="bgForm" enctype="multipart/form-data" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;align-items:end">
        <label style="font-size:.8rem">صورة خلفية
          <input type="file" name="store_bg_image" accept="image/*" onchange="previewStoreBg(this)" style="font-size:.78rem;padding:.3rem;width:100%">
        </label>
        <label style="font-size:.8rem">فيديو خلفية (mp4/webm)
          <input type="file" name="store_bg_video" accept="video/*" style="font-size:.78rem;padding:.3rem;width:100%">
        </label>
        <label style="font-size:.8rem">طبقة تعتيم
          <input type="range" name="bg_overlay" min="0" max="80" value="<%= (typeof store !== 'undefined' && store.bg_overlay != null ? store.bg_overlay : 0) %>" oninput="document.getElementById('bgOvVal').textContent=this.value+'%';markDirty()" style="width:100%">
          <span id="bgOvVal"><%= (typeof store !== 'undefined' && store.bg_overlay != null ? store.bg_overlay : 0) %>%</span>
        </label>
        <button type="button" class="btn btn-primary" onclick="uploadStoreBg()">💾 رفع وحفظ الخلفية</button>
      </form>
      <div id="bgPreview" style="margin-top:.8rem;max-height:120px;overflow:hidden;border-radius:8px;border:1px solid var(--line)">
        <% if (typeof store !== 'undefined' && store.store_bg_image) { %><img src="<%= store.store_bg_image %>" style="width:100%;height:auto;border-radius:6px"><% } else if (typeof store !== 'undefined' && store.store_bg_video) { %><video controls style="width:100%"><source src="<%= store.store_bg_video %>" type="video/mp4"></video><% } %>
      </div>
    </div>
 
    <!-- ألوان المتجر العامة -->
    <div class="card" style="margin-top:1.2rem">
      <h2>🎨 ألوان وخطوط المتجر (العامة)</h2>
      <form method="post" action="/panel/templates/customize" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:.8rem;align-items:end">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label style="font-size:.8rem">أساسي<input type="color" name="primary" value="<%= cfg.primary || store.color %>" style="height:38px"></label>
        <label style="font-size:.8rem">ثانوي<input type="color" name="accent" value="<%= cfg.accent || '#ec4899' %>" style="height:38px"></label>
        <label style="font-size:.8rem">خلفية<input type="color" name="bg" value="<%= cfg.bg || '#ffffff' %>" style="height:38px"></label>
        <label style="font-size:.8rem">نص<input type="color" name="ink" value="<%= cfg.ink || '#111111' %>" style="height:38px"></label>
        <label style="font-size:.8rem">ناعم<input type="color" name="soft" value="<%= cfg.soft || '#f1f3f5' %>" style="height:38px"></label>
        <label style="font-size:.8rem">أزرار<input type="color" name="btnColor" value="<%= cfg.btnColor || cfg.primary || store.color %>" style="height:38px"></label>
        <label style="font-size:.8rem">الخط
          <select name="font" style="padding:.45rem">
            <option value="Cairo" <%= cfg.font==='Cairo'?'selected':'' %>>Cairo</option>
            <option value="Noto Kufi Arabic" <%= cfg.font==='Noto Kufi Arabic'?'selected':'' %>>Kufi</option>
            <option value="Tajawal" <%= cfg.font==='Tajawal'?'selected':'' %>>Tajawal</option>
            <option value="Amiri" <%= cfg.font==='Amiri'?'selected':'' %>>Amiri</option>
            <option value="Changa" <%= cfg.font==='Changa'?'selected':'' %>>Changa</option>
            <option value="IBM Plex Sans Arabic" <%= cfg.font==='IBM Plex Sans Arabic'?'selected':'' %>>Plex</option>
            <option value="Almarai" <%= cfg.font==='Almarai'?'selected':'' %>>Almarai</option>
            <option value="Markazi Text" <%= cfg.font==='Markazi Text'?'selected':'' %>>Markazi</option>
          </select>
        </label>
        <label style="font-size:.8rem">حجم<input type="number" name="fontSize" min="13" max="18" value="<%= cfg.fontSize || 15 %>" style="padding:.45rem"></label>
        <label style="font-size:.8rem">استدارة
          <select name="radius" style="padding:.45rem">
            <option value="0" <%= cfg.radius==='0'?'selected':'' %>>حاد</option>
            <option value="8" <%= cfg.radius==='8'?'selected':'' %>>ناعم</option>
            <option value="14" <%= cfg.radius==='14'||!cfg.radius?'selected':'' %>>متوسط</option>
            <option value="22" <%= cfg.radius==='22'?'selected':'' %>>دائري</option>
          </select>
        </label>
        <label style="font-size:.8rem">شكل الأزرار
          <select name="btnStyle" style="padding:.45rem">
            <option value="pill" <%= cfg.btnStyle==='pill'||!cfg.btnStyle?'selected':'' %>>حبة</option>
            <option value="rounded" <%= cfg.btnStyle==='rounded'?'selected':'' %>>دائري</option>
            <option value="square" <%= cfg.btnStyle==='square'?'selected':'' %>>مربع</option>
          </select>
        </label>
        <button class="btn btn-primary">💾 حفظ الألوان</button>
      </form>
    </div>
  </div>
</main>

<style>
.sec-item.dragging{opacity:.5;transform:scale(.98)}
.sec-item.drag-over{border-color:var(--brand) !important;border-style:dashed !important;transform:translateY(-2px)}
</style>

<script>
const SECTIONS = <%- JSON.stringify(sections.map(s=>s.key)) %>;
let layout = <%- JSON.stringify(layout) %> || {};
let dirty = false;

function markDirty(){ dirty=true; document.getElementById('dirtyBadge').hidden=false; saveHistory(); }

// ===== سحب وإفلات =====
const list = document.getElementById('sectionsList');
let dragged = null;
list.querySelectorAll('.sec-item').forEach(el=>{
  el.addEventListener('dragstart', ()=>{ dragged=el; el.classList.add('dragging'); });
  el.addEventListener('dragend', ()=>{ el.classList.remove('dragging'); list.querySelectorAll('.sec-item').forEach(x=>x.classList.remove('drag-over')); });
  el.addEventListener('dragover', e=>{ e.preventDefault(); if(el!==dragged) el.classList.add('drag-over'); });
  el.addEventListener('dragleave', ()=> el.classList.remove('drag-over'));
  el.addEventListener('drop', e=>{
    e.preventDefault();
    if (!dragged || dragged===el) return;
    const rect = el.getBoundingClientRect();
    const after = (e.clientY - rect.top) > rect.height/2;
    list.insertBefore(dragged, after ? el.nextSibling : el);
    markDirty();
    refreshPreview();
  });
});

function getOrder(){
  return [...list.querySelectorAll('.sec-item')].map(el=>({
    key: el.dataset.sec,
    visible: el.querySelector('[onclick*="toggleSec"]').textContent.trim() === '👁️'
  }));
}

function toggleSec(key){
  const item = list.querySelector(`[data-sec="${key}"]`);
  const btn = item.querySelector('[onclick*="toggleSec"]');
  btn.textContent = btn.textContent.trim()==='👁️' ? '🚫' : '👁️';
  item.style.borderColor = btn.textContent.trim()==='👁️' ? 'var(--line)' : '#ef4444';
  markDirty();
}

// فتح/غلق محرر كل قسم - زر ⚙️ واضح (inline onclick حتى يشتغل مع Playwright)
list.querySelectorAll('.sec-item').forEach(el=>{
  const key = el.dataset.sec;
  const btnRow = el.querySelector('.sec-head');
  if (!btnRow) return;
  const gear = document.createElement('button');
  gear.type='button'; gear.textContent='⚙️'; gear.setAttribute('title','تحرير هذا القسم');
  gear.setAttribute('data-gear', key);
  gear.style.cssText='border:none;background:none;cursor:pointer;font-size:1rem';
  gear.onclick = ()=>{
    const ed = document.getElementById('edit-'+key);
    if (ed) ed.style.display = ed.style.display==='none' ? 'block' : 'none';
  };
  btnRow.appendChild(gear);
});

async function saveLayout(){
  const order = getOrder().map(o=>o.key);
  const visibility = Object.fromEntries(getOrder().map(o=>[o.key,o.visible]));
  // جمع خصائص الأقسام المفتوحة
  const hero = {
    title: document.querySelector('[name="heroTitle"]')?.value,
    sub: document.querySelector('[name="heroSub"]')?.value,
    video: document.querySelector('[name="heroVideo"]')?.value,
    textColor: document.querySelector('[name="heroText"]')?.value,
    overlay: Number(document.querySelector('[name="heroOverlay"]')?.value || 40)
  };
  const grid = {
    cols: document.querySelector('[name="gridCols"]')?.value || 'auto',
    gap: Number(document.querySelector('[name="gridGap"]')?.value || 16)
  };
  layout = { ...layout, order, visibility, hero, grid };
  
  const payload = new URLSearchParams();
  payload.append('_csrf', '<%= csrf %>');
  payload.append('layout_json', JSON.stringify(layout));
  const res = await fetch('/panel/templates/layout?_csrf=<%= csrf %>', { method:'POST', headers: {'x-csrf-token':'<%= csrf %>','Content-Type':'application/x-www-form-urlencoded'}, body: payload });
  if (res.ok) { dirty=false; document.getElementById('dirtyBadge').hidden=true; alert('✅ تم حفظ تصميمك'); refreshPreview(); }
  else alert('❌ فشل الحفظ');
}

// ===== رفع خلفية المتجر =====
async function uploadStoreBg(){
  const fileInput = document.querySelector('input[name="store_bg_image"]');
  const videoInput = document.querySelector('input[name="store_bg_video"]');
  if (!fileInput.files[0] && !videoInput.files[0]){ alert('⚠️ اختر صورة أو فيديو أولاً'); return; }
  const form = new FormData();
  if (fileInput.files[0]) form.append('store_bg_image', fileInput.files[0]);
  if (videoInput.files[0]) form.append('store_bg_video', videoInput.files[0]);
  form.append('bg_overlay', document.querySelector('input[name="bg_overlay"]').value);
  const res = await fetch('/panel/templates/store-bg', { method:'POST', headers:{'x-csrf-token':'<%= csrf %>'}, body:form });
  if (res.ok){ alert('✅ تم حفظ خلفية المتجر'); refreshPreview(); }
  else alert('❌ فشل الحفظ');
}
function previewStoreBg(input){
  const preview = document.getElementById('bgPreview');
  if (input.files[0]){
    const url = URL.createObjectURL(input.files[0]);
    preview.innerHTML = '<img src="'+url+'" style="width:100%;height:auto;border-radius:6px">';
  }
}
// ===== Undo/Redo =====
const history = [];
let historyIndex = -1;
let restoring = false;
function snapshot(){
  const fields = {};
  document.querySelectorAll('#edit-hero [name], #edit-grid [name], #edit-announce [name]').forEach(inp=>{ fields[inp.name] = inp.value; });
  return { order: getOrder(), fields };
}
function saveHistory(){
  if (restoring) return;
  const state = snapshot();
  history.splice(historyIndex+1);
  history.push(state);
  historyIndex = history.length-1;
  if (history.length > 50){ history.shift(); historyIndex = history.length-1; }
}
document.addEventListener('keydown', e=>{
  const tag = (e.target.tagName||'').toLowerCase();
  if (tag==='input' || tag==='select' || tag==='textarea') return;
  if ((e.ctrlKey || e.metaKey) && e.key === 'z'){
    e.preventDefault();
    if (e.shiftKey) redo(); else undo();
  }
  if ((e.ctrlKey || e.metaKey) && e.key === 'y'){ e.preventDefault(); redo(); }
});
function undo(){
  if (historyIndex > 0){
    historyIndex--;
    restoring = true;
    try { restoreState(history[historyIndex]); } finally { restoring = false; }
  }
}
function redo(){
  if (historyIndex < history.length-1){
    historyIndex++;
    restoring = true;
    try { restoreState(history[historyIndex]); } finally { restoring = false; }
  }
}
function restoreState(state){
  // إعادة ترتيب الأقسام في القائمة حسب الحالة المحفوظة
  state.order.forEach(o=>{
    const el = list.querySelector(`[data-sec="${o.key}"]`);
    if (el) list.appendChild(el);
  });
  // إرجاع أزرار الإظهار/الإخفاء
  state.order.forEach(o=>{
    const item = list.querySelector(`[data-sec="${o.key}"]`);
    const btnEl = item?.querySelector('[onclick*="toggleSec"]');
    if (btnEl){
      btnEl.textContent = o.visible ? '👁️' : '🚫';
      item.style.borderColor = o.visible ? 'var(--line)' : '#ef4444';
    }
  });
  // إرجاع قيم حقول التحرير (هيرو/شبكة/إعلان)
  Object.entries(state.fields).forEach(([name,val])=>{
    const inp = document.querySelector(`[name="${name}"]`);
    if (inp && inp.type !== 'file') inp.value = val;
  });
  refreshPreview();
}
// نقطة البداية: الحالة الحالية عند فتح الصفحة
saveHistory();
</script>
</body>
</html>
