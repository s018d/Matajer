<%- include('../partials/head', { title: 'تخصيص المتجر — ألوان ونصوص وهيدر' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'customize', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: '🎨 تخصيص المتجر' }) %>
  <div class="content" style="max-width:800px">
    <%- include('../partials/alerts', { ok: typeof ok !== 'undefined' ? ok : '', err: typeof err !== 'undefined' ? err : '' }) %>

    <!-- الهيدر -->
    <div class="card">
      <h2>🖼️ الهيدر</h2>
      <form method="post" action="/panel/templates/customize" style="display:flex;flex-direction:column;gap:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label style="font-size:.9rem">عنوان الهيرو
          <input type="text" name="heroTitle" value="<%= (layout.hero||{}).title || store.name %>" style="padding:.6rem">
        </label>
        <label style="font-size:.9rem">نص فرعي
          <input type="text" name="heroSub" value="<%= (layout.hero||{}).sub || '' %>" placeholder="جملة قصيرة تجذب الزبون">
        </label>
        <label style="font-size:.9rem">صورة خلفية الهيرو
          <input type="text" name="heroImage" value="<%= (layout.hero||{}).image || '' %>" dir="ltr" placeholder="https://.../image.jpg">
        </label>
        <label style="font-size:.9rem">فيديو خلفية (mp4)
          <input type="url" name="heroVideo" value="<%= (layout.hero||{}).video || '' %>" dir="ltr" placeholder="https://.../video.mp4">
        </label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem">
          <label style="font-size:.9rem">لون النص<input type="color" name="heroText" value="<%= (layout.hero||{}).textColor || '#ffffff' %>" style="height:38px"></label>
          <label style="font-size:.9rem">تعتيم <input type="range" name="heroOverlay" min="0" max="90" value="<%= (layout.hero||{}).overlay != null ? layout.hero.overlay : 40 %>"></label>
        </div>
        <button class="btn btn-primary">💾 حفظ الهيدر</button>
      </form>
    </div>

    <!-- النصوص -->
    <div class="card" style="margin-top:1.2rem">
      <h2>📝 النصوص</h2>
      <form method="post" action="/panel/templates/customize" style="display:flex;flex-direction:column;gap:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label style="font-size:.9rem">نص شريط الإعلان
          <input type="text" name="announce" value="<%= layout.announce || '' %>" placeholder="مثال: شحن مجاني فوق 50,000 د.ع">
        </label>
        <button class="btn btn-primary">💾 حفظ النصوص</button>
      </form>
    </div>

    <!-- الألوان -->
    <div class="card" style="margin-top:1.2rem">
      <h2>🎨 الألوان والخطوط</h2>
      <form method="post" action="/panel/templates/customize" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;align-items:end">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label style="font-size:.85rem">أساسي<input type="color" name="primary" value="<%= cfg.primary || store.color %>" style="height:38px"></label>
        <label style="font-size:.85rem">ثانوي<input type="color" name="accent" value="<%= cfg.accent || '#ec4899' %>" style="height:38px"></label>
        <label style="font-size:.85rem">خلفية<input type="color" name="bg" value="<%= cfg.bg || '#ffffff' %>" style="height:38px"></label>
        <label style="font-size:.85rem">نص<input type="color" name="ink" value="<%= cfg.ink || '#111111' %>" style="height:38px"></label>
        <label style="font-size:.85rem">ناعم<input type="color" name="soft" value="<%= cfg.soft || '#f1f3f5' %>" style="height:38px"></label>
        <label style="font-size:.85rem">الخط
          <select name="font" style="padding:.45rem">
            <option value="Cairo" <%= cfg.font==='Cairo'?'selected':'' %>>Cairo</option>
            <option value="Noto Kufi Arabic" <%= cfg.font==='Noto Kufi Arabic'?'selected':'' %>>Kufi</option>
            <option value="Tajawal" <%= cfg.font==='Tajawal'?'selected':'' %>>Tajawal</option>
            <option value="Amiri" <%= cfg.font==='Amiri'?'selected':'' %>>Amiri</option>
          </select>
        </label>
        <button class="btn btn-primary" style="grid-column:1/-1">💾 حفظ الألوان</button>
      </form>
    </div>

    <div style="margin-top:1rem;text-align:center">
      <a href="/s/<%= store.slug %>" target="_blank" class="btn btn-ghost">👁️ معاينة متجري</a>
      <a href="/panel/templates" class="btn btn-ghost">→ معرض القوالب</a>
    </div>
  </div>
</main>
</body>
</html>
