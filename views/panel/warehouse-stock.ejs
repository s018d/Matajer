<%- include('../partials/head', { title: 'مخزون المستودع: ' + (warehouse?.name || 'غير معروف') + ' — متجري' }) %>
<body class="app">
<%- include('../partials/sidebar-panel', { active: 'warehouses', store }) %>
<main class="main">
  <%- include('../partials/topbar', { pageTitle: 'مخزون: ' + (warehouse?.name || 'غير معروف') }) %>
  <div class="content">
    <%- include('../partials/alerts') %>
    <div class="card-head-row" style="flex-wrap:wrap; gap:.5rem; align-items:center">
      <h2>مخزون <%= warehouse?.name || 'غير معروف' %> (<%= warehouse?.code || '—' %>)</h2>
      <a class="btn btn-primary" href="/panel/warehouses">← رجوع للمستودعات</a>
    </div>
    
    <div class="card" style="margin-bottom:1rem; padding:1rem; background:var(--soft); border-radius:10px">
      <div style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between">
        <div>
          <strong>المستودع:</strong> <%= warehouse?.name || '—' %> (<%= warehouse?.code || '—' %>) | 
          <strong>المدير:</strong> <%= warehouse?.manager_name || '—' %> | 
          <strong>الهاتف:</strong> <%= warehouse?.manager_phone || '—' %>
        </div>
        <div style="display:flex; gap:.5rem; flex-wrap:wrap">
          <a class="btn btn-sm btn-primary" href="/panel/warehouses">← رجوع للمستودعات</a>
        </div>
      </div>
    </div>
    
    <form method="get" class="search-form" style="margin-bottom:1rem; display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
      <input type="search" name="q" placeholder="ابحث بالاسم/الكود..." value="<%= typeof q !== 'undefined' ? q : '' %>" style="flex:1; min-width:200px; padding:.55rem .8rem; border:1.5px solid var(--line); border-radius:10px; font-family:inherit; font-size:.92rem">
      <button class="btn btn-sm" type="submit">🔍 بحث</button>
      <% if (q) { %><a class="btn btn-sm btn-ghost" href="/panel/warehouses/<%= warehouse?.id || '' %>/stock">إلغاء</a><% } %>
      <div style="display:flex; gap:.5rem; margin-right:auto">
        <span class="badge badge-ok">✅ متوفر (<%= stocks.filter(s => s.stock_status==='ok').length %>)</span>
        <span class="badge badge-warn">⚠️ منخفض (<%= stocks.filter(s => s.stock_status==='low').length %>)</span>
        <span class="badge badge-err">❌ نفد (<%= stocks.filter(s => s.stock_status==='out').length %>)</span>
      </div>
    </form>
    
    <table>
      <tr><th>المنتج</th><th>ID</th><th>السعر</th><th>الكمية</th><th>الحد الأدنى</th><th>الحد الأقصى</th><th>الحالة</th><th>إجراء</th></tr>
      <% stocks.forEach(s => { %>
        <tr style="<%= s.stock_status==='out'?'background:#fee2e2':(s.stock_status==='low'?'background:#fff3cd':'') %>">
          <td>
            <b><%= s.name %></b>
          </td>
          <td dir="ltr">#<%= s.id %></td>
          <td dir="ltr"><%= money(s.price) %></td>
          <td dir="ltr">
            <form method="post" action="/panel/warehouses/<%= warehouse?.id || '' %>/stock/adjust" class="inline" style="display:flex; gap:.3rem; align-items:center">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="product_id" value="<%= s.id %>">
              <input type="number" name="quantity" value="<%= s.quantity %>" min="0" step="1" dir="ltr" style="width:70px; padding:.3rem; border:1px solid var(--line); border-radius:6px; font-size:.85rem">
              <select name="operation" style="padding:.3rem; border:1px solid var(--line); border-radius:6px; font-size:.8rem">
                <option value="set">تعيين</option>
                <option value="add">إضافة</option>
                <option value="subtract">خصم</option>
              </select>
              <button type="submit" class="btn btn-sm btn-primary" style="padding:.3rem .6rem">تحديث</button>
            </form>
          </td>
          <td dir="ltr"><%= s.min_threshold %></td>
          <td dir="ltr"><%= s.max_threshold %></td>
          <td>
            <span class="badge <%= s.stock_status==='ok'?'badge-ok':(s.stock_status==='low'?'badge-warn':'badge-err') %>">
              <%= s.stock_status==='ok'?'✅ متوفر':(s.stock_status==='low'?'⚠️ منخفض':'❌ نفد') %>
            </span>
          </td>
          <td class="row-actions">
            <a class="btn btn-sm" href="/panel/products/<%= s.id %>/edit">تعديل المنتج</a>
          </td>
        </tr>
      <% }) %>
    </table>
    <% if (stocks.length === 0) { %><p class="empty-note" style="text-align:center; padding:2rem">لا توجد منتجات في هذا المستودع — <a href="/panel/products/new">أضف منتج</a></p><% } %>
  </div>
</main>
</body>
</html>