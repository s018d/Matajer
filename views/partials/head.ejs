<%
/* تحقق مركزي أولاً: اللون hex فقط، والروابط http(s) أو مسارات داخلية فقط */
const __safeColor = (typeof themeColor !== 'undefined' && /^#[0-9a-fA-F]{6}$/.test(String(themeColor))) ? themeColor : '#0ea5e9';
const __safeCss = (typeof css !== 'undefined' && /^\/(css|img|js)\/[a-zA-Z0-9._/-]+\.(css|js|svg|png|jpg)$/.test(String(css))) ? css : '/css/app.css';
const __safeOg = (typeof ogImage !== 'undefined' && /^(https:\/\/|\/img\/|\/uploads\/)/.test(String(ogImage))) ? String(ogImage).replace(/"/g, '') : '';
const __safePwa = (typeof pwa !== 'undefined' && /^[a-z0-9-]+$/.test(String(pwa))) ? String(pwa) : '';
%>
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'دُكّان — منصة المتاجر' %></title>
<meta name="description" content="<%= typeof desc !== 'undefined' && desc ? desc : 'دُكّان Dukkan — منصة عراقية لإنشاء متاجر إلكترونية جاهزة: تصميم مجاني + 4 أنماط عالمية، سلة طلبات، واتساب، أكواد خصم، مخزون وتوصيل.' %>">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'دُكّان — منصة المتاجر' %>">
<meta property="og:description" content="<%= typeof desc !== 'undefined' && desc ? desc : 'دُكّان Dukkan — منصة عراقية لإنشاء متاجر إلكترونية جاهزة.' %>">
<%- __safeOg ? '<meta property="og:image" content="' + __safeOg + '">' : '' %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'دُكّان — منصة المتاجر' %>">
<meta name="twitter:description" content="<%= typeof desc !== 'undefined' && desc ? desc : 'دُكّان Dukkan — منصة عراقية لإنشاء متاجر إلكترونية جاهزة.' %>">
<link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : '' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="font" type="font/woff2" crossorigin href="https://fonts.gstatic.com/s/notokufiarabic/v27/CSRk4ydQnPyaDxEXLFF6LZVLKrodrOYFFlKp.woff2">
<link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/logo.svg">
<%- __safePwa ? '<link rel="manifest" href="/s/' + __safePwa + '/manifest.json">' : '' %>
<meta name="theme-color" content="<%= __safeColor %>">
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="<%= __safeCss %>">
<%- typeof extraCss !== 'undefined' ? extraCss : '' %>
<%- __safePwa ? '<script>if("serviceWorker" in navigator && (location.protocol==="https:" || location.hostname==="localhost")){navigator.serviceWorker.register("/sw.js",{updateViaCache:"none"}).then(function(reg){if(reg.waiting||navigator.serviceWorker.controller){navigator.serviceWorker.addEventListener("controllerchange",function(){location.reload()})}}).catch(function(){})}</script>' : '' %>
</head>