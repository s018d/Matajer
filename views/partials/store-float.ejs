<div class="store-float">
  <% if (store.whatsapp) { %>
  <a class="sf-wa" href="https://wa.me/<%= String(store.whatsapp).replace(/\D/g, '') %>" target="_blank" rel="noopener" title="تواصل واتساب" aria-label="واتساب">
