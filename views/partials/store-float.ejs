  </a>
  <% } %>
  <button class="sf-share" title="مشاركة المتجر" aria-label="مشاركة" onclick="shareStore()">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81a3 3 0 1 0-3-3c0 .24.04.47.09.7L8.04 9.81A3.01 3.01 0 0 0 2 12a3 3 0 0 0 6.04.19l7.12 4.16a2.8 2.8 0 0 0-.09.73 2.98 2.98 0 1 0 2.93-3z"/></svg>
  </button>
</div>
<script>
function shareStore() {
  if (navigator.share) { navigator.share({ title: document.title, url: location.href }).catch(function () {}); }
  else if (navigator.clipboard) { navigator.clipboard.writeText(location.href).then(function () { alert('رابط المتجر منسوخ'); }); }
  else alert(location.href);
}
</script>