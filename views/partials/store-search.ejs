<div class="st-search">
  <form method="get" action="<%= store.base %>/" role="search">
    <label for="stSearchQ" class="sr-only">ابحث في المتجر</label>
    <input id="stSearchQ" type="search" name="q" value="<%= typeof q !== 'undefined' ? q : '' %>" placeholder="ابحث في المتجر عن منتج…" autocomplete="off">
    <button type="submit" aria-label="بحث">بحث</button>
  </form>
</div>
<style>.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}</style>