<header class="topbar">
  <button class="tb-menu" id="tbMenu" onclick="document.querySelector('.sidebar').classList.toggle('open');document.getElementById('sidebarOverlay').classList.toggle('show')" aria-label="القائمة">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="document.querySelector('.sidebar').classList.remove('open');this.classList.remove('show')"></div>
  <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : '' %></h1>
  <div class="tb-actions">
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.role === 'owner' && typeof store !== 'undefined' && store) { %>
        <% if (store.plan === 'pro' && !store.ispro) { %>
          <a class="btn btn-sm btn-warn" href="/panel/billing">⏰ باقتك انتهت — فعّلها</a>
        <% } else if (store.plan === 'pro' && store.plan_expires) { %>
          <% const __days = Math.ceil((new Date(store.plan_expires) - new Date()) / 86400000); %>
          <% if (__days <= 3) { %>
            <a class="btn btn-sm btn-warn" href="/panel/billing" title="تنتهي باقتك بتاريخ <%= store.plan_expires %>">⏰ تنتهي بعد <%= __days %> يوم — جدد</a>
          <% } else { %>
            <span class="badge badge-ok" title="تنتهي باقتك بتاريخ <%= store.plan_expires %>">احترافية حتى <span dir="ltr"><%= store.plan_expires %></span></span>
          <% } %>
        <% } %>
        <a class="btn btn-sm" href="/s/<%= store.slug %>" target="_blank">عرض متجري</a>
      <% } %>
      <span class="tb-user"><%= user.username %></span>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
        <button type="submit" class="btn btn-sm btn-ghost">خروج</button>
      </form>
    <% } %>
  </div>
</header>
<script>
function closeSidebar(){ document.querySelectorAll('.sidebar.open').forEach(s=>s.classList.remove('open')); document.querySelectorAll('.sidebar-overlay.show').forEach(o=>o.classList.remove('show')); document.body.style.overflow=''; }
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeSidebar(); });
</script>