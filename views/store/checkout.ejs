<%- include('../partials/head', { title: 'إتمام الطلب — ' + store.name, css: '/css/store.css', pwa: store.slug, themeColor: store.color }) %>
<% if (tpl && tpl.css) { %><link rel="stylesheet" href="<%= tpl.css %>"><% } %>
<% const __c = /^#[0-9a-fA-F]{6}$/.test(String(store.color)) ? store.color : '#0ea5e9'; %><% if (tpl) { %><style><%= tpl.style %></style><% } else { %><style>:root{--primary:<%= __c %>}</style><% } %>
<body data-template="<%= store.template %>" data-slug="<%= store.slug %>" data-base="<%= store.base %>" data-delivery-fee="<%= Number(store.delivery_fee) || 0 %>" data-free-min="<%= Number(store.free_delivery_min) || 0 %>" class="store-body<%= tpl ? ' ' + tpl.classes : '' %>">
<% if (store.template === 'market') { %>
  <%- include('../partials/market-marquee') %>
  <%- include('../partials/market-nav') %>
<% } else { %>
  <header class="st-head small">
    <div class="st-head-inner">
      <% if (store.logo_path) { %><img src="<%= store.logo_path %>" class="st-logo" alt=""><% } %>
      <h1><a href="<%= store.base %>/"><%= store.name %></a></h1>
    </div>
  </header>
<% } %>
<main class="st-main">
  <a class="st-back" href="<%= store.base %>/">→ رجوع للمتجر</a>
  <!-- Checkout Steps -->
  <div class="co-steps">
    <div class="co-step active" data-step="1">
      <div class="co-step-num">1</div>
      <span>السلة</span>
    </div>
    <div class="co-step-line"></div>
    <div class="co-step active" data-step="2">
      <div class="co-step-num">2</div>
      <span>البيانات</span>
    </div>
    <div class="co-step-line"></div>
    <div class="co-step" data-step="3">
      <div class="co-step-num">3</div>
      <span>التأكيد</span>
    </div>
  </div>

  <div class="st-checkout">
    <div class="card co-cart-card">
      <h2>🛒 ملخص الطلب</h2>
      <div id="coItems"></div>
      <div class="co-lines">
        <div class="co-line"><span>المجموع الفرعي</span><b id="coSubtotal">0</b></div>
        <div class="co-line" id="coDiscountLine" style="display:none"><span>الخصم</span><b id="coDiscount" class="co-green">—</b></div>
        <div class="co-line"><span>التوصيل</span><b id="coDelivery">—</b></div>
        <div class="co-line co-line-total"><span>الإجمالي النهائي</span><b id="coTotal">0</b></div>
      </div>
      <% if (Number(store.delivery_fee) > 0) { %>
        <div class="co-free-delivery" id="coFreeDelivery"></div>
      <% } %>
      <div class="co-coupon">
        <input type="text" id="coCoupon" placeholder="كود الخصم" maxlength="40" dir="ltr">
        <button type="button" id="coApplyCoupon" class="st-btn">تطبيق</button>
      </div>
      <div class="co-coupon-msg" id="coCouponMsg"></div>
    </div>
    <div class="card co-form-card">
      <h2>📋 بيانات التوصيل</h2>
      <% if (err) { %><div class="alert alert-err"><%= err %></div><% } %>
      <form id="coForm" method="post" action="<%= store.base %>/checkout" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="cart" id="coCart">
        <input type="hidden" name="coupon" id="coCouponCode">
        <div class="co-field">
          <label>الاسم الكامل *</label>
          <div class="co-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" name="customer_name" placeholder="أدخل اسمك الكامل" required autocomplete="name" autocapitalize="words">
          </div>
        </div>
        <div class="co-field">
          <label>رقم الهاتف *</label>
          <div class="co-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <input type="tel" name="customer_phone" dir="ltr" placeholder="07XX XXX XXXX" required autocomplete="tel" inputmode="numeric" pattern="[0-9 ]{10,15}">
          </div>
        </div>
        <div class="co-field">
          <label>العنوان التفصيلي</label>
          <div class="co-input-wrap">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <input type="text" name="customer_address" placeholder="المدينة، المنطقة، الشارع">
          </div>
        </div>
        <div class="co-field">
          <label>ملاحظات إضافية</label>
          <textarea name="note" rows="2" placeholder="أي ملاحظات خاصة بالطلب..."></textarea>
        </div>
        <fieldset class="co-payment">
          <legend>💳 طريقة الدفع</legend>
          <label class="co-pay-option">
            <input type="radio" name="payment_method" value="cod" checked>
            <div class="co-pay-info">
              <span class="co-pay-name">💵 الدفع عند الاستلام</span>
              <small>ادفع نقداً عند استلام طلبك</small>
            </div>
          </label>

        </fieldset>
        <button type="submit" class="st-btn big-btn co-submit-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          تأكيد الطلب
        </button>
      </form>
    </div>
  </div>
</main>
<% if (store.template === 'market' || store.template === 'neo') { %>
  <%- include('../partials/market-footer') %>
<% } %>
<%- include('../partials/store-brand') %>
<script src="/js/cart.js?v=5"></script>
<script>renderCheckoutPage();</script>
<script>
  // Handle reorder
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const reorderId = urlParams.get('reorder');
    if (reorderId) {
      fetch('<%= store.base %>/reorder-data/' + reorderId)
        .then(r => r.json())
        .then(data => {
          if (data.ok && data.cart) {
            localStorage.setItem('mc_<%= store.slug %>', JSON.stringify(data.cart));
            window.history.replaceState({}, '', '<%= store.base %>/checkout');
            location.reload();
          }
        }).catch(() => {});
    }
  })();
</script>
<style>
/* Checkout Steps */
.co-steps{display:flex;align-items:center;justify-content:center;gap:0;margin-bottom:2rem;padding:1rem;background:#fff;border-radius:var(--radius-xl);border:1.5px solid var(--line);box-shadow:var(--shadow)}
.co-step{display:flex;align-items:center;gap:.5rem;opacity:.4;transition:opacity .3s}
.co-step.active{opacity:1}
.co-step-num{width:32px;height:32px;border-radius:50%;background:var(--line);color:var(--muted);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.85rem;transition:all .3s}
.co-step.active .co-step-num{background:linear-gradient(135deg,var(--primary),#0284c7);color:#fff;box-shadow:0 4px 12px rgba(14,165,233,.35)}
.co-step span{font-weight:700;font-size:.85rem;color:var(--muted)}
.co-step.active span{color:var(--ink)}
.co-step-line{width:40px;height:2px;background:var(--line);margin:0 .5rem}

/* Checkout form enhancements */
.co-cart-card,.co-form-card{animation:fadeInUp .5s ease}
.co-field{display:flex;flex-direction:column;gap:.3rem}
.co-field label{font-size:.87rem;font-weight:700;color:#374151}
.co-input-wrap{display:flex;align-items:center;gap:.6rem;background:#fafbfc;border:1.5px solid var(--line);border-radius:var(--radius);padding:0 1rem;transition:all .25s}
.co-input-wrap:focus-within{border-color:var(--primary);box-shadow:0 0 0 3px rgba(14,165,233,.1);background:#fff}
.co-input-wrap svg{color:#94a3b8;flex-shrink:0}
.co-input-wrap input{flex:1;border:none;background:transparent;padding:.8rem 0;font-size:1rem;font-family:inherit;color:var(--ink)}
.co-input-wrap input:focus{outline:none}

/* Payment */
.co-payment{margin-top:.5rem;padding:1.2rem;border:1.5px solid var(--line);border-radius:var(--radius-lg);background:#fafbfc}
.co-payment legend{font-weight:800;color:var(--ink);padding:0 .5rem;font-size:.95rem}
.co-pay-option{display:flex;align-items:center;gap:.8rem;padding:.8rem;border-radius:var(--radius);cursor:pointer;transition:all .25s;border:1.5px solid transparent}
.co-pay-option:hover{background:var(--soft)}
.co-pay-option:has(input:checked){border-color:var(--primary);background:rgba(14,165,233,.04)}
.co-pay-option input{accent-color:var(--primary);width:18px;height:18px}
.co-pay-info{display:flex;flex-direction:column;gap:.1rem}
.co-pay-name{font-weight:700;font-size:.92rem;color:var(--ink)}
.co-pay-info small{color:var(--muted);font-size:.78rem}

/* Submit button — هوية دكان */
.co-submit-btn{margin-top:.5rem;font-size:1.05rem;padding:1rem;border-radius:14px;background:linear-gradient(135deg,#0B1F3A,#C2410C 55%,#EA580C)!important;box-shadow:0 10px 26px rgba(11,31,58,.4)!important;font-weight:900}
.co-submit-btn:hover{box-shadow:0 14px 32px rgba(11,31,58,.5)!important;transform:translateY(-2px)!important}
.co-step.active .co-step-num{background:linear-gradient(135deg,#0B1F3A,#EA580C)!important;color:#fff;box-shadow:0 4px 12px rgba(11,31,58,.35)}
.co-pay-option:has(input:checked){border-color:#EA580C !important;background:rgba(234,88,12,.06) !important}
.co-pay-option input{accent-color:#C2410C}
.co-input-wrap:focus-within{border-color:#EA580C !important;box-shadow:0 0 0 3px rgba(234,88,12,.12) !important}
#coApplyCoupon{background:linear-gradient(135deg,#0B1F3A,#C2410C) !important; border:none !important; color:#fff !important; font-weight:800}

@media(max-width:800px){
  .co-steps{margin-bottom:1rem;padding:.8rem}
  .co-step span{font-size:.75rem}
  .co-step-line{width:20px}
}
</style>
</body>
</html>