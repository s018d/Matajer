<%- include('../partials/head', { title: 'تم الطلب — ' + store.name, css: '/css/store.css', pwa: store.slug, themeColor: store.color }) %>
<% if (tpl && tpl.css) { %><link rel="stylesheet" href="<%= tpl.css %>"><% } %>
<% const __c = /^#[0-9a-fA-F]{6}$/.test(String(store.color)) ? store.color : '#0ea5e9'; %><% if (tpl) { %><style><%= tpl.style %></style><% } else { %><style>:root{--primary:<%= __c %>}</style><% } %>
<body data-template="<%= store.template %>" data-slug="<%= store.slug %>" data-base="<%= store.base %>" class="store-body<%= tpl ? ' ' + tpl.classes : '' %>">
<% if (store.template === 'market' || store.template === 'neo') { %>
  <%- include('../partials/market-nav') %>
<% } %>
<main class="st-main">
  <div class="st-done">
    <!-- Confetti -->
    <div class="confetti-container" id="confetti"></div>
    
    <div class="st-done-icon">🎉</div>
    <h1>تم استلام طلبك بنجاح!</h1>
    <p class="st-done-sub">رقم الطلب: <strong>#<%= orderId %></strong></p>
    
    <div class="st-done-sum">
      <div class="st-done-line"><span>المجموع الفرعي</span><b><%= Number(subtotal).toLocaleString('en-US') %> د.ع</b></div>
      <% if (discount > 0) { %><div class="st-done-line ok"><span>خصم<%= couponCode ? ' («' + couponCode + '»)' : '' %></span><b>− <%= Number(discount).toLocaleString('en-US') %> د.ع</b></div><% } %>
      <div class="st-done-line"><span>التوصيل</span><b><%= deliveryFee > 0 ? Number(deliveryFee).toLocaleString('en-US') + ' د.ع' : 'مجاني ✓' %></b></div>
      <div class="st-done-line total"><span>الإجمالي النهائي</span><b><%= Number(total).toLocaleString('en-US') %> د.ع</b></div>
    </div>

    <% if (paid) { %>
      <div class="st-done-alert st-done-alert-success">
        <span class="st-done-alert-icon">💳</span>
        <div>
          <strong>تم تأكيد طلبك بنجاح!</strong>
          <small>الدفع عند الاستلام — سيتواصل معك البائع قريباً</small>
        </div>
      </div>
    <% } %>

    <% if (earnedPoints && earnedPoints > 0) { %>
      <div class="st-done-alert st-done-alert-points">
        <span class="st-done-alert-icon">⭐</span>
        <div>
          <strong>ربحت <%= earnedPoints %> نقطة ولاء!</strong>
          <small>كل 1000 د.ع = 10 نقاط | 100 نقطة = 1000 د.ع خصم</small>
        </div>
      </div>
    <% } %>

    <p class="st-done-msg">سيتواصل معك البائع قريباً لتأكيد الطلب وترتيب التوصيل</p>

    <div class="st-done-actions">
      <a class="st-btn big-btn" href="<%= store.base %>/reorder/<%= orderId %>?t=<%= doneToken %>">
        🔄 اطلب مجدداً
      </a>
      <a class="st-btn big-btn st-btn-outline" href="<%= store.base %>/">
        🏠 العودة للمتجر
      </a>
    </div>

    <% if (store.whatsapp) { %>
    <a class="st-done-wa" href="https://wa.me/<%= store.whatsapp.replace(/^0/, '964') %>?text=<%= encodeURIComponent('مرحباً ' + store.name + '، أنا صاحب الطلب #' + orderId + ' بمبلغ ' + Number(total).toLocaleString('en-US') + ' د.ع — أريد تأكيده') %>" target="_blank" rel="noopener">
      💬 تأكيد الطلب عبر الواتساب
    </a>
    <% } %>
  </div>
</main>
<% if (store.template === 'market' || store.template === 'neo') { %>
  <%- include('../partials/market-footer') %>
<% } %>
<%- include('../partials/store-brand') %>
<script>
  // Confetti animation
  (function() {
    const container = document.getElementById('confetti');
    const colors = ['#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899'];
    for (let i = 0; i < 50; i++) {
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.cssText = `
        left: ${Math.random() * 100}%;
        background: ${colors[Math.floor(Math.random() * colors.length)]};
        animation-delay: ${Math.random() * 2}s;
        animation-duration: ${2 + Math.random() * 3}s;
        width: ${6 + Math.random() * 8}px;
        height: ${6 + Math.random() * 8}px;
        border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
      `;
      container.appendChild(piece);
    }
    setTimeout(() => { container.style.opacity = '0'; }, 4000);
  })();
  try { localStorage.removeItem('mc_' + document.body.dataset.slug); } catch (e) {}
</script>
<style>
.st-done{text-align:center;padding:4rem 1.5rem 5rem;display:flex;flex-direction:column;gap:1rem;align-items:center;position:relative;animation:fadeInUp .6s ease}
.confetti-container{position:fixed;top:0;left:0;right:0;height:100vh;pointer-events:none;z-index:100;overflow:hidden;transition:opacity 1s}
.confetti-piece{position:absolute;top:-20px;width:10px;height:10px;background:#0ea5e9;animation:confetti 3s ease-in forwards}
@keyframes confetti{0%{transform:translateY(0) rotate(0deg);opacity:1}100%{transform:translateY(100vh) rotate(720deg);opacity:0}}

.st-done-icon{width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,#dcfce7,#bbf7d0);display:flex;align-items:center;justify-content:center;font-size:3rem;animation:celebrate .7s cubic-bezier(.34,1.56,.64,1);box-shadow:0 16px 40px rgba(22,163,74,.25);margin-bottom:.5rem}
@keyframes celebrate{0%{transform:scale(0) rotate(-20deg);opacity:0}60%{transform:scale(1.15) rotate(5deg)}100%{transform:scale(1) rotate(0deg);opacity:1}}

.st-done h1{font-size:1.8rem;font-weight:900;background:linear-gradient(135deg,#7f1d1d,#d97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.st-done-sub{font-size:1rem;color:var(--muted);margin-bottom:.5rem}
.st-done-sub strong{color:var(--ink);font-weight:800}

.st-done-sum{max-width:420px;width:100%;background:#fff;border:1.5px solid var(--line);border-radius:var(--radius-xl);padding:1.4rem 1.6rem;display:flex;flex-direction:column;gap:.5rem;text-align:start;box-shadow:var(--shadow);animation:fadeInUp .6s ease .2s both}
.st-done-line{display:flex;justify-content:space-between;font-size:.92rem;color:var(--muted)}
.st-done-line.ok b{color:var(--success)}
.st-done-line.total{border-top:2px solid var(--soft);padding-top:.7rem;margin-top:.3rem;font-weight:800;color:var(--ink);font-size:1rem}
.st-done-line.total b{color:#7f1d1d;font-size:1.15rem}

.st-done-alert{display:flex;align-items:center;gap:.8rem;padding:1rem 1.2rem;border-radius:var(--radius-lg);text-align:start;max-width:420px;width:100%;animation:fadeInUp .5s ease .3s both}
.st-done-alert-success{background:linear-gradient(135deg,#dcfce7,#bbf7d0);border:1.5px solid #86efac}
.st-done-alert-points{background:linear-gradient(135deg,#fef3c7,#fde68a);border:1.5px solid #fcd34d}
.st-done-alert-icon{font-size:1.8rem;flex-shrink:0}
.st-done-alert strong{display:block;font-size:.95rem;color:var(--ink)}
.st-done-alert small{color:var(--muted);font-size:.78rem}

.st-done-msg{color:var(--muted);font-size:.92rem;max-width:400px;line-height:1.7}

.st-done-actions{display:flex;gap:.7rem;flex-wrap:wrap;justify-content:center;animation:fadeInUp .5s ease .4s both}
.st-done-actions .st-btn{min-width:180px}
.st-btn-outline{background:var(--soft)!important;color:var(--ink)!important;box-shadow:var(--shadow)}
.st-btn-outline:hover{box-shadow:var(--shadow-md)!important}

.st-done-wa{display:inline-flex;align-items:center;gap:.5rem;background:linear-gradient(135deg,#25d366,#128c7e);color:#fff;padding:.8rem 1.6rem;border-radius:var(--radius-lg);font-weight:700;font-size:.92rem;transition:all .25s;margin-top:.5rem;box-shadow:0 6px 16px rgba(37,211,102,.3);animation:fadeInUp .5s ease .5s both}
.st-done-wa:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(37,211,102,.4)}

@media(max-width:800px){
  .st-done{padding:3rem 1rem 4rem}
  .st-done h1{font-size:1.4rem}
  .st-done-actions{flex-direction:column;width:100%}
  .st-done-actions .st-btn{width:100%}
}
</style>
</body>
</html>