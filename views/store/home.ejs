<%- include('../partials/head', { title: store.name, desc: store.meta_desc || store.description, ogType: 'website', css: '/css/store.css', pwa: store.slug, themeColor: store.color }) %>
<%
/* ===== محرك التخطيط الديناميكي — ترتيب الأقسام من layout_json ===== */
let L = {};
try { L = JSON.parse(store.layout_json || '{}'); } catch(e) {}
const order = Array.isArray(L.order) && L.order.length ? L.order : ['hero','search','cats','announce','grid','brand'];
// دمج الأقسام الجديدة (announce) في الترتيب القديم المحفوظ
const DEF_ORDER = ['hero','search','cats','announce','grid','brand'];
if (!order.includes('announce')) order.splice(order.indexOf('grid') >= 0 ? order.indexOf('grid') : order.length, 0, 'announce');
const vis = L.visibility || {};
const show = k => vis[k] !== false && order.includes(k);
const heroCfg = L.hero || {};
const gridCfg = L.grid || {};
const heroTitle = heroCfg.title || store.name;
const heroSub = heroCfg.sub || store.description;
%>
<% const __c = /^#[0-9a-fA-F]{6}$/.test(String(store.color)) ? store.color : '#0ea5e9'; %>
<% if (tpl && tpl.css) { %><link rel="stylesheet" href="<%= tpl.css %>"><% } %>
<style>:root{--store-primary:<%= __c %>; --store-primary-dark:<%= __c %>}</style>
<% if (tpl) { %><style><%= tpl.style %></style><% } %>
<% if (store.custom_css) { %><style><%= store.custom_css %></style><% } %>
<% /* خلفية المتجر العامة */ %>
<% if (store.store_bg_image) { %>
<style>body.store-body{background-image:url('<%= store.store_bg_image %>');background-size:cover;background-attachment:fixed}</style>
<% } %>
<body data-template="<%= store.template %>" data-slug="<%= store.slug %>" data-base="<%= store.base %>" class="store-body<%= tpl ? ' ' + tpl.classes : '' %>">

<% /* ====== كل قسم دالة عرض، والترتيب من layout.order ====== */ %>

<% function renderHero(){ %>
  <% if (store.template === 'market') { %>
    <%- include('../partials/market-hero') %>
  <% } else { const hStyle = `position:relative;${heroCfg.image ? `background:url('${heroCfg.image}') center/cover;` : ''}` ; const overlay = heroCfg.overlay != null ? Number(heroCfg.overlay) : (heroCfg.image ? 40 : 0); %>
    <header class="st-head <%= store.template==='royal-ivory'?'royal-hero':store.template==='black-gold'?'black-hero':store.template==='modern-green'?'green-hero':store.template==='prem-fashion'?'fashion-hero':store.template==='prem-outdoor'?'outdoor-hero':store.template==='prem-classic'?'classic-hero':store.template==='prem-natural'?'natural-hero':'' %>" style="<%= hStyle %>">
      <% if (heroCfg.video) { %>
        <video autoplay muted loop playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0" src="<%= heroCfg.video %>"></video>
      <% } %>
      <div style="position:absolute;inset:0;background:rgba(0,0,0,<%= overlay/100 %>)"></div>
      <div class="st-head-inner" style="position:relative;z-index:1">
        <% if (store.logo_path) { %><img src="<%= store.logo_path %>" class="st-logo" alt=""><% } %>
        <div>
          <h1 style="<%= heroCfg.image||heroCfg.video ? `color:${heroCfg.textColor||'#fff'} !important;-webkit-text-fill-color:${heroCfg.textColor||'#fff'} !important` : '' %>"><%= heroTitle %></h1>
          <p style="<%= heroCfg.image||heroCfg.video ? 'color:rgba(255,255,255,.88)' : '' %>"><%= heroSub %></p>

          <% if (store.template==='prem-fashion') { %><span class="fashion-badge">Lookbook • Editorial</span><% } %>
          <% if (store.template==='prem-outdoor') { %>
            <div class="outdoor-filters" style="margin-inline-start:0">
              <span>🏔️ Hiking</span><span>⛺ Camping</span><span>🧳 Travel</span><span>🧗 Climbing</span>
            </div>
          <% } %>
          <% if (store.template==='prem-classic') { %><span class="classic-badge">⚡ Flash 24H • خصم حتى 50%</span><% } %>
          <% if (store.template==='prem-natural') { %><span class="natural-badge">🌿 طبيعي 100%</span><% } %>
        </div>
      </div>
    </header>
  <% } %>
<% } %>

<% function renderSearch(){ %><%- include('../partials/store-search') %><% } %>

<% function renderCats(){ %>
<nav class="st-nav" id="mkCats">
  <a href="<%= store.base %>/" class="<%= cat === 0 ? 'on' : '' %>">الكل</a>
  <% cats.forEach(c => { %>
    <a href="<%= store.base %>/?cat=<%= c.id %>" class="<%= cat === c.id ? 'on' : '' %>"><%= c.name %></a>
  <% }) %>
</nav>
<% } %>

<% function renderGrid(){ const cols = gridCfg.cols; const gap = gridCfg.gap || 16; const cls = store.template==='royal-ivory'?'royal-grid':store.template==='black-gold'?'black-grid':store.template==='modern-green'?'green-grid':store.template==='prem-fashion'?'fashion-grid':store.template==='prem-outdoor'?'outdoor-grid':store.template==='prem-classic'?'classic-grid':store.template==='prem-natural'?'natural-grid':''; %>
<main class="st-main">
  <div class="st-grid <%= cls %>" style="<%= cols&&cols!=='auto' ? `grid-template-columns:repeat(${cols},1fr) !important;` : '' %>gap:<%= gap %>px">
    <% rows.forEach((p, i) => { %>
      <%- include('../partials/store-card', { p, store, idx: i }) %>
    <% }) %>
  </div>
  <% if (rows.length === 0) { %>
    <div class="st-empty" style="display:flex;flex-direction:column;align-items:center;gap:.7rem;padding:3rem 1rem;background:#fff;border:1.5px dashed var(--line);border-radius:18px;margin-top:.8rem;box-shadow:var(--shadow)">
      <div style="width:64px;height:64px;border-radius:50%;background:var(--soft);display:flex;align-items:center;justify-content:center;font-size:1.9rem"><%= q ? '🔍' : '🛍️' %></div>
      <h3 style="font-size:1.05rem;font-weight:800;color:var(--ink)"><%= q ? 'لا نتائج للبحث عن «' + q + '»' : 'لا توجد منتجات هنا بعد' %></h3>
      <p style="color:var(--muted);font-size:.88rem;max-width:340px;text-align:center;line-height:1.7"><%= q ? 'جرّب كلمات مختلفة أو تصفح كل الأقسام' : 'سيضيف صاحب المتجر منتجات جديدة قريباً — تفقّد الأقسام الأخرى' %></p>
      <% if (q) { %>
        <a href="<%= store.base %>/" class="st-btn" style="padding:.6rem 1.2rem;font-size:.88rem;margin-top:.3rem">مسح البحث وعرض الكل</a>
      <% } else if (cat) { %>
        <a href="<%= store.base %>/" class="st-btn" style="padding:.6rem 1.2rem;font-size:.88rem;margin-top:.3rem">عرض كل المنتجات</a>
      <% } %>
    </div>
  <% } %>
</main>
<% } %>

<% function renderBrand(){ %><%- include('../partials/store-brand') %><% } %>

<% function renderAnnounce(){ if (!show('announce')) return; const a = L.announce || {}; if (!a.text) return; const bg = a.bg || '#fff3cd'; const color = a.color || '#856404'; const icon = a.icon || '📢'; const rawLink = String(a.link || ''); const link = /^https?:\/\/[^\s"<>]+$/.test(rawLink) ? rawLink : ''; const txt = a.text || ''; const linkAttr = link ? `href="${link.replace(/"/g, '')}" target="_blank" rel="noopener"` : ''; %>
  <div class="announce-bar" style="background:<%=bg%>;color:<%=color%>;padding:.6rem 1rem;text-align:center;font-size:.9rem;font-weight:600;display:flex;align-items:center;justify-content:center;gap:.5rem;<%= a.link ? 'cursor:pointer' : '' %>" <%= linkAttr %>>
    <span><%= icon %></span>
    <span><%= txt %></span>
    <% if (a.link) { %><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg><% } %>
  </div>
<% } %>
<% const renderers = { hero: renderHero, search: renderSearch, cats: renderCats, grid: renderGrid, announce: renderAnnounce, brand: renderBrand }; %>

<% if (store.template === 'market') { %>
  <%- include('../partials/market-marquee') %>
  <%- include('../partials/market-nav') %>
<% } %>

<% for (const sec of order) { if (show(sec) && renderers[sec]) { renderers[sec](); } } %>

<%- include('../partials/store-float') %>
<% if (store.template === 'market' || store.template === 'neo') { %>
  <%- include('../partials/market-footer') %>
<% } %>
<%- include('../partials/cart-drawer') %>
</body>
</html>