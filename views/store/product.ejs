<%
  const opts = (() => { try { return JSON.parse(product.options || '{}'); } catch (e) { return {}; } })();
  const addons = (() => { try { return JSON.parse(product.addons || '[]'); } catch (e) { return []; } })();
  const out = product.stock != null && Number(product.stock) <= 0;
  const lowStock = product.stock != null && Number(product.stock) > 0 && Number(product.stock) <= 5;
%>
<%- include('../partials/head', { title: product.name + ' — ' + store.name, desc: store.meta_desc || store.description, ogType: 'product', css: '/css/store.css', pwa: store.slug, themeColor: store.color }) %>
<% if (store.template === 'market') { %><link rel="stylesheet" href="/css/store-market.css"><% } %>
<% if (store.template === 'neo') { %><link rel="stylesheet" href="/css/store-neo.css"><% } %>
<% if (store.template === 'gen') { %><link rel="stylesheet" href="/css/store-gen.css"><% } %>
<% if (tpl && tpl.css) { %><link rel="stylesheet" href="<%= tpl.css %>"><% } %>
<% if (tpl) { %><style><%= tpl.style %></style><% } else { %><style>:root{--primary:<%= store.color %>}</style><% } %>
<body data-template="<%= store.template %>" data-slug="<%= store.slug %>" data-base="<%= store.base %>" class="store-body<%= tpl ? ' ' + tpl.classes : '' %>">
<% if (store.template === 'market') { %>
  <%- include('../partials/market-marquee') %>
  <%- include('../partials/market-nav') %>
<% } else { %>
  <header class="st-head small">
    <div class="st-head-inner">
      <% if (store.logo_path) { %><img src="<%= store.logo_path %>" class="st-logo" alt=""><% } %>
      <h1><a href="<%= store.base %>/"><%= store.name %></a></h1>
    </div>
    <a class="st-back" href="<%= store.base %>/">→ رجوع للمتجر</a>
  </header>
<% } %>
<main class="st-main">
  <nav class="st-breadcrumb" style="font-size:.82rem; color:var(--muted); margin-bottom:.8rem; display:flex; gap:.4rem; align-items:center; flex-wrap:wrap">
    <a href="<%= store.base %>/">🏠 <%= store.name %></a><span>›</span><a href="<%= store.base %>/?cat=<%= product.category_id %>">القسم</a><span>›</span><span style="color:var(--ink); font-weight:700"><%= product.name %></span>
  </nav>
  <div class="st-product">
    <div class="st-gallery">
      <% if (images.length) { %>
        <img src="<%= images[0].path %>" class="st-main-img" id="mainImg" alt="<%= product.name %>" loading="eager" fetchpriority="high" onclick="openLightbox(0)" data-variant="<%= images[0].variant || '' %>">
        <% if (images.length > 1) { %>
          <div class="st-thumbs" id="stThumbs">
            <% images.forEach((im, idx) => { %>
              <img src="<%= im.path %>" alt="" loading="lazy" class="<%= idx === 0 ? 'active' : '' %>" data-variant="<%= im.variant || '' %>" data-idx="<%= idx %>" onclick="switchImg(this, <%= idx %>)">
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <div class="st-img-empty big">لا توجد صورة لهذا المنتج</div>
      <% } %>
    </div>
    <div class="st-product-info dkp">
      <h1 class="dkp-name"><%= product.name %></h1>
      <div class="dkp-price">
        <b><%= Number(product.price).toLocaleString('en-US') %> <small>د.ع</small></b>
        <% if (product.old_price) { %><del><%= Number(product.old_price).toLocaleString('en-US') %></del><span class="dkp-save">وفّر <%= Math.round((1 - Number(product.price)/Number(product.old_price))*100) %>%</span><% } %>
      </div>
      <% if (out) { %>
        <div class="dkp-soldout">🚫 نفد المخزون — تواصل واتساب للطلب المسبق</div>
      <% } else if (lowStock) { %>
        <div class="dkp-low">⚡ كمية محدودة: <%= product.stock %> قطع متبقية — اطلب هسه</div>
      <% } %>
      <% const isTech = store.template === 'black-gold' || store.template === 'prem-classic'; const descLines = String(product.description||'').split('\n').map(s=>s.trim()).filter(Boolean); const hasSpecs = descLines.some(l=>l.includes(':')); %>
      <% if (isTech && hasSpecs) { %>
        <table class="st-specs" style="width:100%;border-collapse:collapse;margin:.8rem 0;font-size:.85rem">
          <% descLines.forEach(line=>{ const [k,v]=line.split(':'); if(v!==undefined){ %>
            <tr style="border-bottom:1px solid var(--line)"><td style="padding:.5rem .7rem;background:var(--soft);font-weight:700;width:38%"><%= k.trim() %></td><td style="padding:.5rem .7rem"><%= v.trim() %></td></tr>
          <% }}) %>
        </table>
      <% } else { %>
        <p class="st-desc"><%= product.description %></p>
      <% } %>
      <% Object.entries(opts).forEach(([label, vals]) => { %>
        <label class="st-opt"><%= label %>
          <select class="st-opt-sel" data-opt="<%= label %>">
            <% String(vals).split(',').map(v => v.trim()).filter(Boolean).forEach(v => { %>
              <option value="<%= v %>"><%= v %></option>
            <% }) %>
          </select>
        </label>
      <% }) %>
      <% if (addons.length) { %>
        <div class="st-addons">
          <% addons.forEach((a, ai) => { %>
            <label class="st-addon"><input type="checkbox" class="st-addon-cb" data-name="<%= a.name.replace(/"/g,'&quot;') %>" data-price="<%= Number(a.price) || 0 %>">
              <span><%= a.name %> +<%= (Number(a.price) || 0).toLocaleString('en-US') %> د.ع</span></label>
          <% }) %>
        </div>
      <% } %>
      <% if (!out) { %>
        <div class="dkp-qty">
          <button type="button" onclick="qty(-1)" aria-label="إنقاص">−</button>
          <input id="qty" value="1" readonly>
          <button type="button" onclick="qty(1)" aria-label="زيادة">+</button>
          <span>الكمية</span>
        </div>
        <button class="add-cart st-btn big-btn dkp-atc" data-id="<%= product.id %>" data-name="<%= product.name.replace(/"/g,'&quot;') %>" data-price="<%= product.price %>" data-img="<%= images.length ? images[0].path : '' %>" onclick="productAddToCart(this)">
          🛒 أضف للسلة — <%= Number(product.price).toLocaleString('en-US') %> د.ع
        </button>
        <% if (store.whatsapp) { %>
        <a class="st-btn big-btn wa-order dkp-wa" href="https://wa.me/<%= store.whatsapp.replace(/^0/, '964') %>?text=<%= encodeURIComponent('أريد طلب: ' + product.name + ' - السعر: ' + Number(product.price).toLocaleString('en-US') + ' د.ع - الكمية: 1') %>" target="_blank" rel="noopener">
          💬 اطلب عبر واتساب
        </a>
        <% } %>
        <div class="dkp-trust">
          <span>✓ دفع عند الاستلام</span>
          <span>✓ توصيل سريع</span>
          <span>✓ ضمان الاستبدال</span>
        </div>
        <% if (product.stock != null) { %><p class="dkp-stock">المتبقي: <%= product.stock %> قطعة</p><% } %>
      <% } %>
    </div>
  </div>
  <% if (related.length) { %>
    <h2 class="st-rel-title">منتجات مشابهة</h2>
    <div class="st-grid">
      <% related.forEach(p => { %>
        <%- include('../partials/store-card', { p, store }) %>
      <% }) %>
    </div>
  <% } %>

  <% if (!out) { %>
  <div id="stickyATC" style="position:fixed; inset-inline:0; bottom:0; background:rgba(255,255,255,.96); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-top:1.5px solid var(--line); padding:.7rem 1rem .85rem; display:none; align-items:center; gap:.7rem; z-index:85; box-shadow:0 -10px 30px rgba(15,23,42,.12); transform:translateY(100%); transition:transform .28s cubic-bezier(.4,0,.2,1)">
    <div style="flex:1; min-width:0">
      <div style="font-weight:900; color:var(--primary); font-size:1rem; line-height:1.2"><%= Number(product.price).toLocaleString('en-US') %> د.ع</div>
      <div style="font-size:.74rem; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis"><%= product.name %></div>
    </div>
    <button onclick="document.querySelector('.add-cart.big-btn')?.click()" style="background:linear-gradient(135deg,var(--primary),var(--primary-dark)); color:#fff; border:none; border-radius:14px; padding:.8rem 1.35rem; font-weight:800; font-size:.92rem; cursor:pointer; white-space:nowrap; box-shadow:0 8px 20px rgba(14,165,233,.35)">🛒 أضف للسلة</button>
  </div>
  <% } %>

  <section class="st-reviews">
    <h2 class="st-rel-title">تقييمات الزبائن (<span id="reviewCount">0</span>)</h2>
    <div class="st-rating-summary">
      <div class="st-rating-avg" id="avgRating">0.0</div>
      <div class="st-rating-bars">
        <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.3rem">
          <span id="avgStars" style="font-size:1.1rem;color:#f59e0b"></span>
          <span class="muted" id="reviewCountText">(0 تقييم)</span>
        </div>
        <div class="st-rating-bar"><div class="st-rating-bar-fill" id="ratingBars" style="width:0%"></div></div>
      </div>
    </div>
    <div id="reviewsList" class="st-reviews-list"></div>
    <button id="showReviewBtn" class="st-btn" style="margin:1rem auto;display:block" onclick="document.getElementById('reviewForm').style.display='block';this.style.display='none'">✍️ أضف تقييمك</button>
    <form id="reviewForm" class="st-review-form" style="display:none">
      <h3>أضف تقييمك</h3>
      <input type="hidden" name="product_id" value="<%= product.id %>">
      <div class="stack">
        <label>اسمك *
          <input type="text" name="customer_name" required>
        </label>
        <label>رقم الهاتف (اختياري)
          <input type="text" name="customer_phone" dir="ltr" placeholder="07701234567">
        </label>
        <label>التقييم *
          <div class="star-rating" id="starRating">
            <% for(let i=1;i<=5;i++) { %><button type="button" class="star-btn" data-value="<%= i %>">☆</button><% } %>
          </div>
          <input type="hidden" name="rating" id="ratingInput" required>
        </label>
        <label>تعليقك (اختياري)
          <textarea name="comment" rows="3" placeholder="شارك تجربتك مع هذا المنتج..."></textarea>
        </label>
        <button type="submit" class="st-btn big-btn">إرسال التقييم</button>
      </div>
    </form>
    <p id="reviewSuccess" class="st-review-success" style="display:none">شكراً لتقييمك — سيظهر بعد المراجعة</p>
  </section>
</main>

<!-- Lightbox -->
<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()">
  <div class="lightbox-content" onclick="event.stopPropagation()">
    <button class="lightbox-close" onclick="closeLightbox()">✕</button>
    <button class="lightbox-prev" onclick="navLightbox(-1)">›</button>
    <button class="lightbox-next" onclick="navLightbox(1)">‹</button>
    <img id="lightboxImg" src="" alt="">
  </div>
</div>

<%- include('../partials/store-float') %>
<% if (store.template === 'market' || store.template === 'neo') { %>
  <%- include('../partials/market-footer') %>
<% } %>
<%- include('../partials/store-brand') %>
<%- include('../partials/cart-drawer') %>
<script>
  const images = <%- JSON.stringify(images.map(i => ({path: i.path, variant: i.variant || ''}))).replace(/</g,'\\u003c') %>;
  let currentImg = 0;
  // تبديل الصور حسب اللون المختار
  function applyVariantImages(){
    const selected = Array.from(document.querySelectorAll('.st-opt-sel')).map(s=>s.value.trim());
    const hasVariantImages = images.some(im=> im.variant && selected.includes(im.variant));
    let filtered = images;
    if(hasVariantImages){
      filtered = images.filter(im=> !im.variant || selected.includes(im.variant));
      if(filtered.length===0) filtered=images.filter(im=> selected.includes(im.variant));
    }
    if(!filtered.length) filtered=images;
    const thumbsBox=document.getElementById('stThumbs');
    if(thumbsBox){
      thumbsBox.querySelectorAll('img').forEach(el=>{
        const v=el.dataset.variant||'';
        const show = !v || selected.includes(v) || !hasVariantImages;
        el.style.display= show ? '' : 'none';
        if(!show) el.classList.remove('active');
      });
      const firstVisible=thumbsBox.querySelector('img:not([style*="display: none"])');
      if(firstVisible) switchImg(firstVisible, parseInt(firstVisible.dataset.idx));
    } else if(filtered[0]){
      document.getElementById('mainImg').src=filtered[0].path;
    }
  }
  document.querySelectorAll('.st-opt-sel').forEach(sel=> sel.addEventListener('change', applyVariantImages));

  function qtyValue() { const el = document.getElementById('qty'); return el ? parseInt(el.value) || 1 : 1; }
  function qty(d) {
    const el = document.getElementById('qty');
    let v = qtyValue() + d;
    if (v < 1) v = 1; if (v > 99) v = 99;
    el.value = v;
  }
  function collectOpts() {
    let txt = '';
    document.querySelectorAll('.st-opt-sel').forEach(sel => {
      txt += (txt ? ' — ' : '') + sel.dataset.opt + ': ' + sel.value;
    });
    const addons = [];
    document.querySelectorAll('.st-addon-cb').forEach(cb => {
      if (cb.checked) addons.push({ name: cb.dataset.name, price: Number(cb.dataset.price) || 0 });
    });
    return { txt, addons };
  }
  function productAddToCart(btn) {
    const q = qtyValue();
    const o = collectOpts();
    window.addToCart(btn, q, o.txt, o.addons);
  }

  // Gallery switch
  function switchImg(el, idx) {
    document.getElementById('mainImg').src = el.src;
    document.querySelectorAll('.st-thumbs img').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    currentImg = idx;
  }

  // Lightbox - يفتح الصور المرئية فقط حسب اللون
  function openLightbox(idx) {
    if (!images.length) return;
    currentImg = idx;
    document.getElementById('lightboxImg').src = images[currentImg].path || images[currentImg];
    document.getElementById('lightbox').classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('show');
    document.body.style.overflow = '';
  }
  function navLightbox(dir) {
    currentImg = (currentImg + dir + images.length) % images.length;
    document.getElementById('lightboxImg').src = images[currentImg].path || images[currentImg];
  }
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lightbox').classList.contains('show')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') navLightbox(-1);
    if (e.key === 'ArrowLeft') navLightbox(1);
  });

  // Reviews
  const productId = <%= product.id %>;
  const storeBase = '<%= store.base %>';
  const csrfToken = '<%= csrf %>';

  fetch(storeBase + '/product/' + productId + '/reviews')
    .then(r => r.json())
    .then(data => { if (data.ok) renderReviews(data); }).catch(() => {});

  function renderReviews(data) {
    document.getElementById('avgRating').textContent = data.avg || '0.0';
    document.getElementById('reviewCount').textContent = data.count;
    document.getElementById('reviewCountText').textContent = '(' + data.count + ' تقييم)';
    document.getElementById('ratingBars').style.width = (data.avg ? (data.avg / 5 * 100) : 0) + '%';
    const avg = parseFloat(data.avg) || 0;
    const full = Math.floor(avg);
    let s = '';
    for (let i = 1; i <= 5; i++) s += i <= full ? '★' : '☆';
    document.getElementById('avgStars').innerHTML = s;

    const list = document.getElementById('reviewsList');
    if (data.reviews && data.reviews.length) {
      list.innerHTML = data.reviews.map(r => `
        <div class="st-review-card">
          <div class="st-review-head">
            <strong>${escapeHtml(r.customer_name)}</strong>
            <span class="muted">${new Date(r.created_at).toLocaleDateString('ar-IQ')}</span>
          </div>
          <div class="st-review-stars">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div>
          <p>${escapeHtml(r.comment || '')}</p>
        </div>
      `).join('');
    } else {
      list.innerHTML = '<p class="muted" style="text-align:center;padding:2rem">لا توجد تقييمات بعد — كن أول من يقيم!</p>';
    }
  }

  function escapeHtml(text) { const d = document.createElement('div'); d.textContent = text; return d.innerHTML; }

  document.querySelectorAll('.star-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      const val = parseInt(this.dataset.value);
      document.getElementById('ratingInput').value = val;
      document.querySelectorAll('.star-btn').forEach((b, i) => {
        b.textContent = i < val ? '★' : '☆';
        b.classList.toggle('active', i < val);
      });
    });
  });

  // sticky ATC — يظهر عند تجاوز زر السلة الرئيسي (فوق الطي)
  (function(){ const bar=document.getElementById('stickyATC'); const btn=document.querySelector('.add-cart.big-btn'); if(!bar||!btn) return; const io=new IntersectionObserver(ents=>{ const v=ents[0]; const show=!v.isIntersecting && window.scrollY>320; bar.style.display='flex'; requestAnimationFrame(()=> bar.style.transform= show ? 'translateY(0)' : 'translateY(100%)'); }, {threshold:0}); io.observe(btn); })();

  document.getElementById('reviewForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    if (!data.rating) return alert('الرجاء اختيار التقييم');
    fetch(storeBase + '/reviews?_csrf=' + encodeURIComponent(csrfToken), {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(r => r.json())
    .then(res => {
      if (res.ok) {
        this.style.display = 'none';
        document.getElementById('reviewSuccess').style.display = 'block';
        setTimeout(() => location.reload(), 2000);
      } else { alert(res.message || 'حدث خطأ'); }
    }).catch(() => alert('حدث خطأ في الإرسال'));
  });
</script>
<style>
/* صندوق الشراء الجديد — هوية دكان (أحمر دومي/ذهبي) */
.dkp-name{font-size:1.35rem; font-weight:900; color:#1c1917; line-height:1.5}
.dkp-price{display:flex; align-items:center; gap:.6rem; margin:.5rem 0; flex-wrap:wrap}
.dkp-price b{font-size:1.5rem; font-weight:900; color:#7f1d1d}
.dkp-price b small{font-size:.8rem}
.dkp-price del{color:#a8a29e; font-size:.9rem}
.dkp-save{background:linear-gradient(135deg,#7f1d1d,#dc2626); color:#fff; font-size:.72rem; font-weight:800; border-radius:99px; padding:.2rem .7rem}
.dkp-soldout{background:#fef2f2; border:1.5px solid #fecaca; color:#b91c1c; font-weight:800; padding:.65rem 1.1rem; border-radius:12px; text-align:center; margin:.5rem 0; font-size:.88rem}
.dkp-low{background:#fffbeb; border:1.5px solid #fcd34d; color:#92400e; font-weight:800; padding:.65rem 1.1rem; border-radius:12px; text-align:center; margin:.5rem 0; font-size:.88rem; animation:dkpPulse 1.6s infinite}
@keyframes dkpPulse{0%,100%{box-shadow:0 0 0 0 rgba(217,119,6,.3)} 50%{box-shadow:0 0 0 6px rgba(217,119,6,0)}}
.dkp-qty{display:flex; align-items:center; gap:.55rem; margin:.8rem 0; background:#faf9f8; border:1.5px solid #ece9e6; padding:.45rem .7rem; border-radius:14px; width:fit-content}
.dkp-qty button{width:36px; height:36px; border-radius:10px; border:1.5px solid #e7e5e4; background:#fff; font-size:1.25rem; font-weight:900; cursor:pointer; color:#7f1d1d; line-height:1}
.dkp-qty button:active{transform:scale(.92)}
.dkp-qty input{width:46px; text-align:center; font-weight:900; font-size:1rem; border:none; background:transparent; font-family:inherit}
.dkp-qty span{font-size:.78rem; color:#78716c; font-weight:700}
.dkp-atc{width:100%; padding:1rem !important; font-size:1.05rem !important; border-radius:14px !important; background:linear-gradient(135deg,#7f1d1d,#b45309 55%,#d97706) !important; box-shadow:0 10px 26px rgba(127,29,29,.4) !important; font-weight:900}
.dkp-atc:hover{transform:translateY(-2px); box-shadow:0 14px 32px rgba(127,29,29,.5) !important}
.dkp-wa{width:100%; margin-top:.6rem; display:flex; justify-content:center}
.dkp-trust{display:flex; gap:.5rem; margin-top:.8rem; flex-wrap:wrap; justify-content:center}
.dkp-trust span{font-size:.74rem; font-weight:700; padding:.32rem .7rem; border-radius:99px; background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d}
.dkp-stock{font-size:.82rem; color:#15803d; font-weight:700; margin-top:.5rem}
/* Product page styles */
.st-badge-soldout{background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b;font-weight:800;padding:.65rem 1.2rem;border-radius:var(--radius);text-align:center;margin:.5rem 0;font-size:.9rem}
.st-badge-lowstock{background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e;font-weight:700;padding:.65rem 1.2rem;border-radius:var(--radius);text-align:center;margin:.5rem 0;font-size:.9rem}
.st-opt{display:flex;flex-direction:column;gap:.3rem;margin:.7rem 0;font-size:.87rem;font-weight:700;color:var(--ink)}
.st-opt-sel,.st-addon{font-family:inherit}
.st-opt-sel{padding:.6rem .9rem;border-radius:12px;border:1.5px solid var(--line);background:#fff;color:var(--ink);transition:var(--transition)}
.st-opt-sel:focus{outline:2px solid var(--primary);border-color:transparent}
.st-addons{display:flex;flex-wrap:wrap;gap:.5rem;margin:.7rem 0}
.st-addon{display:flex;align-items:center;gap:.45rem;font-size:.85rem;background:var(--soft);padding:.5rem .9rem;border-radius:99px;cursor:pointer;color:var(--ink);transition:var(--transition);border:1.5px solid transparent}
.st-addon:hover{border-color:var(--primary);background:rgba(14,165,233,.05)}
.st-addon input{accent-color:var(--primary);width:16px;height:16px}
.st-stock{font-size:.82rem;color:var(--success);font-weight:700;margin-top:.5rem;display:flex;align-items:center;gap:.3rem}
.st-stock::before{content:'✅'}
.wa-order{background:linear-gradient(135deg,#25d366,#128c7e)!important;margin-top:.5rem}
.wa-order:hover{filter:brightness(1.08);box-shadow:0 8px 24px rgba(37,211,102,.35)!important}

/* Reviews */
.st-reviews{margin-top:2.5rem}
.st-reviews-list{display:flex;flex-direction:column;gap:.8rem;margin:1rem 0}
.st-review-card{border:1.5px solid var(--line);border-radius:var(--radius-lg);padding:1.2rem;background:linear-gradient(135deg,#fff,#fafbfc);transition:var(--transition)}
.st-review-card:hover{box-shadow:var(--shadow);border-color:transparent}
.st-review-head{display:flex;justify-content:space-between;margin-bottom:.4rem}
.st-review-head strong{font-size:.95rem;color:var(--ink)}
.st-review-stars{color:#f59e0b;font-size:1.1rem;margin-bottom:.4rem;letter-spacing:2px}
.st-review-card p{color:var(--muted);line-height:1.7;font-size:.9rem}
.st-review-form{margin-top:1.5rem;background:#fff;border:1.5px solid var(--line);border-radius:var(--radius-xl);padding:1.8rem;box-shadow:var(--shadow)}
.st-review-form h3{font-size:1.1rem;font-weight:800;margin-bottom:1rem;color:var(--ink)}
.star-rating{display:flex;gap:.3rem;margin-top:.3rem}
.star-btn{background:none;border:none;font-size:1.8rem;cursor:pointer;color:var(--line);transition:all .2s;padding:0;line-height:1}
.star-btn:hover,.star-btn.active{color:#f59e0b;transform:scale(1.15)}
.st-review-success{text-align:center;color:var(--success);font-weight:700;padding:2rem;font-size:1rem}

/* Lightbox */
.lightbox-overlay{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:1000;display:none;align-items:center;justify-content:center;backdrop-filter:blur(8px)}
.lightbox-overlay.show{display:flex;animation:fadeIn .2s}
.lightbox-content{position:relative;max-width:90vw;max-height:90vh}
.lightbox-content img{max-width:90vw;max-height:85vh;object-fit:contain;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.lightbox-close{position:absolute;top:-40px;left:0;background:none;border:none;color:#fff;font-size:1.5rem;cursor:pointer;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:background .2s}
.lightbox-close:hover{background:rgba(255,255,255,.2)}
.lightbox-prev,.lightbox-next{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.15);border:none;color:#fff;font-size:2rem;cursor:pointer;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .2s;backdrop-filter:blur(4px)}
.lightbox-prev{right:-60px}
.lightbox-next{left:-60px}
.lightbox-prev:hover,.lightbox-next:hover{background:rgba(255,255,255,.3);transform:translateY(-50%) scale(1.1)}
@media(max-width:800px){
  .lightbox-prev{right:10px}
  .lightbox-next{left:10px}
}
</style>
</body>
</html>